{
  "capabilities": [
    "completions",
    "prompts",
    "resources",
    "tools"
  ],
  "prompts": [
    {
      "arguments": [
        {
          "name": "text",
          "required": true
        },
        {
          "name": "style"
        }
      ],
      "description": "Create a concise summary request.",
      "name": "summarize",
      "title": "Summarize text"
    }
  ],
  "protocol_version": "2026-07-28",
  "resource_templates": [
    {
      "description": "Demo records are restricted by the verified OAuth subject.",
      "mimeType": "application/json",
      "name": "customer_record",
      "title": "Customer record",
      "uriTemplate": "customer://records/{recordId}"
    }
  ],
  "resources": [
    {
      "description": "A public example resource.",
      "mimeType": "text/plain",
      "name": "welcome",
      "title": "Welcome",
      "uri": "greeting://welcome"
    }
  ],
  "tools": [
    {
      "annotations": {
