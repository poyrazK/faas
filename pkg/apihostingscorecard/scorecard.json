{
  "version": 1,
  "gates": [
    {
      "id": "api-contract-preview",
      "name": "Declared contract and effective policy preview",
      "category": "security",
      "description": "A deployment can compare declared routes with observed routes and matching edge policy without mutating production.",
      "capabilities": ["custom-domains", "openapi-contract-preview", "streaming-and-grpc"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [
        {"kind": "test", "locator": "pkg/gateway/allowlist_test.go::TestOnDemandAllowlist_CustomDomainTakesPrecedence"},
        {"kind": "test", "locator": "pkg/openapidiff/preview_test.go::TestBuildRoutePolicyPreview"},
        {"kind": "test", "locator": "cmd/apid/handler_app_openapi_test.go::TestGetAppOpenAPIPolicyPreview_ReadOnly"},
        {"kind": "test", "locator": "pkg/gateway/forwardproxy_test.go::TestRawStreamReverseProxy_RemoteWakeNode"}
      ]
    },
    {
      "id": "companion-runtime",
      "name": "Application companion readiness",
      "category": "reliability",
      "description": "A bounded companion boots with the application, remains isolated by its own resource controls, and preserves the shared instance lifecycle contract.",
      "capabilities": ["companions"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [{"kind": "test", "locator": "pkg/fcvm/sidecar_metal_test.go::TestMetalTwoSidecarsColdBoot"}]
    },
    {
      "id": "container-compatibility",
      "name": "Normal OCI container compatibility",
      "category": "compatibility",
      "description": "A stateless Linux/amd64 OCI image can preserve its process contract and use the full-rootfs path when it is not built from a Gregale base.",
      "capabilities": ["container-deployments"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [
        {"kind": "test", "locator": "pkg/oci/container_contract_test.go::TestContainerDeploymentContract"},
        {"kind": "test", "locator": "pkg/apihostingcontract/catalog_test.go::TestContainerRuntimeContract"},
        {"kind": "test", "locator": "cmd/e2e/direct_oci_fullrootfs_metal_test.go::TestDirectOCIFullRootfsMetal"},
        {"kind": "test", "locator": "cmd/e2e/direct_oci_autoscale_metal_test.go::TestDirectOCIAutoscaleScaleToZeroMetal"},
        {"kind": "test", "locator": "cmd/e2e/direct_oci_port_metal_test.go::TestDirectOCIPort3000Metal"}
      ]
    },
    {
      "id": "declarative-cache-readiness",
      "name": "Declarative response-cache readiness",
      "category": "reliability",
      "description": "A route-level response cache serves an eligible stale response while a single background refresh restores freshness, with an operator recovery path for purge and distributed-cache failures.",
      "capabilities": ["declarative-response-caching"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [
        {"kind": "test", "locator": "pkg/gateway/handler_apply_edge_rule_cache_test.go::TestApplyEdgeRuleCache_StaleWhileRevalidate"},
        {"kind": "runbook", "locator": "docs/runbooks/FaasResponseCache.md"}
      ]
    },
    {
      "id": "delayed-execution-reliability",
      "name": "Delayed execution reliability",
      "category": "reliability",
      "description": "A delayed invocation is durably scheduled for a bounded future time, reaches the app through the normal gateway bridge, and can be cancelled before dispatch without reaching the workload.",
      "capabilities": ["delayed-execution"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [
        {"kind": "test", "locator": "cmd/apid/handlers_delayed_task_product_test.go::TestDelayedTaskScheduleAcceptsRelativeDelay"},
        {"kind": "test", "locator": "cmd/e2e/normal_path_e2e_test.go::TestE2E_NormalPath_CancelledDelayedTaskNeverReachesBridge"},
        {"kind": "test", "locator": "cmd/e2e/normal_path_e2e_test.go::TestE2E_NormalPath_DelayedTaskWaitsThenUsesRealGatewayBridge"}
      ]
    },
    {
      "id": "disposable-runs",
      "name": "Disposable isolated execution",
      "category": "security",
      "description": "Untrusted source is admitted only through authenticated, bounded, networkless disposable execution and its payload is not returned in customer reads.",
      "capabilities": ["disposable-runs"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [{"kind": "test", "locator": "cmd/apid/handlers_executions_test.go::TestCreateExecutionSealsPayloadAndReturnsQueuedProjection"}]
    },
    {
      "id": "durable-inbound-webhook-reliability",
      "name": "Durable inbound webhook reliability",
      "category": "reliability",
      "description": "A provider-signed webhook is durably accepted before acknowledgement, deduplicated across provider retries, and queued for the normal wake and delivery lifecycle.",
      "capabilities": ["durable-inbound-webhooks"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [{"kind": "test", "locator": "cmd/apid/handlers_inbound_webhooks_test.go::TestInboundWebhookAcceptsDurablyAndDeduplicatesProviderRetries"}]
    },
    {
      "id": "first-healthy-api",
      "name": "Time to first healthy API",
      "category": "activation",
      "description": "A clean-account deployment reaches a verified public response within the onboarding budget.",
      "capabilities": ["framework-profiles", "source-deploy"],
      "targets": [
        {"metric": "p50", "operator": "lte", "value": 120, "unit": "seconds"},
        {"metric": "p95", "operator": "lte", "value": 300, "unit": "seconds"}
      ],
      "evidence": [
        {"kind": "test", "locator": "pkg/apihostingcontract/catalog_test.go::TestCatalogProfiles"},
        {"kind": "test", "locator": "cmd/e2e/apply_project_e2e_test.go::TestApplyProject_DeploymentKindTarball"},
        {"kind": "test", "locator": "cmd/e2e/deploy_healthcheck_metal_test.go::TestDeployHealthcheckMetal"}
      ]
    },
    {
      "id": "framework-compatibility",
      "name": "Zero-config framework compatibility",
      "category": "compatibility",
      "description": "The maintained API fixture catalog continues to infer a runnable profile for supported frameworks and source shapes.",
      "capabilities": ["framework-profiles", "source-deploy"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 95, "unit": "percent"}],
      "evidence": [
        {"kind": "test", "locator": "pkg/apihostingcontract/catalog_test.go::TestCatalogProfiles"},
        {"kind": "make", "locator": "api-hosting-contract-check"}
      ]
    },
    {
      "id": "preview-readiness",
      "name": "Pull-request preview readiness",
      "category": "delivery",
      "description": "A preview deployment gets an isolated, reviewable URL inside the GitHub event budget.",
      "capabilities": ["github-deploys", "pr-previews"],
      "targets": [{"metric": "p95", "operator": "lte", "value": 180, "unit": "seconds"}],
      "evidence": [
        {"kind": "test", "locator": "pkg/githubdgrpc/handlers_round_trip_test.go::TestCreateDeploymentFromPush_HappyPath"},
        {"kind": "test", "locator": "pkg/dashboard/preview_panel_test.go::TestRender_AppDetail_PreviewPanel_Shape"},
        {"kind": "test", "locator": "cmd/e2e/preview_e2e_test.go::TestPreview_E2E_HappyPath_PreviewAppsByParent"}
      ]
    },
    {
      "id": "request-diagnosis",
      "name": "Request diagnosis",
      "category": "observability",
      "description": "A request timeline preserves route, latency, wake, and error evidence without requiring payload capture.",
      "capabilities": ["scale-to-zero", "streaming-and-grpc"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [
        {"kind": "test", "locator": "cmd/apid/handlers_debug_evidence_test.go::TestBuildDebugRequestTimelineJoinsWakeAndMarksError"},
        {"kind": "test", "locator": "pkg/gateway/request_telemetry_publisher_test.go::TestCollapseRequestTelemetry_PreservesLatencyDistribution"},
        {"kind": "test", "locator": "pkg/gateway/forwardproxy_test.go::TestRawStreamReverseProxy_RemoteWakeNode"}
      ]
    },
    {
      "id": "resource-readiness",
      "name": "Bound resource readiness",
      "category": "resources",
      "description": "A customer-facing resource binding has qualification evidence before it is promoted beyond internal use.",
      "capabilities": ["object-storage"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [{"kind": "test", "locator": "pkg/objectstorage/provider_live_test.go::TestLiveProviderQualification"}]
    },
    {
      "id": "rollback-recovery",
      "name": "Rollback recovery",
      "category": "reliability",
      "description": "A bad deployment can be rolled back without rebuilding and traffic returns healthy inside the recovery budget. Recovery includes shifting traffic between revisions and holding a canary ladder when health signals degrade, so a bad release can be contained before it reaches every request.",
      "capabilities": ["github-deploys", "pr-previews", "progressive-rollouts", "source-deploy"],
      "targets": [{"metric": "p95", "operator": "lte", "value": 60, "unit": "seconds"}],
      "evidence": [
        {"kind": "test", "locator": "cmd/e2e/rollback_specific_test.go::TestRollbackSpecific_E2E"},
        {"kind": "test", "locator": "pkg/sched/invariants_property_test.go::TestProperty_RolloutGrant_AllowsExactlyOneOverlap"}
      ]
    },
    {
      "id": "service-mesh-readiness",
      "name": "Internal service reachability and isolation",
      "category": "reliability",
      "description": "A same-account service is reachable by name, a parked one is woken by the call rather than refused, its configured wire protocol survives to the guest, and a private app stays off the public edge while cross-account callers are denied.",
      "capabilities": ["internal-services", "private-apps"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [
        {"kind": "test", "locator": "cmd/e2e/service_mesh_e2e_test.go::TestE2E_ServiceMesh_WakesParkedTarget"},
        {"kind": "test", "locator": "cmd/e2e/service_mesh_e2e_test.go::TestE2E_ServiceMesh_StampsTargetProtocol"},
        {"kind": "test", "locator": "cmd/e2e/service_mesh_e2e_test.go::TestE2E_ServiceMesh_AccessBoundaries"},
        {"kind": "test", "locator": "cmd/gatewayd-internal/backend_test.go::TestPgRouter_InternalAppIsNotPubliclyRouted"}
      ]
    },
    {
      "id": "snapshot-wake",
      "name": "Snapshot wake recovery",
      "category": "reliability",
      "description": "A parked API wakes through the snapshot path and serves a public request within the platform restore budget.",
      "capabilities": ["firecracker-isolation", "scale-to-zero"],
      "targets": [{"metric": "p95", "operator": "lte", "value": 350, "unit": "milliseconds"}],
      "evidence": [
        {"kind": "test", "locator": "pkg/gateway/handler_test.go::TestColdWakeReturns200AndHeader"},
        {"kind": "test", "locator": "cmd/e2e/source_deploy_wake_metal_test.go::TestSourceDeployWakeMetal"},
        {"kind": "test", "locator": "cmd/e2e/catalog_runtime_metal_test.go::TestCatalogRuntimeParityMetal"},
        {"kind": "test", "locator": "cmd/e2e/direct_oci_autoscale_metal_test.go::TestDirectOCIAutoscaleScaleToZeroMetal"}
      ]
    },
    {
      "id": "worker-pool-readiness",
      "name": "Worker pool readiness",
      "category": "reliability",
      "description": "A worker deployment validates its long-lived execution mode and restart defaults before it is admitted.",
      "capabilities": ["worker-pools"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [{"kind": "test", "locator": "pkg/api/appmanifest_test.go::TestAppManifestWorkerMode"}]
    },
    {
      "id": "workflow-reliability",
      "name": "Asynchronous work reliability",
      "category": "reliability",
      "description": "Background workflows preserve plan policy and complete their lifecycle without leaking platform state.",
      "capabilities": ["workflows-and-jobs"],
      "targets": [{"metric": "ratio", "operator": "gte", "value": 100, "unit": "percent"}],
      "evidence": [{"kind": "test", "locator": "cmd/e2e/workflows_e2e_test.go::TestE2E_Workflows_Lifecycle"}]
    }
  ]
}
