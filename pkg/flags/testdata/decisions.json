{
  "bundle": {
    "environment_id": "00000000-0000-4000-8000-0000000000e1",
    "version": 7,
    "groups": {},
    "flags": [
      {
        "key": "eu-checkout",
        "enabled": true,
        "default": false,
        "seed": "seed-eu",
        "rules": [
          {"id": "eu", "attributes": [{"attribute": "gregale.country", "op": "in", "values": ["DE", "FR"]}], "value": true}
        ]
      },
      {
        "key": "pro-only",
        "enabled": true,
        "default": false,
        "seed": "seed-pro",
