{
  "version": 1,
  "name": "csv-batch-pipeline",
  "input": {
    "type": "object",
    "properties": {
      "imports": {
        "type": "array",
        "minItems": 1,
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "value": {
              "type": "object",
              "properties": {
                "import_id": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36
                },
                "source": {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "integer",
                      "enum": [
                        1
                      ]
                    },
                    "scope": {
                      "type": "object",
                      "properties": {
                        "base_url": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1024
                        },
                        "app_slug": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 63
                        },
                        "bucket": {
                          "type": "string",
                          "minLength": 36,
                          "maxLength": 36
                        }
                      },
                      "required": [
                        "base_url",
                        "app_slug",
                        "bucket"
                      ],
                      "additionalProperties": false
                    },
                    "owner_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "version_id": {
                      "type": "string",
                      "minLength": 36,
                      "maxLength": 36
                    },
                    "size_bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "minLength": 64,
                      "maxLength": 64
                    }
                  },
                  "required": [
                    "version",
                    "scope",
                    "owner_id",
                    "key",
                    "size_bytes",
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "import_id",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "value"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "imports"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "saved": {
        "type": "integer",
        "minimum": 0
      },
      "rejected": {
        "type": "integer",
        "minimum": 0
      },
      "children": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "phase": {
              "type": "string",
              "enum": [
                "unstarted",
                "submission_unresolved",
                "running",
                "succeeded",
                "failed",
                "cancelled",
                "skipped"
              ]
            },
            "run_id": {
              "type": "string",
              "minLength": 36,
              "maxLength": 36
            },
            "status": {
              "type": "string",
              "enum": [
                "completed",
                "rejected",
                "expired",
                "cancelled"
              ]
            },
            "report": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "integer",
                  "enum": [
                    1
                  ]
                },
                "scope": {
                  "type": "object",
                  "properties": {
                    "base_url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "app_slug": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "bucket": {
                      "type": "string",
                      "minLength": 36,
                      "maxLength": 36
                    }
                  },
                  "required": [
                    "base_url",
                    "app_slug",
                    "bucket"
                  ],
                  "additionalProperties": false
                },
                "owner_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "version_id": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "sha256": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 64
                }
              },
              "required": [
                "version",
                "scope",
                "owner_id",
                "key",
                "size_bytes",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "phase"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "saved",
      "rejected",
      "children"
    ],
    "additionalProperties": false
  }
}
