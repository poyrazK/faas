{
  "version": 1,
  "name": "csv-report",
  "input": {
    "type": "object",
    "properties": {
      "import_id": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36
      },
      "owner_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "rejections": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "required": [
      "import_id",
      "owner_id",
      "rejections"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "version": {
        "type": "integer",
        "enum": [
          1
        ]
      },
      "scope": {
        "type": "object",
        "properties": {
          "base_url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "app_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "bucket": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36
          }
        },
        "required": [
          "base_url",
          "app_slug",
          "bucket"
        ],
        "additionalProperties": false
      },
      "owner_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "version_id": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36
      },
      "size_bytes": {
        "type": "integer",
        "minimum": 0
      },
      "sha256": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      }
    },
    "required": [
      "version",
      "scope",
      "owner_id",
      "key",
      "size_bytes",
      "sha256"
    ],
    "additionalProperties": false
  }
}
