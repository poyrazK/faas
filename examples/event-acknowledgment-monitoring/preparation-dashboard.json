{
  "annotations": {
    "list": []
  },
  "description": "Opt-in monitoring for application-owned prepared Node or Python event workers. Uses the default SDK formatter prefix and companion recording rules; observations do not prove callback success or recovery.",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "Recovery runbook",
      "url": "https://github.com/poyrazK/faas/blob/main/docs/runbooks/GregaleEventPreparation.md",
      "type": "link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Prepared workers: observation limits",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Load `preparation.rules.yml` before using the derived panels. Select the Prometheus datasource, job and instance. Ten-minute increases are extrapolated observations; they can be fractional. Failure ratios and p95 panels require at least 20 estimated observations. Derived panels disappear while a target is down, its collector is missing, or clipping was observed in the window. An idle worker can have zero increases and unavailable p95 values. Missing data is not zero or proof of recovery. Local receipt commits do not confirm platform callbacks. These metrics contain no job identity; inspect protected jobs and receipts before recovery. [Recovery runbook](https://github.com/poyrazK/faas/blob/main/docs/runbooks/GregaleEventPreparation.md) · [Setup and tuning](https://github.com/poyrazK/faas/blob/main/examples/event-acknowledgment-monitoring/README.md)"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape reachability",
      "description": "Current scrape reachability per discovered target. Reachability does not establish worker processing health. Removed targets require discovery/inventory checks.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{gregale_event_preparation=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "instant": true,
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Reachable",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Collector clipping",
      "description": "Sticky collector clipping flag. A missing series is unavailable, not unclipped. Histogram flags are available in the raw exporter.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_acknowledgment_preparation_saturated{gregale_event_preparation=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\",scope=\"collector\"}",
          "instant": true,
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unclipped",
                  "color": "green"
                },
                "1": {
                  "text": "Clipped",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Usable observation window",
      "description": "Requires up=1, a present unclipped collector and no observed clipping in ten minutes. This does not guarantee continuous scrape/event coverage. Missing recording rules also yield no data.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_preparation:window_healthy{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "instant": true,
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Usable observations",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Shutdown outcomes / 10m (estimated)",
      "description": "Shutdown observations by outcome, not unique deliveries. Cancellation, failed, unknown and committed outcomes are separate. Completed-receipt replay counts again.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_preparation:operations:increase10m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}} / {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Failed shutdown ratio / 10m",
      "description": "Failed outcomes divided by all observed shutdowns. Requires at least 20 estimated shutdowns. Unknown commits and cancellations are not failed outcomes. Example alert: >10% for 5m.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_preparation:failure_ratio10m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Renewal failures / 10m (estimated)",
      "description": "Failure observations split by local/platform lease and fixed reason. Alert sums reasons per lease and requires >=3 estimated failures in 10m for 5m.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_preparation:renewal_failures:increase10m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}} / {{lease}} / {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Unknown commit observations / 10m (estimated)",
      "description": "Any observed increase triggers the warning. The counter does not track whether a transaction remains unresolved or which protected job needs inspection.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_preparation:unknown_commits:increase10m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}} / {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Preparation callback p95 / 10m",
      "description": "Histogram estimate over settled preparation callbacks, with at least 20 estimated settlements. Includes returned and thrown callbacks. Example threshold 30s for 10m. Largest finite bucket is 300s.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_preparation:callback_duration:p95_10m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Whole operation p95 / 10m",
      "description": "Histogram estimate through shutdown cleanup, with at least 20 estimated shutdowns. Not an active job budget or an acknowledgment-delivery duration. Example threshold 60s for 10m; largest finite bucket 300s.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_preparation:operation_duration:p95_10m{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Local receipt commits / 10m (estimated)",
      "description": "New and replayed receipt/intent commits. Does not confirm platform callback delivery or unique business effects. Do not add these counts to shutdown outcomes.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, instance, receipt) (increase(gregale_event_acknowledgment_preparation_local_commits_total{gregale_event_preparation=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[10m])) and on (job, instance) gregale_event_preparation:window_healthy{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}} / {{receipt}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Callback settlements / 10m (estimated)",
      "description": "Estimated callback settlement volume behind the callback p95 guard. Existing receipt fast paths can commit without invoking preparation. No in-flight work is inferred.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, instance) (increase(gregale_event_acknowledgment_preparation_callback_duration_seconds_count{gregale_event_preparation=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"}[10m])) and on (job, instance) gregale_event_preparation:window_healthy{job=~\"${job:regex}\",instance=~\"${instance:regex}\"}",
          "legendFormat": "{{job}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "gregale",
    "events",
    "application-workers"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "prometheus",
          "value": "prometheus"
        },
        "options": []
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(up{gregale_event_preparation=\"true\"}, job)",
        "query": {
          "query": "label_values(up{gregale_event_preparation=\"true\"}, job)",
          "refId": "job-query"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(up{gregale_event_preparation=\"true\",job=~\"${job:regex}\"}, instance)",
        "query": {
          "query": "label_values(up{gregale_event_preparation=\"true\",job=~\"${job:regex}\"}, instance)",
          "refId": "instance-query"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Gregale event preparation workers",
  "uid": "gregale-event-preparation",
  "version": 2
}
