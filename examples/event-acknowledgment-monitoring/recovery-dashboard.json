    {
      "id": 7,
      "title": "Observation age and freshness bound",
      "type": "timeseries",
      "description": "Age uses conservative wall and local monotonic time. Future/non-advancing samples remain ineligible even if displayed age is low. Absent sample age remains missing.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gregale_event_acknowledgment_recovery_observation_age_seconds{gregale_event_recovery=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"} and on (job, instance) (up{gregale_event_recovery=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "Age / {{job}} / {{instance}}",
          "instant": false
        },
        {
          "refId": "B",
          "expr": "gregale_event_acknowledgment_recovery_max_observation_age_seconds{gregale_event_recovery=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"} and on (job, instance) (up{gregale_event_recovery=\"true\",job=~\"${job:regex}\",instance=~\"${instance:regex}\"} == 1)",
          "legendFormat": "Age bound / {{job}} / {{instance}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown",
          "min": 0,
          "mappings": [],
          "thresholds": {
