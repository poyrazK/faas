{
  "version": 2,
  "scenarios": [
    {
      "name": "idempotent-orders",
      "requests": [
        {
          "name": "Create once",
          "identity": "alice",
          "method": "POST",
          "path": "/rest/v1/rpc/create_order_once",
          "body": {
            "request_key": "e302015b-f904-4385-97f7-a1cd6edb657a",
            "order_total": 42
          },
          "expect": {
            "status": 200
          },
          "capture": {
            "id": "/0/id"
          }
        },
        {
          "name": "Retry identical payload",
          "identity": "alice",
          "method": "POST",
          "path": "/rest/v1/rpc/create_order_once",
          "body": {
            "request_key": "e302015b-f904-4385-97f7-a1cd6edb657a",
            "order_total": 42
          },
          "expect": {
            "status": 200,
            "json": [
              {
                "id": "{{id}}",
                "owner": "alice",
                "tenant": "team-a",
                "request_key": "e302015b-f904-4385-97f7-a1cd6edb657a",
                "total": 42
              }
            ]
          }
        },
        {
          "name": "Changed payload conflicts",
          "identity": "alice",
          "method": "POST",
          "path": "/rest/v1/rpc/create_order_once",
          "body": {
            "request_key": "e302015b-f904-4385-97f7-a1cd6edb657a",
            "order_total": 43
          },
          "expect": {
            "status": 409
          }
        },
        {
          "name": "Other subject sees no receipt",
          "identity": "bob",
          "method": "GET",
          "path": "/rest/v1/orders?id=eq.{{id}}",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "Other tenant sees no receipt",
          "identity": "otherTenant",
          "method": "GET",
          "path": "/rest/v1/orders?id=eq.{{id}}",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "Same key in other tenant is independent",
          "identity": "otherTenant",
          "method": "POST",
          "path": "/rest/v1/rpc/create_order_once",
          "body": {
            "request_key": "e302015b-f904-4385-97f7-a1cd6edb657a",
            "order_total": 7
          },
          "expect": {
            "status": 200
          }
        },
        {
          "name": "Original result unchanged",
          "identity": "alice",
          "method": "GET",
          "path": "/rest/v1/orders?select=total",
          "expect": {
            "status": 200,
            "json": [
              {
                "total": 42
              }
            ]
          }
        }
      ]
    }
  ]
}
