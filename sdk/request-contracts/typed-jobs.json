          "type": "integer",
          "minimum": 0
        },
        "saved": {
          "type": "boolean"
        },
        "rejection": {
          "type": "string",
          "enum": [
            "invalid_email",
            "none"
          ]
        }
      },
      "required": [
        "row",
        "saved",
        "rejection"
      ],
      "additionalProperties": false
    }
  },
  "inputs": [
