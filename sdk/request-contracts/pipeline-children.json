  "queries": [
    "INSERT INTO public.gregale_pipeline_children(identity,intent,state,expires_at) VALUES ($1,$2::jsonb,$3::jsonb,clock_timestamp()+($4::bigint*interval '1 millisecond')) ON CONFLICT (identity) DO NOTHING RETURNING jsonb_build_object('intent',intent,'state',state,'revision',revision,'expires_at',to_char(expires_at AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"'),'expired',expires_at<=clock_timestamp()) AS receipt",
    "SELECT jsonb_build_object('intent',intent,'state',state,'revision',revision,'expires_at',to_char(expires_at AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"'),'expired',expires_at<=clock_timestamp()) AS receipt FROM public.gregale_pipeline_children WHERE identity=$1",
    "UPDATE public.gregale_pipeline_children SET state=$4::jsonb,revision=revision+1 WHERE identity=$1 AND revision=$2 AND intent=$3::jsonb AND (NOT $5::boolean OR expires_at>clock_timestamp()) RETURNING jsonb_build_object('intent',intent,'state',state,'revision',revision,'expires_at',to_char(expires_at AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"'),'expired',expires_at<=clock_timestamp()) AS receipt",
    "UPDATE public.gregale_pipeline_children SET checked_at=clock_timestamp() WHERE identity IN (SELECT identity FROM public.gregale_pipeline_children WHERE intent->'scope'=$1::jsonb AND intent->>'parent_sha256'=$2 AND EXISTS (SELECT 1 FROM jsonb_array_elements(state->'children') c WHERE c->>'phase' IN ('submission_unresolved','running') OR c->>'phase'='unstarted' AND state->>'stop_reason' IS NULL) ORDER BY checked_at,identity LIMIT $3 FOR UPDATE SKIP LOCKED) RETURNING jsonb_build_object('intent',intent,'state',state,'revision',revision,'expires_at',to_char(expires_at AT TIME ZONE 'UTC','YYYY-MM-DD\"T\"HH24:MI:SS.MS\"Z\"'),'expired',expires_at<=clock_timestamp()) AS receipt"
  ]
