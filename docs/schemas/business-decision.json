{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "decision"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "gregale.business-decision.v1"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "instance_id",
        "code",
        "description",
        "rule_id",
        "rule_version"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "UTF-8 byte limit; nonempty text without control characters."
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "UTF-8 byte limit; nonempty text without control characters."
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "rule_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "UTF-8 byte limit; nonempty text without control characters."
        }
      }
    }
  }
}
