{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "invariant"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "const": "gregale.business-invariant.v1"
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow",
        "instance_id",
        "state",
        "code",
        "version",
        "status",
        "description",
        "operations"
      ],
      "properties": {
        "workflow": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 54,
          "pattern": "^[a-z][a-z0-9-]{0,53}$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      },
      "description": "Application-evaluated business condition. String limits are UTF-8 bytes; instance, version, and description must be nonempty without control characters."
    }
  }
}
