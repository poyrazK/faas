{
  "default_region": "us-east-1",
  "public_endpoint": "https://s3.gregale.dev",
  "public_region": "us-east-1",
  "defaults": { "us-east-1": "managed-virginia-v1" },
  "max_buckets_per_app": 10,
  "max_upload_bytes": 104857600,
  "accounting": null,
  "backends": [
    {
      "id": "managed-virginia-v1",
      "driver": "s3",
      "region": "us-east-1",
      "namespace": "replace-with-your-dedicated-provider-project-id",
      "endpoint": "https://s3.us-east-va.io.cloud.ovh.us",
      "s3_region": "us-east-va",
      "path_style": true,
      "access_key_env": "GREGALE_OBJECT_STORAGE_ACCESS_KEY",
      "secret_key_env": "GREGALE_OBJECT_STORAGE_SECRET_KEY",
      "usage_reports_path": "/var/spool/faas/s3-gatewayd/managed-virginia-v1-usage.json",
      "usage": {
        "driver": "ovh",
        "application_key_env": "GREGALE_OVH_APPLICATION_KEY",
        "application_secret_env": "GREGALE_OVH_APPLICATION_SECRET",
        "consumer_key_env": "GREGALE_OVH_CONSUMER_KEY",
        "request_log_bucket": "replace-with-dedicated-ovh-access-log-bucket",
        "request_log_prefix": "gregale/"
      },
      "allowed_origins": ["https://gregale.dev"]
    }
  ]
}
