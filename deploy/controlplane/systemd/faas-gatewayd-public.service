[Unit]
Description=onebox-faas gatewayd-public — plain-HTTP edge (Tier A7 split, ADR-070; TLS terminates at Caddy upstream)
Documentation=https://docs.gregale.dev/ops/gatewayd-public
After=faas-cp.slice network-online.target faas-apid.service faas-gatewayd-internal.service
Wants=faas-cp.slice faas-apid.service faas-gatewayd-internal.service
StartLimitIntervalSec=300s
StartLimitBurst=3

[Service]
Type=simple
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/gatewayd-public
Restart=on-failure
RestartSec=2s
RestartPreventExitStatus=0 SIGTERM
TimeoutStopSec=30s
Slice=faas-cp.slice
MemoryMax=512M
AmbientCapabilities=
Environment=FAAS_PUBLIC_CONTROL_ADDR=127.0.0.1:9092
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas

[Install]
WantedBy=multi-user.target
