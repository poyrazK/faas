[Unit]
Description=onebox-faas gatewayd — edge proxy (DO dev, TLS disabled)
After=faas-cp.slice network-online.target faas-apid.service faas-schedd.service
Wants=faas-cp.slice faas-apid.service faas-schedd.service

[Service]
Type=simple
ExecStart=/opt/faas/bin/gatewayd --config /etc/faas/gatewayd.toml
Restart=on-failure
RestartSec=2s
Slice=faas-cp.slice
MemoryMax=512M
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecReload=/bin/kill -HUP $MAINPID
User=faas
Group=faas
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# /run/faas is owned by faas-vmmd.service (the SOLE RuntimeDirectory=faas
# across the faas service set; see faas-vmmd.service for the long version).
# Declaring it here would create a second per-unit tmpfs whose bind-mount
# would not propagate back to /run, so gatewayd's unix sockets would land
# inside this unit's tmpfs and be invisible to imaged/schedd/vmmd.
# ReadWritePaths=/run/faas below is sufficient — gatewayd writes into
# the host /run/faas directory that vmmd's RuntimeDirectory created.
ReadWritePaths=/run/faas
ReadOnlyPaths=/etc/faas
EnvironmentFile=/etc/faas/sealed.env

[Install]
WantedBy=multi-user.target
