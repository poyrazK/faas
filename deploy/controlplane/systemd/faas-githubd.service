[Unit]
Description=onebox-faas githubd — GitHub App integration
After=network.target postgresql.service faas-cp.slice
Wants=faas-cp.slice
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/githubd --config /etc/faas/githubd.toml
Restart=always
RestartSec=2s
RestartPreventExitStatus=0 SIGTERM
TimeoutStopSec=30s
Slice=faas-cp.slice
MemoryMax=256M
EnvironmentFile=/etc/faas/sealed.env
Environment=FAAS_HOST_AGE_IDENTITY_PATH=%d/faas_host_age_identity
LoadCredential=faas_host_age_identity:/etc/faas/secrets/host.age
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/var/log/faas /var/lib/faas /run/faas

[Install]
WantedBy=multi-user.target
