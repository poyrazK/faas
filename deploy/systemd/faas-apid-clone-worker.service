[Unit]
Description=Gregale private project-environment clone worker (ADR-531)
Documentation=https://gregale.dev/docs/ops/apid
After=network.target postgresql.service faas-cp.slice faas-apid.service
Wants=faas-cp.slice
Requires=postgresql.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
User=faas-apid
Group=faas
ExecStart=/opt/faas/current/bin/apid --clone-worker --config /etc/faas/apid.toml
Restart=on-failure
RestartSec=2s
WatchdogSec=90s
Slice=faas-cp.slice
MemoryHigh=768M
MemoryMax=1073741824
CPUQuota=100%
TasksMax=64
CapabilityBoundingSet=
AmbientCapabilities=
EnvironmentFile=/etc/faas/sealed.env
EnvironmentFile=-/etc/faas/storage.env
EnvironmentFile=-/etc/faas/otel.env
Environment=FAAS_APID_ROLE=control-plane
Environment=FAAS_FLEET_AGE_IDENTITY_PATH=%d/faas_fleet_age_identity
Environment=FAAS_FLEET_AGE_RECIPIENT_PATH=%d/faas_fleet_age_recipient
Environment=FAAS_HOST_HMAC_KEY_PATH=%d/faas_host_hmac_key
Environment=FAAS_CLONE_WORKER_SPOOL_DIR=/var/spool/faas/apid-clone-worker
Environment=GOMAXPROCS=1
Environment=GOMEMLIMIT=768MiB
LoadCredential=faas_fleet_age_identity:/etc/faas/secrets/fleet.age
LoadCredential=faas_fleet_age_recipient:/etc/faas/secrets/fleet.age.pub
LoadCredential=faas_host_age_identity:/etc/faas/secrets/host.age
LoadCredential=faas_host_hmac_key:/etc/faas/secrets/host.hmac.key
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/var/spool/faas/apid-clone-worker

[Install]
WantedBy=multi-user.target
