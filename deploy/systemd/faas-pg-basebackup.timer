[Unit]
Description=Nightly onebox-faas Postgres base backup (spec §14 M8)
Documentation=https://github.com/poyrazK/cloud-faas

[Timer]
# 03:00 UTC avoids the unattended-upgrades window at ~04:00 UTC on
# Ubuntu 24.04 hosts (spec §11). RandomizedDelaySec spreads the load
# across a fleet; on a one-box install it's harmless.
OnCalendar=*-*-* 03:00:00 UTC
Persistent=true
RandomizedDelaySec=900
AccuracySec=60s
Unit=faas-pg-basebackup.service

[Install]
WantedBy=timers.target
