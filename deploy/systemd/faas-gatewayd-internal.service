[Unit]
Description=onebox-faas gatewayd-internal — routing + wake + proxy (Tier A7 split, ADR-070)
Documentation=https://docs.gregale.dev/ops/gatewayd-internal
After=faas-cp.slice network-online.target faas-apid.service faas-schedd.service
Wants=faas-cp.slice faas-apid.service faas-schedd.service
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/gatewayd-internal --config /etc/faas/gatewayd-internal.toml
Restart=always
RestartSec=2s
RestartPreventExitStatus=0 SIGTERM
TimeoutStopSec=30s
Slice=faas-cp.slice
MemoryMax=512M
Environment=FAAS_GATEWAY_LISTEN=off
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadWritePaths=/run/faas

[Install]
WantedBy=multi-user.target
