[Unit]
Description=onebox-faas gatewayd-internal — routing + wake + proxy (Tier A7 split, ADR-070)
Documentation=https://docs.gregale.dev/ops/gatewayd-internal
After=faas-cp.slice network-online.target faas-vmmd.service faas-realtimed.service
Wants=faas-cp.slice faas-vmmd.service faas-realtimed.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/gatewayd-internal --config /etc/faas/gatewayd-internal.toml
Restart=on-failure
RestartSec=2s
RestartCountExport=SYSTEMD_RESTARTS_ON_FAILURE
Slice=faas-cp.slice
MemoryMax=512M
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
EnvironmentFile=-/etc/faas/compute-db.env
EnvironmentFile=-/etc/faas/secrets/gatewayd-internal/gatewayd-internal.env
EnvironmentFile=-/etc/faas/otel.env
Environment=FAAS_GATEWAY_LISTEN=off
Environment=FAAS_REALTIME_SOCKET=/run/faas/realtimed.sock
Environment=FAAS_HOST_KEY_PATH=%d/host.age
Environment=FAAS_SESSION_KEY=%d/faas_session_key
Environment=FAAS_LOG_ARCHIVE_CREDS_PATH=%d/faas_archive_creds
LoadCredential=host.age:/etc/faas/secrets/host.age
LoadCredential=host.age.previous:-/etc/faas/secrets/host.age.previous
LoadCredential=faas_session_key:/etc/faas/secrets/session.key
LoadCredential=faas_archive_creds:-/etc/faas/secrets/storage-box/archive-creds.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas /var/lib/faas/log-drains

[Install]
WantedBy=multi-user.target
