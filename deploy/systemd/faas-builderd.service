[Unit]
Description=onebox-faas builderd — build orchestrator + ephemeral builder microVMs (spec §4.5, ADR-003, ADR-005)
Documentation=https://docs.gregale.dev/ops/builderd
After=network.target faas-cp.slice faas-vmmd.service
Wants=faas-cp.slice faas-vmmd.service
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=faas-builderd
Group=faas
ExecStart=/opt/faas/current/bin/builderd
Restart=always
RestartSec=2s
RestartPreventExitStatus=0 SIGTERM
TimeoutStopSec=30s
Slice=faas-cp.slice
MemoryMax=512M
EnvironmentFile=/etc/faas/sealed.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/srv/fc/builder /srv/fc/base /var/log/faas /var/spool/faas

[Install]
WantedBy=multi-user.target
