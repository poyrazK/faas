[Unit]
Description=onebox-faas apid — public control-plane API (spec §4.1)
Documentation=https://gregale.dev/docs/ops/apid
After=network.target postgresql.service faas-cp.slice faas-apid.socket
Wants=faas-cp.slice
Requires=postgresql.service faas-apid.socket
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=faas-apid
Group=faas
ExecStart=/opt/faas/current/bin/apid --config /etc/faas/apid.toml
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2s
WatchdogSec=90s
Slice=faas-cp.slice
MemoryMax=512M
OOMPolicy=continue
CapabilityBoundingSet=
AmbientCapabilities=
EnvironmentFile=/etc/faas/sealed.env
EnvironmentFile=-/etc/faas/storage.env
EnvironmentFile=-/etc/faas/profiling.env
EnvironmentFile=-/etc/faas/otel.env
Environment=GOMEMLIMIT=256MiB
Environment=FAAS_INTERNAL_MAIL_PRODUCER_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_OUTBOX_RECONCILIATION_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_VERIFICATION_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PASSWORD_CHANGED_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PASSWORD_RESET_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MAGIC_LINK_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_DISABLED_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_DISABLE_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_DEPLOYMENT_FAILED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_SUBSCRIPTION_ENDED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_QUOTA_WARNING_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_NONPAYMENT_DELETION_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_ACCOUNT_SUSPENDED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_ACCOUNT_RESTORED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MANAGED_POSTGRES_CAP_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PAYMENT_FAILED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_ENABLED_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_RECOVERY_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_VERIFICATION_IDENTITY_PATH=%d/faas_mail_verification_identity
Environment=FAAS_INTERNAL_MAIL_VERIFICATION_PREVIOUS_IDENTITY_PATH=%d/faas_mail_verification_identity_previous
Environment=FAAS_BILLING_MODE=live
Environment=FAAS_SESSION_KEY=%d/faas_session_key
Environment=FAAS_HOST_AGE_IDENTITY_PATH=%d/faas_host_age_identity
Environment=FAAS_FLEET_AGE_IDENTITY_PATH=%d/faas_fleet_age_identity
Environment=FAAS_FLEET_AGE_RECIPIENT_PATH=%d/faas_fleet_age_recipient
Environment=FAAS_HOST_AGE_RECIPIENT_PATH=%d/faas_host_age_recipient
Environment=FAAS_HOST_HMAC_KEY_PATH=%d/faas_host_hmac_key
Environment=FAAS_LOG_ARCHIVE_CREDS_PATH=%d/faas_archive_creds
Environment=FAAS_APID_ADVISORY_SOCK=/run/faas/apid.sock
Environment=FAAS_STATUSPAGE_PATH=/etc/faas/statuspage/index.html
Environment=FAAS_DPA_PATH=/etc/faas/dpa.md
Environment=FAAS_REALTIME_SOCKET=/run/faas/realtimed.sock
Environment=FAAS_REALTIME_FAIR_USE_ENABLED=1
Environment=FAAS_APP_TASK_API_ENABLED=0
Environment=FAAS_EXECUTION_API_ENABLED=0
Environment=FAAS_CI_INTERNAL_ENABLED=0
Environment=FAAS_CI_INTERNAL_ACCOUNTS=
Environment=FAAS_CI_GITHUB_ENABLED=0
Environment=FAAS_CI_GITHUB_CHECKS_ENABLED=0
Environment=FAAS_CI_EXECUTION_CHECKS_ENABLED=0
Environment=FAAS_CI_AUTOMATION_ENABLED=0
Environment=FAAS_CI_DISPATCH_ENABLED=0
Environment=FAAS_CI_WORKER_ENABLED=0
Environment=FAAS_CI_TRANSPORT_ENABLED=0
Environment=FAAS_CI_RETENTION_ENABLED=0
Environment=FAAS_CI_GCS_BUCKET=
Environment=FAAS_CI_RUNTIME_URL=
Environment=FAAS_WORKFLOWS_ENABLED=1
LoadCredential=faas_session_key:/etc/faas/secrets/session.key
LoadCredential=faas_host_age_identity:/etc/faas/secrets/host.age
LoadCredential=faas_fleet_age_identity:/etc/faas/secrets/fleet.age
LoadCredential=faas_fleet_age_recipient:/etc/faas/secrets/fleet.age.pub
LoadCredential=faas_host_age_recipient:/etc/faas/secrets/host.age.pub
LoadCredential=faas_host_hmac_key:/etc/faas/secrets/host.hmac.key
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/srv/fc /var/lib/faas /var/log/faas /var/spool/faas

[Install]
WantedBy=multi-user.target
