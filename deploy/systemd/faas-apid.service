[Unit]
Description=onebox-faas apid — public control-plane API (spec §4.1)
Documentation=https://docs.gregale.dev/ops/apid
After=network.target postgresql.service faas-cp.slice
Wants=faas-cp.slice
Requires=postgresql.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=faas-apid
Group=faas
ExecStart=/opt/faas/current/bin/apid --config /etc/faas/apid.toml
Restart=on-failure
RestartSec=2s
RestartCountExport=SYSTEMD_RESTARTS_ON_FAILURE
Slice=faas-cp.slice
MemoryMax=256M
AmbientCapabilities=CAP_NET_BIND_SERVICE
EnvironmentFile=/etc/faas/sealed.env
Environment=FAAS_SESSION_KEY=%d/faas_session_key
Environment=FAAS_HOST_AGE_IDENTITY_PATH=%d/faas_host_age_identity
Environment=FAAS_HOST_HMAC_KEY_PATH=%d/faas_host_hmac_key
Environment=FAAS_LOG_ARCHIVE_CREDS_PATH=%d/faas_archive_creds
Environment=FAAS_APID_ADVISORY_SOCK=/run/faas/apid.sock
Environment=FAAS_STATUSPAGE_PATH=/etc/faas/statuspage/index.html
LoadCredential=faas_session_key:/etc/faas/secrets/session.key
LoadCredential=faas_host_age_identity:/etc/faas/secrets/host.age
LoadCredential=faas_host_age_identity_previous:-/etc/faas/secrets/host.age.previous
LoadCredential=faas_host_hmac_key:/etc/faas/secrets/host.hmac.key
LoadCredential=faas_archive_creds:-/etc/faas/secrets/storage-box/archive-creds.json
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/var/lib/faas /var/log/faas /var/spool/faas

[Install]
WantedBy=multi-user.target
