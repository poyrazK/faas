[Unit]
Description=Gregale durable schedd listener
Documentation=https://gregale.dev/docs/ops/schedd
Before=faas-schedd.service

# Owns schedd's unix socket across restarts so apid's and the gateway's
# calls wait for the replacement (docs/adr/1580-zero-downtime-daemon-restarts.md).
# schedd must serve this address (socket_path, empty listen_addr); it refuses
# to start with an inherited socket it does not serve. Compute-only nodes
# listen on TCP and use their own unit without this socket.
[Socket]
ListenStream=/run/faas/schedd.sock
SocketUser=faas-schedd
SocketGroup=faas
SocketMode=0660
FileDescriptorName=schedd
Backlog=4096
Service=faas-schedd.service

[Install]
WantedBy=sockets.target
