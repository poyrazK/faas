[Unit]
Description=Gregale durable realtimed listener
Documentation=https://gregale.dev/docs/ops/realtime
Before=faas-realtimed.service

# Holds realtimed's unix socket across restarts so gatewayd-internal's
# realtime connects and management calls wait for the replacement
# (docs/adr/1736-zero-downtime-daemon-restarts.md). Inert unless the
# gatewayd_internal_service role sets faas_compute_durable_listeners.
[Socket]
ListenStream=/run/faas/realtimed.sock
SocketUser=faas
SocketGroup=faas
SocketMode=0660
FileDescriptorName=realtimed
Backlog=4096
Service=faas-realtimed.service

[Install]
WantedBy=sockets.target
