[Unit]
Description=onebox-faas Postgres base backup push (off-host)
Documentation=https://github.com/poyrazK/cloud-faas
After=faas-pg-basebackup.service
# Don't gate on faas-pg-basebackup.service — the timer fires at 03:30
# UTC (30 min after the local 03:00 UTC basebackup timer). If the local
# run was skipped / is still in flight, the push waits at `rclone sync`
# for the newest tarball — but only one tarball exists at any time on
# a healthy box, so the "wait" is bounded by the basebackup's own
# 30 min TimeoutStartSec.

# Spec §14 M8 + issue #250: ships /var/lib/pgsql/basebackup/ to the
# off-host backup box via rclone so a host loss is recoverable from
# off-host state. The off-host box is the canonical S3-of-one-box
# replacement the spec explicitly forbids (no local-only backup).
#
# Why `rclone sync` (not `copy`): removes orphaned files on the
# off-host box so a failed intermediate push + basebackup prune
# doesn't accumulate stale tarballs. The local tree is the source of
# truth; the box is a mirror.
#
# Why `--config=%d/faas_off_host_backup_rclone`: the rclone.conf is
# sealed-at-rest via host.age (PR #371 cosign precedent) and decrypted
# into a tmpfs staging dir at ansible-run time. systemd `LoadCredential=`
# surfaces the plaintext file inside the unit's $CREDENTIALS_DIRECTORY
# at activation; systemd's `%d` expands to that directory. The
# end-to-end chain is: age-sealed on disk → tmpfs staging at ansible
# run → LoadCredential in unit → rclone reads plaintext at exec time
# (the network channel is SSH-encrypted by rclone's sftp backend; the
# file on disk is what we're protecting at rest).
#
# PR-8 (issue #911 / ADR-110 deferred): env var renamed from
# HETZNER_STORAGE_BOX_BASEBACKUP_PATH → OFF_HOST_BACKUP_BASEBACKUP_PATH.
# Off-host box is operator-agnostic; the rclone remote alias is
# `offhostbox:` (was `hertznerbox:`). Match the ansible role's
# vars_files rename + the `99-faas-off-host-backup.conf` drop-in.

[Service]
Type=oneshot
User=root
Group=root

Environment=OFF_HOST_BACKUP_BASEBACKUP_PATH=faas-pg-basebackup
# Issue #585 / ADR-127 — sealed.env is apid-only; pg-basebackup-push no
# longer inherits it. The rclone config (sealed at rest via host.age) is
# loaded via LoadCredential below. The bash ExecStart uses
# --config=%d/faas_off_host_backup_rclone, which resolves to
# $CREDENTIALS_DIRECTORY/faas_off_host_backup_rclone — only valid when
# the matching LoadCredential directive has staged the file at
# unit activation. Missing the LoadCredential would silently make the
# path nonexistent and rclone exit with "config file not found".
LoadCredential=faas_off_host_backup_rclone:/etc/faas/secrets/pg-basebackup-push/rclone.conf

ExecStart=/usr/bin/env bash -c '\
  set -euo pipefail; \
  src=/var/lib/pgsql/basebackup; \
  [[ -d "$${src}" ]] || { echo "no $$src" >&2; exit 1; }; \
  [[ -n "$$(ls -1A "$${src}")" ]] || { echo "$$src empty — nothing to push" >&2; exit 1; }; \
  rclone sync "$${src}" "offhostbox:$${OFF_HOST_BACKUP_BASEBACKUP_PATH}" \
    --config=%d/faas_off_host_backup_rclone \
    --stats=0 --quiet; \
  echo "pushed $$src → offhostbox:$${OFF_HOST_BACKUP_BASEBACKUP_PATH}"'
SuccessExitStatus=0
TimeoutStartSec=2h

# Spec §11: backup tarballs contain customer PII and sealed secrets;
# any process that touches them must not pass them world-readable.
# Root-owned run is the right primitive — only root can run the push
# (matches the LoadCredential pattern: $CREDENTIALS_DIRECTORY is
# mode 0600 root:root by systemd contract).
UMask=0077

# Push is disk + network bound; stdio to journal is fine. Failures
# surface in `journalctl -u faas-pg-basebackup-push.service` and the
# `pg_backup_last_pushed_seconds` gauge on apid's /metrics scrape
# (cmd/apid/main.go pgBackupPushedSampler).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
