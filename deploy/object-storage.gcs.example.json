{
  "default_region": "us-east-1",
  "public_endpoint": "https://s3.gregale.dev",
  "public_region": "us-east-1",
  "defaults": { "us-east-1": "gcs-us-east1-v1" },
  "max_buckets_per_app": 10,
  "max_upload_bytes": 104857600,
  "max_single_put_bytes": 67108864,
  "max_part_bytes": 67108864,
  "transfer": { "profile": "proxied", "timeout_seconds": 1800, "max_concurrent_uploads": 4, "max_spool_bytes": 268435456, "min_spool_free_bytes": 1073741824 },
  "accounting": null,
  "backends": [
    {
      "id": "gcs-us-east1-v1",
      "driver": "gcs",
      "region": "us-east-1",
      "namespace": "replace-with-your-dedicated-gcp-project-id",
      "gcs_location": "US-EAST1",
      "gcs_storage_class": "STANDARD",
      "gcs_service_account": "gregale-storage@replace-with-your-project.iam.gserviceaccount.com",
      "gcs_impersonate_service_account": true,
      "encryption": { "algorithms": ["AES256"] },
      "allowed_origins": ["https://gregale.dev"]
    }
  ]
}
