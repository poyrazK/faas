[Unit]
Description=onebox-faas vmmd — microVM supervisor (the only root component, spec §4.4)
Documentation=https://docs.gregale.dev/ops/vmmd
After=faas-tenant.slice faas-cp.slice
Wants=faas-tenant.slice faas-cp.slice

[Service]
Type=simple
ExecStart=/opt/faas/bin/vmmd --config /etc/faas/vmmd.toml
Restart=on-failure
RestartSec=2s

Slice=faas-cp.slice
# Aligned with pkg/daemonunitspec/vmmd.go (2026-09-04). vmmd's cgroup is
# charged for the jail tmpfs it writes (~400 MB layer.ext4 per live
# instance), so a tighter-than-slice cap is really a cap on jail
# residency. MemoryHigh is deliberately absent: that shmem is
# unreclaimable without swap, so MemoryHigh only spun the reclaim path
# and made every vmmd child thrash on its own text pages.
MemoryMax=3G

AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/faas/secrets /run/faas /srv/fc /var/log/faas
# RuntimeDirectory=faas (not ReadWritePaths alone) makes /run/faas
# a real directory on the host /run tmpfs, bind-mounted into this
# unit's mount namespace and propagated back. With PrivateTmp=yes
# the dirent would be created inside vmmd's per-mount-namespace
# tmpfs instance and NOT visible from the host — every other daemon
# that dials /run/faas/vmmd.sock would get `no such file or directory`
# even though `ss -lnx` shows the LISTEN entry (run 30839233808).
#
# This unit is the SOLE owner of /run/faas on disk. schedd and
# gatewayd-internal does NOT declare RuntimeDirectory=faas — when systemd sees
# RuntimeDirectory=faas on multiple units, only the first one to
# start gets its bind-mount propagated to the host /run; the others
# silently fall through to writing into the existing dirent, which
# puts their .sock into the first service's per-unit tmpfs instead
# of the host's. schedd.sock + vmmd.sock land in two different
# filesystem layers and only schedd.sock is visible from the host
# (run 30841750214, post-#619). Keeping the declaration on vmmd
# alone ensures all writes go through the same bind-mount.
#
# RuntimeDirectory creates the dir as root:root. Mode 0775 gives the
# OWNER group (root, not faas) write+execute, so faas-schedd still gets
# `bind: permission denied` even though it sits in the `faas` group.
# We can't change the OWNER via RuntimeDirectory (vmmd has no User=,
# and there's no `RuntimeDirectoryGroup=` directive), so ExecStartPre
# re-chowns to root:faas 0775 right after systemd creates the dir.
# Idempotent on restart (chown of matching ownership is a no-op).
ExecStartPre=/usr/bin/chown root:faas /run/faas
ExecStartPre=/usr/bin/chmod 0775 /run/faas
PrivateTmp=no
RuntimeDirectory=faas
RuntimeDirectoryMode=0775
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
