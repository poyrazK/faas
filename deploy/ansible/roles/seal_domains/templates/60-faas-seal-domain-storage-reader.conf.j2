# Managed by the seal_domains role (ADR 20261022111812): s3-gatewayd opens
# Gregale S3 secret access keys with the storage seal-domain identity, and
# its startup rekey leaves the credentials that identity opens alone. The
# fleet identity stays in the base unit until the domain re-seal completes.
[Service]
{% if faas_seal_domain_storage_contracted | bool %}
# Contracted: an empty LoadCredential= drops every credential loaded before
# this drop-in: the base unit's fleet and host identities and the
# host.age.previous the optional_credentials role projects (40-*).
# s3-gatewayd holds only the domain identity below and skips its startup
# rekey.
LoadCredential=
UnsetEnvironment=FAAS_HOST_AGE_IDENTITY_PATH
{% endif %}
LoadCredential=faas_seal_domain_storage:/etc/faas/secrets/domains/storage.age
{% if faas_seal_domain_storage_previous_identity_src | length > 0 %}
LoadCredential=faas_seal_domain_storage_previous:/etc/faas/secrets/domains/storage.age.previous
{% endif %}
Environment=FAAS_SEAL_DOMAIN_STORAGE_IDENTITY_PATH=%d/faas_seal_domain_storage
