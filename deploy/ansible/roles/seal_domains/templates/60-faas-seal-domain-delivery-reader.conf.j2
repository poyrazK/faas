# Managed by the seal_domains role (ADR 20261022111812): schedd opens app
# webhook signing secrets, commit-source connections and execution payloads
# with the delivery seal-domain identity. The fleet identity stays in the
# base unit until the domain re-seal completes.
[Service]
LoadCredential=faas_seal_domain_delivery:/etc/faas/secrets/domains/delivery.age
{% if faas_seal_domain_delivery_previous_identity_src | length > 0 %}
LoadCredential=faas_seal_domain_delivery_previous:/etc/faas/secrets/domains/delivery.age.previous
{% endif %}
Environment=FAAS_SEAL_DOMAIN_DELIVERY_IDENTITY_PATH=%d/faas_seal_domain_delivery
