{% if faas_seal_domain_control_retired_on_compute | bool %}
# Managed by the seal_domains role (ADR-20261110210000 slice 3k-2): this node
# holds no control identity. schedd asks secretd for internal-service and
# workflow outbound tokens, and refuses to start while a control or fleet
# identity is still loaded.
[Service]
Environment=FAAS_SEAL_DOMAIN_CONTROL_RETIRED=true
{% else %}
# Managed by the seal_domains role (ADR 20261022111812): schedd opens the
# cluster signing key with the control seal-domain identity. The fleet
# identity stays in the base unit until the domain re-seal completes.
[Service]
LoadCredential=faas_seal_domain_control:/etc/faas/secrets/domains/control.age
{% if faas_seal_domain_control_previous_identity_src | length > 0 %}
LoadCredential=faas_seal_domain_control_previous:/etc/faas/secrets/domains/control.age.previous
{% endif %}
Environment=FAAS_SEAL_DOMAIN_CONTROL_IDENTITY_PATH=%d/faas_seal_domain_control
{% endif %}
