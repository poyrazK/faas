# Managed by the seal_domains role (ADR 20261022111812): schedd opens the
# cluster signing key with the control seal-domain identity. The fleet
# identity stays in the base unit until the domain re-seal completes.
[Service]
LoadCredential=faas_seal_domain_control:/etc/faas/secrets/domains/control.age
Environment=FAAS_SEAL_DOMAIN_CONTROL_IDENTITY_PATH=%d/faas_seal_domain_control
