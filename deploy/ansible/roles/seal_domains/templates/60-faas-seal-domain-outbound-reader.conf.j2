# Managed by the seal_domains role (ADR 20261022111812): outboundd opens
# customer outbound credentials with the outbound seal-domain identity. The
# fleet identity stays in the base unit until the domain re-seal completes.
[Service]
LoadCredential=faas_seal_domain_outbound:/etc/faas/secrets/domains/outbound.age
{% if faas_seal_domain_outbound_previous_identity_src | length > 0 %}
LoadCredential=faas_seal_domain_outbound_previous:/etc/faas/secrets/domains/outbound.age.previous
{% endif %}
Environment=FAAS_SEAL_DOMAIN_OUTBOUND_IDENTITY_PATH=%d/faas_seal_domain_outbound
