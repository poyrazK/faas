# Managed by the seal_domains role (ADR 20261022111812): apid seals GitHub
# webhook secret copies to the source seal domain. It holds the public
# recipient only and cannot open what it seals.
[Service]
LoadCredential=faas_seal_domain_source_recipient:/etc/faas/secrets/domains/source.age.pub
Environment=FAAS_SEAL_DOMAIN_SOURCE_RECIPIENT_PATH=%d/faas_seal_domain_source_recipient
Environment=FAAS_SEAL_DOMAIN_SOURCE_WRITES={{ faas_seal_domain_source_writes }}
