# Managed by the seal_domains role (ADR 20261022111812): apid seals app and
# job private-registry passwords to the build seal domain. It holds the
# public recipient only and cannot open what it seals.
[Service]
LoadCredential=faas_seal_domain_build_recipient:/etc/faas/secrets/domains/build.age.pub
Environment=FAAS_SEAL_DOMAIN_BUILD_RECIPIENT_PATH=%d/faas_seal_domain_build_recipient
Environment=FAAS_SEAL_DOMAIN_BUILD_WRITES={{ faas_seal_domain_build_writes }}
