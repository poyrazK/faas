# Managed by Ansible (control_plane_service). Local edits are overwritten.
# ADR-1152: resumable upload sessions spool chunks on the replica that
# started them, so a cell with more than one control node turns them off and
# the CLI falls back to the single-request upload.
[Service]
Environment=FAAS_APID_RESUMABLE_UPLOADS={{ '0' if (groups['control_plane'] | default([]) | length) > 1 else '1' }}
