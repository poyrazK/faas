# Generated by the split-box manifest renderer. Do not edit on the host.
# Secrets remain in /etc/faas/sealed.env; this file contains only routing,
# TLS paths, and non-secret daemon configuration.
schedd_socket = "{{ faas_meterd_schedd_socket }}"
metrics_addr = "127.0.0.1:9106"

{% if faas_meterd_schedd_tls_cert_path | default('') | length > 0 %}
schedd_tls_cert_path = "{{ faas_meterd_schedd_tls_cert_path }}"
schedd_tls_key_path = "{{ faas_meterd_schedd_tls_key_path }}"
schedd_tls_ca_path = "{{ faas_meterd_schedd_tls_ca_path }}"
{% endif %}

{% if faas_meterd_egress_socket | default('') | length > 0 %}
# Remote gatewayd-internal egress stream (mTLS).
egress_socket = "{{ faas_meterd_egress_socket }}"
egress_tls_cert_path = "{{ faas_meterd_egress_tls_cert_path }}"
egress_tls_key_path = "{{ faas_meterd_egress_tls_key_path }}"
egress_tls_ca_path = "{{ faas_meterd_egress_tls_ca_path }}"
{% endif %}

[meter]
# Usage pushes run hourly; the pusher also backfills the configured lookback
# window, so a restart or provider outage does not lose billable hours.
stripe_interval = "1h"

[billing]
# Production defaults to Polar. Operators may explicitly select the
# legacy Stripe or Paddle provider through FAAS_BILLING_PROVIDER in sealed.env.
provider = "polar"
