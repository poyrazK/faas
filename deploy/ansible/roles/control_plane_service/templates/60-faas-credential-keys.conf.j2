# Managed by the control_plane_service role (ADR 20261029202403): apid keys
# the account credential hashes it stores with a ring only it holds.
[Service]
{% if faas_apid_credential_keys_src | length > 0 %}
LoadCredential=faas_credential_keys:/etc/faas/secrets/credential-keys
Environment=FAAS_APID_CREDENTIAL_KEYS_FILE=%d/faas_credential_keys
{% endif %}
Environment=FAAS_APID_CREDENTIAL_WRITES={{ faas_apid_credential_writes }}
Environment=FAAS_APID_CREDENTIAL_PLAIN_LOOKUP={{ faas_apid_credential_plain_lookup | bool | lower }}
