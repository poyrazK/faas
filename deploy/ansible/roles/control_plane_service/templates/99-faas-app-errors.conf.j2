[Service]
# The manifest generator sets this only for a split control plane. The
# listener is private and mTLS-authenticated; single-box deployments keep
# the local /run/faas/app_errors.sock fallback.
{# ADR-20261110120000: a wildcard listener binds the address compute nodes'
   /etc/hosts maps apid.faas to, when this host has it; otherwise every
   address, as before. Keep in step with githubd_service's copy. #}
{% set faas_bind_candidate = faas_private_dns_address | default(faas_private_address | default(((ansible_facts | default({})).default_ipv4 | default({})).address | default(''), true), true) %}
{% set faas_private_bind = faas_bind_candidate if (faas_bind_candidate and faas_bind_candidate in ((ansible_facts | default({})).all_ipv4_addresses | default([]))) else '0.0.0.0' %}
Environment=FAAS_APID_APP_ERRORS_TARGET={{ faas_apid_app_errors_listen | replace('tcp://0.0.0.0:', 'tcp://' ~ faas_private_bind ~ ':') }}
Environment=FAAS_APID_APP_ERRORS_TLS_CERT_PATH=/etc/faas/tls/apid/advisory.crt
LoadCredential=app_errors_tls_key:/etc/faas/tls/apid/advisory.key
Environment=FAAS_APID_APP_ERRORS_TLS_KEY_PATH=%d/app_errors_tls_key
Environment=FAAS_APID_APP_ERRORS_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
