[Service]
# ADR-847 synthetic route probes (on by default, amendment 1). apid sends them
# to the local gatewayd-public listener; route_probes_enabled false keeps
# probes off.
{% if route_probes_enabled | default(true) | bool %}
Environment=FAAS_ROUTE_PROBE_URL={{ faas_route_probe_url | default('http://127.0.0.1:8080') }}
{% endif %}
