# Explicit outbound gateway. Workloads call the guest-reachable address that
# the deployment routes to this listener:
#   http://<outbound-gateway-address>:8095/i/<integration-uuid>/v1/resource
# and send X-Gregale-Workload-Identity for managed credentials, or the
# legacy X-Gregale-Outbound-Token plus X-Gregale-App-ID otherwise.
#
# This gateway never transparently intercepts encrypted egress and never
# retries a provider request. Admission is shared through Postgres.

# Bind to the host-side address reachable from the guest network. Keep the
# listener on a private interface/firewall zone; the integration token is the
# application-level credential.
# Bind to the private interface/address routed from the guest network. Do not
# assume the per-VM 10.0.0.1 tap address exists in the host root namespace.
listen_addr = "127.0.0.1:8095"
# Private Prometheus endpoint; scrape through the node-local metrics collector.
metrics_addr = "127.0.0.1:9108"
# db_url = ""                         # empty => DATABASE_URL / FAAS_DATABASE_URL
# max_body_bytes = 26214400             # 25 MiB
# read_timeout = "30s"
# write_timeout = "2m"
# idle_timeout = "2m"

# Required for managed integrations, including integrations customers create
# through the API. Install a
# public JWKS published by vmmd (never its signing private key) at this path.
# The issuer must exactly match vmmd's configured workload-identity issuer.
# Configure this before customers create integrations; live rows resolve
# without restarting outboundd, but JWKS changes do require a restart.
# workload_identity_jwks_path = "/etc/faas/workload-identity.jwks.json"
# workload_identity_issuer = "https://identity.gregale.dev"

# Each key is only a local config label. The id must be a UUID and account/app
# ownership is checked by the database trigger. The raw Gregale gateway token
# is read once from the named environment variable and only its SHA-256 digest
# is stored. By default, provider authentication headers are supplied by the
# application and forwarded (except X-Gregale-* control headers). Set
# provider_authorization_env to keep one provider Authorization value in
# outboundd instead; the gateway replaces any app-supplied Authorization and
# requires a signed workload identity token rather than the gateway token.
# Managed integrations must also declare allowed_methods and
# allowed_path_prefixes. Prefixes are segment-aware and apply to the app's
# path after /i/<uuid>, before any fixed origin path is prepended. An explicit
# "/" prefix permits every path; use narrow routes and provider-side scopes.
# token_env remains required for the existing schema, but do not expose its
# value to an app using a managed integration.
#
# [integrations.payments]
# id = "00000000-0000-0000-0000-000000000001"
# account_id = "00000000-0000-0000-0000-000000000010"
# name = "payments"
# origin = "https://api.example.com"
# token_env = "FAAS_OUTBOUND_PAYMENTS_TOKEN"
# provider_authorization_env = "FAAS_OUTBOUND_PAYMENTS_PROVIDER_AUTH"
# allowed_methods = ["GET", "POST"]
# allowed_path_prefixes = ["/v1/widgets", "/v1/customers"]
# app_ids = []  # Optional operator attachments; customers can bind via apid.
# rate_per_second = 50
# burst = 50
# max_in_flight = 20
# daily_request_limit = 10000 # optional; plan-capped admitted calls per UTC day
# request_timeout = "30s"
# enabled = true
# request_timeout defaults to 30s when omitted; enabled defaults to true.
# To let the account provide and rotate the provider Authorization value,
# replace provider_authorization_env with credential_source = "customer_sealed".
# apid seals that value using fleet.age.pub, and outboundd opens it using
# its fleet.age LoadCredential. The app never receives either key.
