# Example apid config — copy to /etc/faas/apid.toml on the box.
# Every field is optional; defaults are filled in by the daemon.

# listen_addr: public listener for the v1 REST API. Spec §4.1 binds :443.
# Default: 127.0.0.1:8081  (behind a TLS-terminating reverse proxy)
# listen_addr = "127.0.0.1:8081"

# apps_domain: the wildcard suffix for app URLs.
# Default: gregale.dev
# apps_domain = "gregale.dev"

# cli_auth_url_base: public console origin for the browser half of CLI login.
# The public edge forwards /cli-auth from this origin to apid.
# A bare hostname is normalized to https://<hostname>.
# Default: https://gregale.dev
# cli_auth_url_base = "https://gregale.dev"

# db_url: Postgres DSN. Empty => use $DATABASE_URL from the environment
# (sealed.env on the production box; gap G2 — sealed at rest).
# db_url = ""

# log_level: slog level (debug, info, warn, error).
# Default: info
# log_level = "info"

# Multi-box control-plane mTLS (ADR-052). The advisory gRPC listener
# (apid's inbound channel for vmmd fanotify batches) and the githubd
# client (apid's outbound dial for webhook dispatch) read TLS material
# from env vars, not TOML — there's no apid.toml cluster for them
# today. Single-box deployments leave the env unset and the daemons
# dial over the unix socket. Multi-box deployments stamp:
#
#   FAAS_APID_ADVISORY_TLS_CERT_PATH = /etc/faas/tls/apid/advisory.crt
#   FAAS_APID_ADVISORY_TLS_KEY_PATH  = /etc/faas/tls/apid/advisory.key
#   FAAS_APID_ADVISORY_TLS_CA_PATH   = /etc/faas/tls/ca/ca.crt
#   FAAS_GITHUBD_TLS_CERT_PATH       = /etc/faas/tls/apid/githubd-client.crt
#   FAAS_GITHUBD_TLS_KEY_PATH        = /etc/faas/tls/apid/githubd-client.key
#   FAAS_GITHUBD_TLS_CA_PATH         = /etc/faas/tls/ca/ca.crt
#
# Partial cluster is rejected at startup with the exact env-var
# name(s) missing. See cmd/gregale/commands_pki.go for the operator
# CLI that issues /etc/faas/tls/<daemon>/<role>.{crt,key}.

# Per-app cosign signature-enforcement (issue #472 / ADR-058).
# apid reads the env var on startup; it points at the directory
# where apid mirrors each (app_id, signer_name) row as a base64-DER
# blob so imaged can read it directly. The directory is created
# by the ansible role (mode 0755 root:root) and per-file perms
# are 0444 root:root. Default location if unset:
#
#   /etc/faas/secrets/trusted-publishers
#
# Operator onboards a publisher via:
#
#   gregale trusted-publishers add <slug> <name> <pub.pem>
#
# which PUTs the base64(DER) blob to /v1/apps/{slug}/trusted_signers/{name}.
# apid then writes the per-app mirror to this directory; imaged
# picks it up via pg_notify('trusted_signer_changed') and
# refreshes its in-memory trust cache on the next deploy.

# [billing] block — provider config (PR-P2 + public-release billing). Every key
# has a working default; missing block ⇒ Polar is selected and credentials
# plus catalog IDs are required before the daemon starts.
# Env wins over TOML: FAAS_BILLING_PROVIDER, STRIPE_API_KEY,
# STRIPE_WEBHOOK_SECRET, FAAS_PADDLE_*, and FAAS_POLAR_* override the
# values below when set.
#
# [billing]
# provider = "polar"      # "" | "stripe" | "paddle" | "polar"; default "" (public release = Polar)
#
# [billing.polar]             # public-release MoR provider
# api_key                = "" # organization access token; or FAAS_POLAR_ACCESS_TOKEN env
# webhook_secret         = "" # Standard Webhooks secret; or FAAS_POLAR_WEBHOOK_SECRET env
# sandbox                = false # true → sandbox-api.polar.sh; or FAAS_POLAR_SANDBOX=1
# meter_id               = "" # required Polar meter UUID; or FAAS_POLAR_METER_ID env
# hobby_product_id       = "" # recurring Polar product UUID
# pro_product_id         = "" # recurring Polar product UUID
# scale_product_id       = "" # recurring Polar product UUID
# usage_event_name       = "faas_ram_usage" # meter event filter name
# success_url            = "" # optional hosted-checkout redirect
# return_url             = "" # optional hosted-checkout back link
# base_url               = "" # empty = https://api.polar.sh
#
# [billing.paddle]            # explicit legacy provider
# api_key        = ""     # pdl_live_… or pdl_sandbox_…; or FAAS_PADDLE_API_KEY env
# webhook_secret = ""     # whk_…                  ; or FAAS_PADDLE_WEBHOOK_SECRET env
# sandbox        = false  # true → api.sandbox.paddle.com; or FAAS_PADDLE_SANDBOX=1
#
# [billing.stripe]            # legacy opt-in (FAAS_BILLING_PROVIDER=stripe)
# api_key           = ""  # sk_test_… or sk_live_…; or STRIPE_API_KEY env
# webhook_secret    = ""  # whsec_…              ; or STRIPE_WEBHOOK_SECRET env
# tolerance_seconds = 300 # Stripe-Signature timestamp tolerance (default 5 min)
