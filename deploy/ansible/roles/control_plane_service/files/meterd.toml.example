# Example meterd config — copy to /etc/faas/meterd.toml on the box.
# Every field has a working default; an empty file yields a runnable daemon.

# schedd_socket: unix socket meterd dials to call ParkInstance on a
# Free-tier hard stop (spec §4.7 / ADR-019). Overridable via the
# FAAS_SCHEDD_ADDR env var so the e2e harness can swap in a per-test
# socket without rewriting the unit file. Issue #52 acceptance:
# BOTH empty means the daemon refuses to start (strict exit), so a
# misconfigured deployment can never silently run unbounded.
#
# Default: /run/faas/schedd.sock
# schedd_socket = "/run/faas/schedd.sock"

# db_url: Postgres DSN. Empty => $DATABASE_URL from the environment.
# db_url = ""

# metrics_addr: bind address for the Prometheus /metrics endpoint.
# Empty disables it.
# metrics_addr = "127.0.0.1:9106"

# Multi-box control-plane mTLS (ADR-052). meterd dials schedd on the
# unix socket by default — single-box deployments keep all three
# paths empty and the dial skips TLS. Multi-box deployments point
# schedd_socket at a tcp:// or dns:// target and populate the
# schedd_tls_* cluster with the per-daemon leaf issued by
# `gregale pki init` (see /etc/faas/tls/meterd/schedd-client.{crt,key}
# + /etc/faas/tls/ca/ca.crt). Partial cluster is rejected at startup
# with the exact field name(s) missing.
# schedd_tls_cert_path = "/etc/faas/tls/meterd/schedd-client.crt"
# schedd_tls_key_path  = "/etc/faas/tls/meterd/schedd-client.key"
# schedd_tls_ca_path   = "/etc/faas/tls/ca/ca.crt"

# gateway_egress_socket: dial target meterd uses to read tx_bytes
# (ADR-046). Default /run/faas/gatewayd-egress.sock; multi-box
# deployments override with tcp://<gatewayd-overlay-ip>:port and
# populate the gateway_egress_tls_* cluster.
# gateway_egress_socket = "/run/faas/gatewayd-egress.sock"
# gateway_egress_tls_cert_path = "/etc/faas/tls/meterd/gatewayd-egress-client.crt"
# gateway_egress_tls_key_path  = "/etc/faas/tls/meterd/gatewayd-egress-client.key"
# gateway_egress_tls_ca_path   = "/etc/faas/tls/ca/ca.crt"

# egress_socket: dial target meterd uses to read tx_bytes (ADR-046).
# PR-C rename of gateway_egress_socket. Single-box default
# /run/faas/egress.sock; multi-box deployments override with
# tcp://<node>:port and populate the egress_tls_* cluster. The
# resolver (pkg/gateway/egresssocket) prefers egress_socket then
# falls back to the legacy gateway_egress_socket for one release
# cycle. Default values are pre-populated (not commented out) so a
# fresh deploy picks up the new paths without operator action.
egress_socket = "/run/faas/egress.sock"
egress_tls_cert_path = "/etc/faas/tls/meterd/egress-client.crt"
egress_tls_key_path  = "/etc/faas/tls/meterd/egress-client.key"
# CA path: single-box leaves this empty (the daemon's own CA is
# trusted via the system trust store). Multi-box points at the
# control-plane CA bundle (/etc/faas/tls/ca/ca.crt).
egress_tls_ca_path = ""

# meter block — timer cadences + the per-tick behavior knobs. Default
# cadences: sample 60s, quota 60s, stripe 60m. Override via env:
# FAAS_SAMPLE_INTERVAL, FAAS_QUOTA_INTERVAL, FAAS_STRIPE_INTERVAL.
# Sample and quota intervals must be ≤ 60s on busy days; the stripe
# interval can be longer (the §14 sample is monthly).
[meter]
# sample_interval = "60s"
# quota_interval = "60s"
# stripe_interval = "60m"

# [billing] block — provider config (PR-P2). meterd doesn't read
# webhook_secret (no ingress) but the surface is kept for parity with
# apid's [billing] block; the loader accepts both. Env wins over TOML.
#
# [billing]
# provider = "stripe"     # "" | "stripe" | "paddle"; default "" (legacy = Stripe)
#
# [billing.stripe]
# api_key           = ""  # sk_test_… or sk_live_…; or STRIPE_API_KEY env
# webhook_secret    = ""  # unused by meterd; or STRIPE_WEBHOOK_SECRET env
# tolerance_seconds = 300 # Stripe-Signature timestamp tolerance (default 5 min)
#
# [billing.paddle]
# api_key        = ""    # pdl_live_… or pdl_sandbox_…; or FAAS_PADDLE_API_KEY env
# webhook_secret = ""    # unused by meterd   ; or FAAS_PADDLE_WEBHOOK_SECRET env
# sandbox        = false # true → api.sandbox.paddle.com; or FAAS_PADDLE_SANDBOX=1
