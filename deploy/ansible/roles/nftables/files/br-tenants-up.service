[Unit]
Description=faas tenant bridge (br-tenants) up — bridge + 10.100.0.1/16
Documentation=https://docs.gregale.dev/ops/network
# Order BEFORE nftables.service so the host firewall's forward chain (which
# uses `iifname "br-tenants"`) can load against an interface that exists.
# Order BEFORE vmmd.service so vmmd's per-instance netns creation (which
# attempts to enslave the host-side veth to br-tenants) doesn't race with
# the bridge coming up. Do not order this oneshot against network-pre.target
# or faas-cp.slice: Debian's nftables unit is itself Before=network-pre.target
# and the slices are pulled from basic.target, which creates a boot cycle.
After=local-fs.target
Before=nftables.service vmmd.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The bridge and address may already exist after the Ansible role's runtime
# tasks, a reboot, or a repeated bootstrap. Keep the whole oneshot idempotent
# while still propagating genuine failures from the create/add operations.
ExecStart=/bin/sh -ec '/usr/sbin/ip link show br-tenants >/dev/null 2>&1 || /usr/sbin/ip link add br-tenants type bridge; /usr/sbin/ip addr show dev br-tenants | /usr/bin/grep -q "inet 10.100.0.1/16" || /usr/sbin/ip addr add 10.100.0.1/16 dev br-tenants; /usr/sbin/ip link set br-tenants up'
# Do NOT add a [Restart] section: a per-ExecStart failure here indicates a
# genuinely broken network stack (e.g. the iproute2 module isn't loaded)
# and should NOT silently retry; the operator must triage.

[Install]
WantedBy=nftables.service
WantedBy=multi-user.target
