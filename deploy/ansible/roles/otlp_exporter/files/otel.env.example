# Optional OpenTelemetry export configuration for faas daemons.
#
# Copy this file to /etc/faas/otel.env, replace the values, then restart the
# instrumented faas services. The production file must be root:root 0400;
# systemd reads it before dropping privileges to the daemon user.
#
# OTLP/HTTP is sent to the collector. The generic endpoint is shared by
# traces and metrics; set the metrics endpoint separately when required.
# Native backends such as Datadog, Tempo, and Loki belong behind an
# OpenTelemetry Collector, keeping the faas daemons vendor-neutral.
#
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.example:4318
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://otel-collector.example:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://otel-collector.example:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20REPLACE_ME
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,faas.node.name=REPLACE_ME
# OTEL_TRACES_SAMPLER_ARG=0.10
# OTEL_METRIC_EXPORT_INTERVAL=60000
#
# For private PKI, point the exporters at a PEM CA bundle. The trace exporter
# also supports the standard OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE and
# OTEL_EXPORTER_OTLP_CLIENT_KEY variables for mTLS. Keep these paths on the
# host and do not inline certificate or key contents in this file.
# OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/faas/secrets/otel/ca.crt
# OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/etc/faas/secrets/otel/client.crt
# OTEL_EXPORTER_OTLP_CLIENT_KEY=/etc/faas/secrets/otel/client.key
