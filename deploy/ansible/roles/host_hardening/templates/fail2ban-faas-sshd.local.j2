# {{ ansible_managed }} — host_hardening role (spec §11, ADR-143).
[sshd]
enabled = true
mode = aggressive
backend = systemd
ignoreip = {{ (faas_hardening_fail2ban_ignoreip + (overlay_cidrs | default([])) + (faas_control_plane_allowed_cidrs | default([]))) | unique | join(' ') }}
bantime = {{ faas_hardening_fail2ban_bantime }}
findtime = {{ faas_hardening_fail2ban_findtime }}
maxretry = {{ faas_hardening_fail2ban_maxretry }}
