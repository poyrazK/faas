# Managed by the neond_service role (ADR-20261112160000). The Neon admin key
# is a credential: systemd reads the root-only file and hands it to faas-neond
# alone, so no other daemon user can read it.
[Service]
LoadCredential=neon_admin_key:/etc/faas/secrets/neon-admin.key
Environment=FAAS_NEOND_ADMIN_KEY_FILE=%d/neon_admin_key
Environment=FAAS_NEOND_LISTEN=unix:///run/faas/neond.sock
# apid is the only caller; neond closes any other peer by SO_PEERCRED.
Environment=FAAS_NEOND_CALLERS=faas-apid
Environment=FAAS_NEOND_DESTRUCTIVE_PER_HOUR={{ faas_neond_destructive_per_hour }}
Environment=FAAS_NEOND_ROLE={{ faas_box_role | default('single-box') }}
{% if faas_neond_project_keys | bool %}
# Project keys: sealed to neond's own identity, stored in neon_project_keys.
LoadCredential=neond_seal:/etc/faas/secrets/neond-seal.age
Environment=FAAS_NEOND_SEAL_IDENTITY_FILE=%d/neond_seal
Environment=FAAS_NEOND_ORG_ID={{ faas_neond_org_id }}
{% endif %}
# neond logs in only as faas_neond (pg_ident: faas-neond -> faas_neond), which
# reads managed_postgres_databases and nothing else.
Environment=FAAS_DB_ROLE=faas_neond
