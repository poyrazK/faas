# Managed by Ansible: G19.3 / ADR-127 Layer 12.
# Do not edit on the host; change the acceptance inventory instead.
FAAS_API={{ mha_api_base | quote }}
FAAS_TOKEN={{ mha_api_token | quote }}
FAAS_H2C_ACCEPTANCE_TIMEOUT_SECONDS={{ mha_acceptance_timeout_seconds | quote }}
FAAS_H2C_FRAMING_ASSERT_COMMAND={{ mha_framing_assert_command | quote }}
FAAS_H2C_SURGICAL_ROLLBACK_COMMAND={{ mha_surgical_rollback_command | quote }}
FAAS_H2C_SURGICAL_RESTORE_COMMAND={{ mha_surgical_restore_command | quote }}
FAAS_H2C_WHOLESALE_ROLLBACK_COMMAND={{ mha_wholesale_rollback_command | quote }}
FAAS_H2C_WHOLESALE_RESTORE_COMMAND={{ mha_wholesale_restore_command | quote }}

{% for app in mha_fixture_apps %}
{% set key = app.id | upper | replace('-', '_') %}
FAAS_H2C_FIXTURE_{{ key }}_SLUG={{ app.slug | quote }}
FAAS_H2C_FIXTURE_{{ key }}_PROTOCOL={{ app.app_protocol | quote }}
FAAS_H2C_FIXTURE_{{ key }}_EXPECTED_FRAMING={{ app.expected_framing | quote }}
FAAS_H2C_FIXTURE_{{ key }}_PROBE={{ app.probe | quote }}
FAAS_H2C_FIXTURE_{{ key }}_URL={{ (app.url | default('http://' ~ app.slug ~ '.gregale.dev', true)) | quote }}
FAAS_H2C_FIXTURE_{{ key }}_PATH={{ (app.path | default('/', true)) | quote }}
FAAS_H2C_FIXTURE_{{ key }}_GRPC_TARGET={{ (app.grpc_target | default(app.slug ~ '.gregale.dev:443', true)) | quote }}
FAAS_H2C_FIXTURE_{{ key }}_GRPC_METHOD={{ (app.grpc_method | default('', true)) | quote }}
FAAS_H2C_FIXTURE_{{ key }}_GRPC_PAYLOAD={{ (app.grpc_payload | default('{}', true)) | quote }}
{% endfor %}
