[Unit]
Description=Gregale S3 gateway on a compute node (ADR-20261031122757)
Documentation=https://gregale.dev/docs/object-storage
After=network-online.target faas-cp.slice faas-gatewayd-internal.service
Wants=faas-cp.slice
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/s3-gatewayd
Restart=on-failure
RestartSec=2s
WatchdogSec=60s
Slice=faas-cp.slice
MemoryMax=512M
EnvironmentFile=-/etc/faas/compute-db.env
EnvironmentFile=-/etc/faas/secrets/object-storage/gateway-provider.env
EnvironmentFile=-/etc/faas/otel.env
Environment=FAAS_OBJECT_STORAGE_CONFIG=/etc/faas/object-storage.json
Environment=FAAS_S3_GATEWAY_LISTEN_ADDR=127.0.0.1:8084
Environment=FAAS_S3_GATEWAY_CONTROL_ADDR=127.0.0.1:9096
Environment=FAAS_S3_GATEWAY_SPOOL_DIR=/var/spool/faas/s3-gatewayd
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/var/spool/faas/s3-gatewayd

[Install]
WantedBy=multi-user.target
