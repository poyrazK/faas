# Managed by vmmd_service (ADR-20261110210000 slice 3i): vmmd opens sealed
# edge-rule request header values, which gateways name by reference, through
# the control plane's secretd with this node's identity leaf, for instances
# this node runs. Gateways send such references only once
# faas_gateway_edge_header_secrets is inject.
[Service]
Environment=FAAS_VMMD_EDGE_HEADER_SECRETS=secretd
Environment=FAAS_SECRETD_TARGET={{ faas_secretd_target }}
Environment=FAAS_SECRETD_TLS_CERT_PATH=/etc/faas/tls/secretd-client/vmmd.crt
Environment=FAAS_SECRETD_TLS_KEY_PATH=/etc/faas/tls/secretd-client/vmmd.key
Environment=FAAS_SECRETD_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
