[Service]
{% if faas_gatewayd_app_errors_target | default('') | length > 0 %}
# Split-box guest trace exports (ADR-958). vmmd forwards in-guest OTLP
# exports to apid's private mTLS listener — the same SpansWriter endpoint
# gatewayd-internal uses — authenticated by vmmd's node-identity apid-client
# leaf (CN = compute_nodes.name). The receiver is on by default; set
# FAAS_GUEST_TRACING_ENABLED=0 in /etc/faas/otel.env to turn it off.
Environment=FAAS_VMMD_SPANS_WRITER_TARGET={{ faas_gatewayd_app_errors_target }}
Environment=FAAS_VMMD_APID_CLIENT_TLS_CERT_PATH={{ vmmd_apid_client_tls_cert_path }}
Environment=FAAS_VMMD_APID_CLIENT_TLS_KEY_PATH={{ vmmd_apid_client_tls_key_path }}
Environment=FAAS_VMMD_APID_CLIENT_TLS_CA_PATH={{ vmmd_apid_client_tls_ca_path }}
{% else %}
# Single-box: vmmd forwards guest trace exports to apid's local SpansWriter
# Unix socket; no environment is required.
{% endif %}
