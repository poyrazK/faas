[Service]
# Multi-box routing is deployment-owned. Keep the listen/bind address
# separate from the routable target schedd and gatewayd dial. Empty values
# preserve the single-box unix-socket path.
Environment=FAAS_VMMD_LISTEN_ADDR={{ faas_vmmd_listen_addr | default('') }}
Environment=FAAS_VMMD_TARGET_URL={{ faas_vmmd_target_url | default('') }}
{% if faas_database_route_enabled | default(false) | bool %}
# ADR-1027: the app route to managed databases (with the nftables role's
# faas_database_route_enabled and gatewayd-internal's database_route_*).
Environment=FAAS_VMMD_DATABASE_ROUTE_ENABLED=true
{% endif %}
{% if faas_service_tcp_enabled | default(false) | bool %}
# ADR-576: private TCP service addressing (with the nftables role's
# faas_service_tcp_enabled and gatewayd-internal's service_tcp_*).
Environment=FAAS_SERVICE_TCP_ENABLED=true
{% endif %}
{% if faas_vmmd_internal_egress_cidrs | default([]) | length > 0 %}
# ADR-20261114100000 amendment 2026-11-23: public destinations that are
# Gregale's own; guest traffic to them is internal, not billed egress.
Environment=FAAS_VMMD_INTERNAL_EGRESS_CIDRS={{ faas_vmmd_internal_egress_cidrs | join(',') }}
{% endif %}
{% if faas_vmmd_internal_egress_hosts | default([]) | length > 0 %}
# Hostnames vmmd re-resolves every 5 minutes into the same internal set.
Environment=FAAS_VMMD_INTERNAL_EGRESS_HOSTS={{ faas_vmmd_internal_egress_hosts | join(',') }}
{% endif %}
