[Service]
# Keep vmmd's wake-time nftables renderer on the same provider-specific
# interface and tenant bridge range as the boot policy rendered by Ansible.
Environment="FAAS_PUBLIC_IFACE={{ public_iface | default(ansible_default_ipv4.interface | default('eth0'), true) }}"
Environment="FAAS_HOST_BRIDGE_CIDR={{ masquerade_cidr | default('10.100.0.0/16', true) }}"
# vmmd replaces the whole ruleset on every rebuild, so its private ports must
# be every port the boot policy (nftables role) opens to the control plane:
# the app edge's control listener and connector metrics (ADR-1343 §5) and
# Promtail's metrics (ADR-20261023124955) as well as the fixed list.
{% set faas_private_ingress_ports = faas_control_plane_allowed_ports | default([]) | list %}
{% if (faas_edge_on_compute_nodes | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
{% set faas_private_ingress_ports = faas_private_ingress_ports + [faas_edge_connector_metrics_port | default(20241), faas_edge_control_port | default(9109)] %}
{% endif %}
{% if (faas_obs_logs_enabled | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
{% set faas_private_ingress_ports = faas_private_ingress_ports + [9080] %}
{% endif %}
Environment="FAAS_PRIVATE_INGRESS_CIDRS={{ faas_control_plane_allowed_cidrs | default([]) | join(',') }}"
Environment="FAAS_PRIVATE_INGRESS_TCP_PORTS={{ faas_private_ingress_ports | join(',') }}"
{#- ADR-20261110120000: the same exact sources as the boot policy. A vmmd
    that predates these variables keeps FAAS_PRIVATE_INGRESS_CIDRS above.
    Keep faas_exact_cidrs identical to the nftables role's copy. -#}
{% macro faas_exact_cidrs(exact, fallback) -%}
{%- set ns = namespace(out=[], ok=(exact is mapping)) -%}
{%- if ns.ok -%}
{%- set ns.out = exact.cidrs | default([]) | list -%}
{%- for h in exact.hosts | default([]) -%}
{%- set hv = hostvars[h] if (hostvars is defined and h in hostvars) else {} -%}
{%- set addr = (hv.faas_private_dns_address | default(hv.faas_private_address | default(((hv.ansible_facts | default({})).default_ipv4 | default({})).address | default(''), true), true)) | string -%}
{%- if addr.split('.') | length == 4 and addr.replace('.', '').isdigit() -%}
{%- set ns.out = ns.out + [addr ~ '/32'] -%}
{%- else -%}
{%- set ns.ok = false -%}
{%- endif -%}
{%- endfor -%}
{%- endif -%}
{{- (ns.out | unique | join(',')) if ns.ok else (fallback | default([]) | join(',')) -}}
{%- endmacro %}
{% if faas_control_plane_allowed_exact is defined and faas_control_plane_allowed_cidrs | default([]) %}
Environment="FAAS_PRIVATE_CONTROL_INGRESS_CIDRS={{ faas_exact_cidrs(faas_control_plane_allowed_exact, faas_control_plane_allowed_cidrs) | trim }}"
{% endif %}
{% set faas_peer_ingress_cidrs = (faas_exact_cidrs(faas_compute_peer_exact, faas_control_plane_allowed_cidrs | default([])) | trim) if faas_compute_peer_exact is defined else '' %}
{% if faas_peer_ingress_cidrs %}
Environment="FAAS_PRIVATE_PEER_INGRESS_CIDRS={{ faas_peer_ingress_cidrs }}"
Environment="FAAS_PRIVATE_PEER_INGRESS_TCP_PORTS={{ faas_compute_peer_ports | default([50051, 9091]) | join(',') }}"
{% endif %}
{% if faas_public_entry_addrs | default([]) %}
# ADR-20261103163954: no proxy in front; keep 443 open to every source on the
# entry addresses only across runtime rebuilds, as the boot policy does. vmmd
# puts these ahead of the Cloudflare ranges below, which stay for a vmmd that
# predates them: it keeps the node Cloudflare-only instead of open.
Environment="FAAS_PUBLIC_ENTRY_ADDRS={{ faas_public_entry_addrs | join(',') }}"
{% endif %}
{% if (faas_cloudflare_origin_only | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
# ADR-20261102081618: keep 80/443 Cloudflare-only across runtime rebuilds, as
# the boot policy does; the nftables role loaded the pinned ranges.
Environment="FAAS_PUBLIC_INGRESS_CIDRS={{ ((faas_cloudflare_ipv4_cidrs | default([])) + (faas_cloudflare_ipv6_cidrs | default([]))) | join(',') }}"
{% endif %}
{% if faas_tenant_egress_iface | default('') %}
# ADR-372: wake-time host policy routes tenant egress through the gateway tunnel.
Environment="FAAS_TENANT_EGRESS_IFACE={{ faas_tenant_egress_iface }}"
{% endif %}
