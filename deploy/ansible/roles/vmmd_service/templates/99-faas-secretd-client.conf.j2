# Managed by vmmd_service (ADR-20261110210000 §3 slice 3c): vmmd opens app
# secrets (wake env, sidecar app secrets, live reload) through the control
# plane's secretd with this node's identity leaf. Sidecar direct env and
# sealed capture keys still open with this node's runtime identity.
[Service]
Environment=FAAS_RUNTIME_SECRET_OPENER=secretd
Environment=FAAS_SECRETD_TARGET={{ faas_vmmd_secretd_target }}
Environment=FAAS_SECRETD_TLS_CERT_PATH=/etc/faas/tls/secretd-client/vmmd.crt
Environment=FAAS_SECRETD_TLS_KEY_PATH=/etc/faas/tls/secretd-client/vmmd.key
Environment=FAAS_SECRETD_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
