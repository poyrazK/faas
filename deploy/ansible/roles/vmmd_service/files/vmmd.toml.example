# Example vmmd config — copy to /etc/faas/vmmd.toml on the box.
# Every field is optional; defaults are filled in by LoadConfig (see
# cmd/vmmd/config.go). Defaults are noted next to each field.

# socket_path: unix-domain socket path. Mode 0660, group 'faas' (ADR-015).
# Default: /run/faas/vmmd.sock
# socket_path = "/run/faas/vmmd.sock"

# metrics_addr: bind address for the Prometheus /metrics and /readyz endpoints.
# Strict fleet verification expects the production loopback endpoint below;
# leave this empty only for a metrics-disabled local development daemon.
# Default: "" (no metrics endpoint)
# metrics_addr = "127.0.0.1:9104"

# owner_user: the unix user that owns the unix-domain socket file. Members
# of the 'faas' group can dial the socket. Default: faas-vmmd
# owner_user = "faas-vmmd"

# kernel_path: path to the Firecracker-compatible kernel image. The daemon
# refuses to start if this file does not exist. Default: /srv/fc/base/vmlinux-6.1
# kernel_path = "/srv/fc/base/vmlinux-6.1"

# --- Issue #95 / ADR-025: location-transparent gRPC transport ---
# vmmd can serve over TCP for the decoupled compute layout (vmmd on a
# dedicated KVM host, control plane elsewhere). All five spec invariants
# and §11 ship-blockers are unchanged.

# listen_addr: gRPC listen target. Empty (default) keeps the legacy
# unix://+socket_path behavior. Set to "tcp://0.0.0.0:50051" only when
# the control plane and vmmd live on different hosts. A tcp target
# requires all three tls_*_path fields to be set or startup fails closed.
# Default: "" (unix socket)
# listen_addr = "tcp://0.0.0.0:50051"

# tls_cert_path / tls_key_path / tls_ca_path: server-mTLS cluster.
# All three empty => no TLS (single-box loopback UNIX path). All three
# set => RequireAndVerifyClientCert over TLS 1.3 with ALPN h2.
# Partial cluster => startup error naming the missing fields.
# Defaults: ""
# tls_cert_path = "/etc/faas/tls/vmmd.crt"
# tls_key_path = "/etc/faas/tls/vmmd.key"
# tls_ca_path = "/etc/faas/tls/ca.pem"

# schedd_client_cert_path / schedd_client_key_path / schedd_client_ca_path:
# client mTLS material vmmd uses to dial schedd for ReportCapacity
# (ADR-052 / issue #95 slice 2). All three empty => no TLS (single-box
# unix socket). All three set => mTLS-over-TCP to a remote schedd;
# the leaf is /etc/faas/tls/vmmd/schedd-client.{crt,key} (EKU
# ClientAuth only). Partial cluster => startup error.
# Defaults: ""
# schedd_client_cert_path = "/etc/faas/tls/vmmd/schedd-client.crt"
# schedd_client_key_path = "/etc/faas/tls/vmmd/schedd-client.key"
# schedd_client_ca_path = "/etc/faas/tls/ca/ca.crt"

# advisory_client_cert_path / advisory_client_key_path / advisory_client_ca_path:
# client mTLS material vmmd uses to dial apid's advisory listener
# (ADR-052). Leaf is /etc/faas/tls/vmmd/apid-client.{crt,key}. Same
# partial-cluster contract as schedd_client_*.
# Defaults: ""
# advisory_client_cert_path = "/etc/faas/tls/vmmd/apid-client.crt"
# advisory_client_key_path = "/etc/faas/tls/vmmd/apid-client.key"
# advisory_client_ca_path = "/etc/faas/tls/ca/ca.crt"

# --- PR scale-out tier-1 residual (PR #937 / Gaps #3 + #5) ---
# Per-host [compute_node] overrides for the multi-host layout.
# The slot allocator (pkg/fcvm.SetHostIPBase) carves per-VM /30
# leases from host_bridge_cidr's .2+ range; the bridge IP is the
# .1 (reserved). host_bridge_cidr MUST be a /16 (the only prefix
# length that maps cleanly to per-VM /30 leases) and MUST NOT
# fall inside the §11 RFC1918 deny catalog. overlay_cidr is the
# subnet the overlay detector prefers when multiple IPv4
# candidates come back from `tailscale ip -4`. overlay_interface
# is the optional NIC pin (Gap #5) — operators with multiple
# NICs (LAN + tail/wg) on one host set this to disambiguate.
# Empty values fall back to the per-host defaults
# (api.DefaultHostBridgeCIDR / api.DefaultOverlayCIDR /
# auto-detect). Single-box dev leaves the entire [compute_node]
# block commented out — the slot allocator carves from
# 10.100.0.0/16 by default.
#
# [compute_node]
# host_bridge_cidr = "10.100.0.0/16"   # per-host bridge /16 (.1 reserved)
# overlay_cidr = "100.64.0.0/10"       # overlay subnet the detector prefers
# overlay_interface = "tailscale0"     # optional NIC pin (Gap #5)
