[Unit]
Description=onebox-faas vmmd — microVM supervisor (the only root component, spec §4.4)
Documentation=https://docs.gregale.dev/ops/vmmd
After=faas-tenant.slice faas-cp.slice faas-cp-build.slice faas-tenant-free.slice faas-tenant-hobby.slice faas-tenant-pro.slice faas-tenant-scale.slice
Wants=faas-tenant.slice faas-cp.slice faas-cp-build.slice faas-tenant-free.slice faas-tenant-hobby.slice faas-tenant-pro.slice faas-tenant-scale.slice

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -o root -g faas -m 0775 /run/faas
ExecStartPre=/usr/bin/chmod 0775 /run/faas
ExecStart=/opt/faas/current/bin/vmmd --config /etc/faas/vmmd.toml
ExecStartPost=/usr/bin/chown root:faas /run/faas
ExecStartPost=/usr/bin/chmod 0775 /run/faas
Environment=TMPDIR=/srv/fc/base
# Issue #585 / ADR-127 — sealed.env is apid-only; vmmd keeps compute-db.env
# (DATABASE_URL) but no longer inherits the full sealed.env.
EnvironmentFile=-/etc/faas/compute-db.env
Restart=on-failure
RestartSec=2s

Slice=faas-cp.slice
Delegate=yes

AmbientCapabilities=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/faas/secrets /run/faas /run/netns /srv/fc /var/log/faas /var/lib/faas/cache
# RuntimeDirectory=faas (not ReadWritePaths alone) makes /run/faas a
# real directory on the host /run tmpfs, bind-mounted into this unit's
# mount namespace and propagated back. With PrivateTmp=yes the dirent
# would be created inside vmmd's per-mount-namespace tmpfs instance
# and NOT visible from the host — every other daemon that dials
# /run/faas/vmmd.sock would get `no such file or directory` even though
# `ss -lnx` shows the LISTEN entry (run 30839233808).
#
# This unit is the SOLE owner of /run/faas on disk. schedd and
# gatewayd-internal does NOT declare RuntimeDirectory=faas — when systemd sees
# /run/faas is deliberately host-shared. A per-unit RuntimeDirectory
# would create a private bind-mount that can hide or remove schedd and
# gatewayd sockets during a vmmd restart (run 30841750214, post-#619).
# tmpfiles.d and the install/chown fixups above own its lifecycle.
#
# /run/faas ownership is host-shared and is provisioned by tmpfiles.d;
# the install/chown fixups above reassert root:faas 0775 at activation.
# This is the activation-time fixup; on a fresh box it runs BEFORE
# schedd or gatewayd-internal (which sit in the `faas` group) get a
# chance to bind() their .sock into /run/faas. Without it the
# "bind: permission denied" cycle returns (run 31121004495, post
# PR #633 deploy 2026-08-04). Defense-in-depth: the
# compute_only_service role also (a) chowns /run/faas at deploy
# time and (b) ships a tmpfiles.d rule so the canonical ownership
# survives every reboot. The ExecStartPre covers the case where
# someone wipes /run between reboots without the tmpfiles-d firing.
PrivateTmp=no
ProtectHome=yes
ProtectKernelModules=yes

[Install]
WantedBy=multi-user.target
