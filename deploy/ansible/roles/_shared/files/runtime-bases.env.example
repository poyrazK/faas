# Runtime base contract for named production nodes.
#
# Populate every value from the signed image-release manifest before enabling
# builderd or imaged. Each ref must be the architecture-specific OCI digest
# for the matching runtime; tags and a single global FAAS_DEPLOY_BASE_REF are
# deliberately rejected by the daemons. Keep this file identical on every
# compute node so builderd and imaged subtract the same base layer chain.

FAAS_DEPLOY_BASE_REF_MINIMAL=
FAAS_DEPLOY_BASE_REF_NODE22=
FAAS_DEPLOY_BASE_REF_PYTHON312=
FAAS_DEPLOY_BASE_REF_GO124=
FAAS_DEPLOY_BASE_REF_GO124_ALPINE=
FAAS_DEPLOY_BASE_REF_NODE24=
FAAS_DEPLOY_BASE_REF_PYTHON313=
