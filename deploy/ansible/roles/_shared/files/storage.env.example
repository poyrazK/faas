# Shared runtime storage configuration for every storage consumer:
# schedd, vmmd, imaged, and builderd.
#
# Copy to /etc/faas/storage.env with mode 0440 and owner root:faas. Keep this
# file identical on every box in the fleet. Credentials must come from the
# operator's secret store; never commit the populated file or put it in
# inventory. A remote backend (GCS in GCP, OCI elsewhere) is the multi-box
# contract. GCS uses the attached VM service account through ADC; never add a
# downloaded service-account key to this file.

FAAS_STORAGE_BACKEND=gcs
FAAS_STORAGE_LOCAL_PREFIXES=none
FAAS_REQUIRE_SHARED_ARTIFACTS=1
FAAS_STORAGE_CACHE_SERVE_STALE=0
FAAS_GCS_BUCKET=gregale-artifacts-__PROJECT_SUFFIX__

# During the GCP migration, keep OCI as a read fallback for deployments whose
# immutable artifacts predate the cutover. New writes go only to GCS. Remove
# these OCI settings after the rollback-retention window has elapsed.
FAAS_STORAGE_FALLBACK_BACKEND=oci
FAAS_OCI_REGISTRY=https://ghcr.io/your-org
FAAS_OCI_REPO_PREFIX=faas
FAAS_OCI_USERNAME=__SET_FROM_SECRET_STORE__
FAAS_OCI_PASSWORD=__SET_FROM_SECRET_STORE__
FAAS_OCI_TIMEOUT_SECONDS=60
FAAS_STORAGE_SNAPSHOT_COMPRESSION=none
# ADR-1135: "1" writes GCS drives, rootfs images and snapshot memory as data
# extents only, so a node-cache miss skips the padding. Enable after every node
# that reads the bucket runs a reader-compatible release.
FAAS_STORAGE_SPARSE_EXTENTS=0

# Set snapshot compression to zstd only after every compute node runs a
# reader-compatible release. Roll readers out first, then enable writers
# fleet-wide. Origin and replica caches remain uncompressed sparse files.

# Keep snapshots in the shared store. Do not add snap/ here: doing so
# opts into legacy host-local snapshots and disables cross-box availability.
# FAAS_STORAGE_LOCAL_PREFIXES=base/,kernel/,layers/,scans/

# Read-through cache controls. The remote default is /var/lib/faas/cache; do not
# set FAAS_STORAGE_CACHE_DIR to an empty value on a multi-box deployment.
# FAAS_STORAGE_CACHE_DIR=/var/lib/faas/cache
# Size the cache budget from the disk that holds the cache, not from RAM: a
# snapshot evicted from a node's cache turns that node's next wake into a
# remote fetch. Half of that filesystem leaves room for builder drives; the
# cache also evicts while the filesystem has under 8 GiB free
# (api.ArtifactCacheMinFreeBytes). Unset, the budget is half of host RAM.
# FAAS_STORAGE_CACHE_MAX_BYTES=8589934592
# FAAS_STORAGE_CACHE_SERVE_STALE=true
