{#- Managed by the credential ring tasks (ADR 20261029202403 amendment 1).
    The variable names are spelled out so the environment contract finds
    each one. -#}
{% set names = {
  'scheduler': ['FAAS_CREDENTIAL_SCHEDULER_KEYS_FILE', 'FAAS_CREDENTIAL_SCHEDULER_WRITES', 'FAAS_CREDENTIAL_SCHEDULER_PLAIN_LOOKUP'],
  'outbound': ['FAAS_CREDENTIAL_OUTBOUND_KEYS_FILE', 'FAAS_CREDENTIAL_OUTBOUND_WRITES', 'FAAS_CREDENTIAL_OUTBOUND_PLAIN_LOOKUP'],
  'uploads': ['FAAS_CREDENTIAL_UPLOADS_KEYS_FILE', 'FAAS_CREDENTIAL_UPLOADS_WRITES', 'FAAS_CREDENTIAL_UPLOADS_PLAIN_LOOKUP'],
  'attach': ['FAAS_CREDENTIAL_ATTACH_KEYS_FILE', 'FAAS_CREDENTIAL_ATTACH_WRITES', 'FAAS_CREDENTIAL_ATTACH_PLAIN_LOOKUP'],
  'dev-bridge': ['FAAS_CREDENTIAL_DEV_BRIDGE_KEYS_FILE', 'FAAS_CREDENTIAL_DEV_BRIDGE_WRITES', 'FAAS_CREDENTIAL_DEV_BRIDGE_PLAIN_LOOKUP'],
  'data-api': ['FAAS_CREDENTIAL_DATA_API_KEYS_FILE', 'FAAS_CREDENTIAL_DATA_API_WRITES', 'FAAS_CREDENTIAL_DATA_API_PLAIN_LOOKUP'],
} -%}
{% set env = names[credential_family] -%}
{% set credential = 'faas_credential_' ~ (credential_family | replace('-', '_')) -%}
# Managed by Ansible (ADR 20261029202403 amendment 1): the {{ credential_family }}
# credential ring, keyed digests of the tokens this daemon issues or checks.
[Service]
{% if credential_ring_src | length > 0 %}
LoadCredential={{ credential }}:/etc/faas/secrets/credential-keys-{{ credential_family }}
Environment={{ env[0] }}=%d/{{ credential }}
{% endif %}
Environment={{ env[1] }}={{ credential_ring_writes }}
Environment={{ env[2] }}={{ credential_ring_plain_lookup | bool | lower }}
