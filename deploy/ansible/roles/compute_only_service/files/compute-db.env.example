# Root-owned runtime credentials for compute-only daemons.
# Copy to /etc/faas/compute-db.env, set mode 0600, and provision the
# values from the operator's secret store. Keep the full DSN quoted so
# systemd's EnvironmentFile parser does not reinterpret credential bytes.
DATABASE_URL='postgres://faas:<password>@<control-plane-address>:5432/faas?sslmode=disable'
FAAS_VMMD_DBURL='postgres://faas:<password>@<control-plane-address>:5432/faas?sslmode=disable'

# Shared artifact policy and OCI credentials belong in the separate
# /etc/faas/storage.env file. Every compute daemon loads both files; keeping
# the database credentials separate avoids duplicating registry secrets.
