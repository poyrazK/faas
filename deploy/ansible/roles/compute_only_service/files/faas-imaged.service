[Unit]
Description=onebox-faas imaged — image/snapshot orchestrator (spec §4.6, ADR-003, ADR-005)
Documentation=https://docs.gregale.dev/ops/imaged
After=network.target faas-cp.slice faas-vmmd.service
Wants=faas-cp.slice faas-vmmd.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=faas-imaged
Group=faas
ExecStart=/opt/faas/current/bin/imaged --config /etc/faas/imaged.toml
Restart=on-failure
RestartSec=2s
RestartCountExport=SYSTEMD_RESTARTS_ON_FAILURE
Slice=faas-cp.slice
MemoryMax=4G
CapabilityBoundingSet=cap_chown cap_dac_override cap_fowner cap_fsetid cap_kill cap_setgid cap_setuid cap_setpcap cap_net_bind_service cap_sys_chroot
EnvironmentFile=-/etc/faas/compute-db.env
EnvironmentFile=-/etc/faas/storage.env
EnvironmentFile=-/etc/faas/runtime-bases.env
Environment=TMPDIR=/srv/fc/base
Environment=FAAS_BASE_STAGING_ROOT=/dev/shm/faas-base-staging
Environment=FAAS_BASE_EXTRACT_ROOT=/srv/fc/base-staging
Environment=FAAS_BASE_TMP_ROOT=/srv/fc/base
Environment=FAAS_HOST_AGE_IDENTITY_PATH=%d/faas_host_age_identity
Environment=FAAS_FUNCTION_RUNNER_NODE22=/opt/faas/current/bin/runners/node22/faas-runner
Environment=FAAS_FUNCTION_RUNNER_NODE24=/opt/faas/current/bin/runners/node24/faas-runner
Environment=FAAS_FUNCTION_RUNNER_PYTHON312=/opt/faas/current/bin/runners/python312/faas-runner
Environment=FAAS_FUNCTION_RUNNER_PYTHON313=/opt/faas/current/bin/runners/python313/faas-runner
Environment=FAAS_FUNCTION_RUNNER_GO124=/opt/faas/current/bin/runners/go124/faas-runner
Environment=FAAS_FUNCTION_RUNNER_GO124_ALPINE=/opt/faas/current/bin/runners/go124-alpine/faas-runner
LoadCredential=faas_host_age_identity:/etc/faas/secrets/host.age
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/srv/fc/snap /srv/fc/base /srv/fc/base-staging /srv/fc/scans /srv/fc/sigs /var/log/faas /var/spool/faas /var/lib/faas/cache /var/lib/faas/grype /var/cache/faas/builds/.leases /dev/shm/faas-base-staging

[Install]
WantedBy=multi-user.target
