# Managed by compute_only_service (ADR-20261110210000 §3 slice 3c-2): this
# node's schedd, the owner of the apps it wakes, grants a peer an app's
# secrets through the control plane's secretd before placing an instance
# there. It uses the node's secretd client leaf (issued by vmmd_service); the
# key is root-only, so systemd hands it to schedd as a credential.
[Service]
LoadCredential=secretd_client_key:/etc/faas/tls/secretd-client/vmmd.key
Environment=FAAS_SCHEDD_SECRETD_TARGET={{ faas_secretd_target }}
Environment=FAAS_SECRETD_TLS_CERT_PATH=/etc/faas/tls/secretd-client/vmmd.crt
Environment=FAAS_SECRETD_TLS_KEY_PATH=%d/secretd_client_key
Environment=FAAS_SECRETD_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
