[Service]
# Split-box imaged → vmmd mTLS is deployment-owned. Keep the dial target on
# this compute host's stable private endpoint so a fleet with multiple
# compute boxes cannot resolve a shared vmmd.faas alias to the wrong node.
# The vmmd server leaf keeps vmmd.faas as its role identity and also carries
# the endpoint SAN. The dedicated imaged client leaf is distinct from
# builderd's client leaf; both are issued by the same internal CA but
# represent different daemon roles.
Environment=FAAS_VMM_SOCK={{ faas_vmmd_target_url }}
Environment=FAAS_VMM_TLS_CERT_PATH=/etc/faas/tls/imaged/vmmd-client.crt
Environment=FAAS_VMM_TLS_KEY_PATH=/etc/faas/tls/imaged/vmmd-client.key
Environment=FAAS_VMM_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
# The source-ref freshness RPC terminates on githubd's control-plane mTLS
# listener. The service alias resolves through the manifest private-host map.
Environment=FAAS_GITHUBD_TARGET_URL={{ faas_githubd_target_url }}
Environment=FAAS_GITHUBD_TLS_CERT_PATH=/etc/faas/tls/imaged/githubd-client.crt
Environment=FAAS_GITHUBD_TLS_KEY_PATH=/etc/faas/tls/imaged/githubd-client.key
Environment=FAAS_GITHUBD_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
Environment=GRYPE_DB_CACHE_DIR=/var/lib/faas/grype
