# Managed by compute_only_service (ADR-20261110210000 slice 3j-2): this
# node's imaged pulls apps' private images through the control plane's
# secretd, which adds the registry credential; the node never opens a
# registry password. It uses the node's secretd client leaf (issued by
# vmmd_service); the key is root-only, so systemd hands it to imaged as a
# credential.
[Service]
LoadCredential=secretd_client_key:/etc/faas/tls/secretd-client/vmmd.key
Environment=FAAS_IMAGED_REGISTRY_PULLS=secretd
Environment=FAAS_SECRETD_TARGET={{ faas_secretd_target }}
Environment=FAAS_SECRETD_TLS_CERT_PATH=/etc/faas/tls/secretd-client/vmmd.crt
Environment=FAAS_SECRETD_TLS_KEY_PATH=%d/secretd_client_key
Environment=FAAS_SECRETD_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
