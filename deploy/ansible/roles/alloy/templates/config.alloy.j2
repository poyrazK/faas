// Generated by Ansible (roles/alloy, ADR-20261023185953). Promtail's pipeline
// (ADR-143, ADR-20261023124955 §2) translated stage for stage.

logging {
  level  = "info"
  format = "json"
}

// One journal reader for every listed unit: sd-journal ORs matches on the
// same field. format_as_json hands the entry to the pipeline as JSON so the
// first stage can unwrap MESSAGE, like Promtail's `json: true`.
loki.source.journal "faas" {
  max_age        = "{{ alloy_effective_max_age }}"
  format_as_json = true
  matches        = "{{ alloy_journal_units | map('regex_replace', '^', '_SYSTEMD_UNIT=') | join(' ') }}"
  relabel_rules  = loki.relabel.journal.rules
  labels         = {
    job         = "faas-journal",
    host        = "{{ alloy_host_label }}",
    environment = "{{ alloy_environment }}",
  }
  forward_to = [loki.process.faas.receiver]
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  // loki.source.journal sets job to its own component name; the dashboards,
  // alerts and gregalectl obs logs select job="faas-journal".
  rule {
    target_label = "job"
    replacement  = "faas-journal"
  }
}

// Only server-validated identity fields become labels; arbitrary customer
// attributes never do (ADR-143). level is slog's closed set; DEBUG stays in
// the local journal. request_id, wake_id and trace_id stay in the line. The
// stored line is the daemon's own JSON, not journald's envelope.
loki.process "faas" {
  forward_to = [loki.write.loki.receiver]

  stage.json {
    expressions = { message = "MESSAGE" }
  }

  stage.json {
    source      = "message"
    expressions = {
      account_id = "account_id",
      app_id     = "app_id",
      daemon     = "daemon",
      level      = "level",
    }
  }

  stage.drop {
    source              = "level"
    value               = "DEBUG"
    drop_counter_reason = "debug_level"
  }

  stage.labels {
    values = {
      account_id = "",
      app_id     = "",
      daemon     = "",
      level      = "",
    }
  }

  stage.output {
    source = "message"
  }
}

loki.write "loki" {
  endpoint {
{% if alloy_dev_mode | bool %}
    url                 = "{{ alloy_loki_url | default('http://127.0.0.1:3100/loki/api/v1/push', true) }}"
{% else %}
    url                 = "{{ alloy_loki_url }}"
{% endif %}
    tenant_id           = "{{ alloy_loki_tenant_id }}"
    batch_wait          = "{{ alloy_batch_wait }}"
    batch_size          = "{{ alloy_batch_size }}"
    min_backoff_period  = "{{ alloy_min_backoff }}"
    max_backoff_period  = "{{ alloy_max_backoff }}"
    max_backoff_retries = {{ alloy_max_retries }}
{% if not (alloy_dev_mode | bool) %}

    tls_config {
      ca_file     = "{{ alloy_loki_ca_file }}"
      cert_file   = "{{ alloy_loki_client_cert_file }}"
      key_file    = "{{ alloy_loki_client_key_file }}"
      server_name = "{{ alloy_loki_server_name }}"
      min_version = "TLS12"
    }
{% endif %}
  }
}
