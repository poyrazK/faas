# Managed by Ansible (pgproxyd_service). ADR-1027.
listen_addr = "{{ pgproxyd_listen_addr }}"
host_suffix = "{{ pgproxyd_host_suffix }}"
tls_cert_path = "/etc/faas/pgproxyd/tls.crt"
tls_key_path = "/etc/faas/pgproxyd/tls.key"
decoy_secret_path = "/etc/faas/pgproxyd/decoy"
db_url_path = "/etc/faas/pgproxyd/db-url"
schedd_target = "{{ pgproxyd_schedd_target }}"
schedd_client_cert_path = "/etc/faas/tls/pgproxyd/schedd-client.crt"
schedd_client_key_path = "/etc/faas/tls/pgproxyd/schedd-client.key"
schedd_client_ca_path = "/etc/faas/tls/ca/ca.crt"
vmmd_client_cert_path = "/etc/faas/tls/pgproxyd/vmmd-client.crt"
vmmd_client_key_path = "/etc/faas/tls/pgproxyd/vmmd-client.key"
vmmd_client_ca_path = "/etc/faas/tls/ca/ca.crt"
verifier_cache_ttl = "{{ pgproxyd_verifier_cache_ttl }}"
ops_addr = "{{ pgproxyd_ops_addr }}"
instance_id = {{ pgproxyd_instance_id | int }}
{% if pgproxyd_cancel_peers | length > 0 %}

[cancel_peers]
{% for id, addr in pgproxyd_cancel_peers | dictsort %}
"{{ id | int }}" = "{{ addr }}"
{% endfor %}
{% endif %}
