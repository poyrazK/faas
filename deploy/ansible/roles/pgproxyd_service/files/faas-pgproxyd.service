[Unit]
Description=Gregale PostgreSQL proxy for managed databases
Documentation=https://gregale.dev/docs/managed-postgres
After=network-online.target faas-vmmd.service
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
User=faas-pgproxyd
Group=faas-pgproxyd
ExecStart=/opt/faas/current/bin/pgproxyd -config /etc/faas/pgproxyd.toml
Restart=on-failure
RestartSec=2s
WatchdogSec=60s
MemoryHigh=768M
MemoryMax=1G
TasksMax=4096
CapabilityBoundingSet=
EnvironmentFile=-/etc/faas/otel.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas

[Install]
WantedBy=multi-user.target
