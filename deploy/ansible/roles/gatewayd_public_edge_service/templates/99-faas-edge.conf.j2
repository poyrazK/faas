# Managed by Ansible (gatewayd_public_edge_service). Local edits are overwritten.
# ADR-1343: the app hosts this edge serves, and the control-plane edge that
# receives its credential-bound routes (public object reads, uploads, OTLP).
[Service]
Environment=FAAS_APPS_DOMAIN={{ gatewayd_apps_domain | default('gregale.dev') }}
Environment=FAAS_PUBLIC_EDGE_CONTROL_PLANE_TARGET={{ faas_edge_control_plane_target }}
{% if (faas_edge_placement_routing | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
# ADR-20261031105055: route each app host to the node that last served it.
Environment=FAAS_EDGE_PLACEMENT_ROUTING=1
{% endif %}
{% if (faas_edge_placement_node_set | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
# ADR-20261102081618 §5b: spread each app host over every node it runs on.
Environment=FAAS_EDGE_PLACEMENT_NODE_SET=1
{% endif %}
{% if (faas_edge_client_limits | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
# ADR-20261103163954 §4: per-client-address limits.
Environment=FAAS_EDGE_CLIENT_LIMITS=1
{% if (faas_edge_overload | default('off') | string | lower) in ["observe", "on"] %}
# ADR-20261110123517: the node-wide overload level (observe or on).
Environment=FAAS_EDGE_OVERLOAD={{ faas_edge_overload | string | lower }}
{% endif %}
{% endif %}
{% if (faas_edge_entry | default('tunnel') | string | lower) == 'both' %}
{% set faas_edge_no_front = (faas_edge_public_front | default('cloudflare') | string | lower) == 'none' %}
# ADR-20261102081618: Cloudflare also connects to this edge directly. The edge
# binds the TLS port itself and reads its TLS material as credentials.
AmbientCapabilities=CAP_NET_BIND_SERVICE
LoadCredential=edge_tls_client_ca:{{ faas_edge_public_tls_client_ca }}
Environment=FAAS_EDGE_PUBLIC_TLS_ADDR=:{{ faas_edge_public_tls_port | default(443) }}
Environment=FAAS_EDGE_PUBLIC_TLS_CLIENT_CA_FILE=%d/edge_tls_client_ca
{% if (faas_edge_public_tls_cert_source | default('file')) == 'database' %}
# ADR-20261103163954 §3: the apps domains' certificate edgednsd stores. The
# edge opens its key with the edge-tls identity, which the seal_domains role
# hands it, and keeps it in memory only.
Environment=FAAS_EDGE_PUBLIC_TLS_CERT_SOURCE=database
Environment=FAAS_EDGE_PUBLIC_TLS_CERT_CA={{ faas_edge_public_tls_cert_ca | default('letsencrypt') }}
{% else %}
LoadCredential=edge_tls_cert:{{ faas_edge_public_tls_cert }}
LoadCredential=edge_tls_key:{{ faas_edge_public_tls_key }}
Environment=FAAS_EDGE_PUBLIC_TLS_CERT_FILE=%d/edge_tls_cert
Environment=FAAS_EDGE_PUBLIC_TLS_KEY_FILE=%d/edge_tls_key
{% endif %}
{% if faas_edge_no_front %}
# ADR-20261103163954: no proxy in front. Clients connect directly; the zone's
# client certificate is verified only when given, so a proxied record still
# works, and the certificate above is publicly trusted.
Environment=FAAS_EDGE_PUBLIC_FRONT=none
{% if (faas_cloudflare_origin_only | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
# ADR-20261103163954 §4: a host moved back behind Cloudflare, the flood
# fallback, arrives from Cloudflare's addresses; the per-address connection
# limits skip them.
Environment=FAAS_EDGE_PROXY_CIDRS={{ (faas_edge_cloudflare_ipv4_cidrs + faas_edge_cloudflare_ipv6_cidrs) | join(',') }}
{% endif %}
{% endif %}
{% endif %}
{% if (faas_internal_keepalive_per_node | default(false) | string | lower) in ["true", "yes", "on", "1"] %}
# Keep connections to each node's gatewayd-internal alive (manifest hot_path).
Environment=FAAS_INTERNAL_KEEPALIVE_PER_NODE=1
{% endif %}
