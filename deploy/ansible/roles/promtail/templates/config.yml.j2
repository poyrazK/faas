# Generated by Ansible. Promtail reads only the selected platform units.
server:
  http_listen_address: {{ promtail_effective_listen_address }}
  http_listen_port: {{ promtail_listen_port }}
  grpc_listen_port: 0

clients:
  - url: {{ promtail_loki_url | default('http://127.0.0.1:3100/loki/api/v1/push', true) }}
    tenant_id: {{ promtail_loki_tenant_id }}
    external_labels:
      environment: {{ promtail_environment }}
      host: {{ promtail_host_label }}
{% if not (promtail_dev_mode | bool) %}
    tls_config:
      ca_file: {{ promtail_loki_ca_file }}
      cert_file: {{ promtail_loki_client_cert_file }}
      key_file: {{ promtail_loki_client_key_file }}
      server_name: {{ promtail_loki_server_name }}
      insecure_skip_verify: false
{% endif %}
    batchwait: {{ promtail_batch_wait }}
    batchsize: {{ promtail_batch_size }}
    backoff_config:
      min_period: {{ promtail_min_backoff }}
      max_period: {{ promtail_max_backoff }}
      max_retries: {{ promtail_max_retries }}

positions:
  filename: {{ promtail_positions_file }}
  sync_period: 10s

scrape_configs:
  # One journal reader for every listed unit (ADR-20261023124955 §2). Matches
  # on the same field are ORed by sd-journal, so this reads the journal once
  # instead of once per unit, which matters on the 2-vCPU control plane.
  - job_name: faas-journal
    journal:
      max_age: {{ promtail_journal_max_age }}
      json: true
      matches: "{{ promtail_journal_units | map('regex_replace', '^', '_SYSTEMD_UNIT=') | join(' ') }}"
      labels:
        job: faas-journal
    relabel_configs:
      - source_labels: ['__journal__systemd_unit']
        target_label: unit
    # The first JSON stage unwraps journald's MESSAGE field. The second stage
    # extracts only server-validated identity fields from app_log records;
    # arbitrary user attributes never become Loki labels. level is slog's
    # closed set (DEBUG, INFO, WARN, ERROR); debug lines stay in the local
    # journal and are not shipped. request_id, wake_id and trace_id stay in
    # the line, never in labels.
    pipeline_stages:
      - json:
          expressions:
            message: MESSAGE
      - json:
          source: message
          expressions:
            account_id: account_id
            app_id: app_id
            daemon: daemon
            level: level
      - drop:
          source: level
          value: DEBUG
          drop_counter_reason: debug_level
      - labels:
          account_id:
          app_id:
          daemon:
          level:
      # Store the daemon's own line, not journald's JSON envelope around it:
      # host and unit are labels already, and the envelope roughly doubles
      # every line Loki stores. Lines without a MESSAGE keep the envelope.
      - output:
          source: message
