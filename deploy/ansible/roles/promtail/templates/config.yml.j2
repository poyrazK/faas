# Generated by Ansible. Promtail reads only the selected platform units.
server:
  http_listen_address: {{ promtail_effective_listen_address }}
  http_listen_port: {{ promtail_listen_port }}
  grpc_listen_port: 0

clients:
  - url: {{ promtail_loki_url | default('http://127.0.0.1:3100/loki/api/v1/push', true) }}
    tenant_id: {{ promtail_loki_tenant_id }}
    external_labels:
      environment: {{ promtail_environment }}
      host: {{ promtail_host_label }}
{% if not (promtail_dev_mode | bool) %}
    tls_config:
      ca_file: {{ promtail_loki_ca_file }}
      cert_file: {{ promtail_loki_client_cert_file }}
      key_file: {{ promtail_loki_client_key_file }}
      server_name: {{ promtail_loki_server_name }}
      insecure_skip_verify: false
{% endif %}
    batchwait: {{ promtail_batch_wait }}
    batchsize: {{ promtail_batch_size }}
    backoff_config:
      min_period: {{ promtail_min_backoff }}
      max_period: {{ promtail_max_backoff }}
      max_retries: {{ promtail_max_retries }}

positions:
  filename: {{ promtail_positions_file }}
  sync_period: 10s

scrape_configs:
{% for unit in promtail_journal_units %}
  - job_name: faas-journal-{{ loop.index }}
    journal:
      max_age: {{ promtail_journal_max_age }}
      json: true
      matches: _SYSTEMD_UNIT={{ unit }}
      labels:
        job: faas-journal
        unit: {{ unit }}
    # The first JSON stage unwraps journald's MESSAGE field. The second stage
    # extracts only server-validated identity fields from app_log records;
    # arbitrary user attributes never become Loki labels.
    pipeline_stages:
      - json:
          expressions:
            message: MESSAGE
      - json:
          source: message
          expressions:
            account_id: account_id
            app_id: app_id
            daemon: daemon
      - labels:
          account_id:
          app_id:
          daemon:
{% endfor %}
