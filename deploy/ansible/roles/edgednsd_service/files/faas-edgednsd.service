[Unit]
Description=Gregale edge DNS (edgednsd): sends Cloudflare to the ready compute edges
After=network-online.target postgresql.service faas-cp.slice
Wants=network-online.target faas-cp.slice
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/edgednsd
Restart=on-failure
RestartSec=2s
Slice=faas-cp.slice
MemoryMax=128M
EnvironmentFile=-/etc/faas/secrets/edgednsd/edgednsd.env
EnvironmentFile=-/etc/faas/otel.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas

[Install]
WantedBy=multi-user.target
