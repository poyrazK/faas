[Unit]
Description=Grafana for faas Prometheus
Documentation=https://github.com/poyrazK/faas
After=network-online.target prometheus.service
Wants=network-online.target

[Service]
User=grafana
Group=grafana
Type=simple
ExecStart=/usr/sbin/grafana-server \
    --homepath=/usr/share/grafana \
    --config=/etc/grafana/grafana.ini \
    cfg:default.server.http_addr={{ gv_listen_addr.split(':')[0] }} \
    cfg:default.server.http_port={{ gv_listen_addr.split(':')[1] }}
Restart=on-failure
RestartSec=10s
# ADR-20261023124955 §1: capped observability slice, below Prometheus and
# Alertmanager for CPU. production-us measured 106 MB RSS and a 181 MB peak
# on 2026-10-23; MemoryHigh throttles a heavy dashboard before MemoryMax.
Slice=faas-obs.slice
CPUWeight={{ gv_cpu_weight }}
MemoryHigh={{ gv_memory_high }}
MemoryMax={{ gv_memory_max }}

# Hardening (mirrors alertmanager.service + prometheus.service).
# Grafana runs unprivileged with the same lockdown as the rest of
# the §12 stack — no new privileges, kernel tunables locked down,
# namespaces restricted. ReadWritePaths covers the dirs Grafana
# mutates at runtime (data + logs + provisioning reload staging).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/grafana /var/log/grafana /etc/grafana
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
