# Datasource provisioning — Prometheus on the local management bridge plus an
# optional off-host Loki backend. editable=false: an operator who wants a
# second datasource must
# change the ansible role (the role owns the file surface, not the
# Grafana admin API). timeInterval=15s matches Prometheus' default
# scrape interval so the dashboard panels don't render at a cadence
# misaligned with the underlying series.
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: "{{ gv_prom_url }}"
    isDefault: true
    editable: false
    jsonData:
      timeInterval: 15s
      httpMethod: POST
{% if gv_trace_datasource_uid | length > 0 or gv_trace_exemplar_url | length > 0 %}
      # Prometheus exemplars carry trace_id as sample metadata. Keep the
      # destination optional because the platform does not require a specific
      # trace backend; providers can point this at Tempo, Jaeger, Datadog, or
      # another Grafana-supported trace datasource.
      exemplarTraceIdDestinations:
{% if gv_trace_datasource_uid | length > 0 %}
        - datasourceUid: "{{ gv_trace_datasource_uid }}"
          name: trace_id
          urlDisplayLabel: View trace
{% endif %}
{% if gv_trace_exemplar_url | length > 0 %}
        - name: trace_id
          url: "{{ gv_trace_exemplar_url }}"
          urlDisplayLabel: View trace
{% endif %}
{% endif %}
{% if gv_loki_url | length > 0 %}
  # Loki on the control plane (ADR-20261023124955 §2). Grafana reads the
  # fleet-PKI client leaf itself through $__file{}; certificate contents never
  # pass through Ansible templating.
  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: "{{ gv_loki_url }}"
    editable: false
    jsonData:
      maxLines: 1000
      timeout: 60
      httpHeaderName1: X-Scope-OrgID
      tlsAuth: true
      tlsAuthWithCACert: true
      serverName: "{{ gv_loki_server_name }}"
    secureJsonData:
      httpHeaderValue1: "{{ gv_loki_tenant_id }}"
      tlsCACert: "$__file{{ '{' }}{{ gv_loki_ca_file }}{{ '}' }}"
      tlsClientCert: "$__file{{ '{' }}{{ gv_loki_client_cert_file }}{{ '}' }}"
      tlsClientKey: "$__file{{ '{' }}{{ gv_loki_client_key_file }}{{ '}' }}"
{% endif %}
