  "panels": [
    {
      "type": "timeseries",
      "title": "Top-10 throttled apps (5m)",
      "id": 1,
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "description": "Per-app cumulative throttle-seconds, top-10 by 5m rate. Label key is `account_id` for parity with apid's top-tenants panel; the legend value is the resolved app_id (vmmd's throttle rollup is keyed (account_id, app_id)). Issue #301 / ADR-043 — see pkg/wire/topn_app.go::topAppSet (cap=100 hottest apps).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "topk(10, rate(vmmd_cpu_throttle_seconds_total{app_id!=\"other\"}[5m]))",
          "legendFormat": "{{account_id}}/{{app_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "type": "timeseries",
      "title": "Customer share of fleet throttling (5m, vmmd)",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "description": "Top-10 customers by share of total fleet throttling. Use this panel to identify the dominant offender when multiple customers are contributing to a single slice's saturation (panel 1's per-app view collapses siblings of the same customer; this panel rolls them up to the account level).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "topk(10, sum by (account_id) (rate(vmmd_cpu_throttle_seconds_total{account_id!=\"other\"}[5m])) / clamp_min(sum(rate(vmmd_cpu_throttle_seconds_total[5m])), 0.001))",
          "legendFormat": "{{account_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      }
    },
    {
      "type": "stat",
      "title": "Other bucket growth (vmmd, 5m)",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "description": "Flags overflow saturation of the topAppSet admission primitive (pkg/wire/topn_app.go). A non-zero rate here means the customer pool is past the cap=100 hottest-apps limit and the operator must check the vmmd slog for which (account_id, app_id) is being demoted to the overflow bucket. Same shape as the top-tenants panel #4 (apid's other bucket) — overflow saturation is a fleet-level signal, not a customer-misbehavior one.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "rate(vmmd_cpu_throttle_seconds_total{account_id=\"other\",app_id=\"other\"}[5m])",
          "legendFormat": "other",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.1}
            ]
          },
          "color": {"mode": "thresholds"}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
