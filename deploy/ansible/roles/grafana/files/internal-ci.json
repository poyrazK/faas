{
  "uid": "faas-internal-ci",
  "title": "Gregale internal CI",
  "description": "ADR-1575 internal-only CI operations. All CI flags ship off. Requires the faas_internal_ci recording group and existing private daemon scrapes. Missing evidence is Unknown; these observations do not qualify native compute. Runbook: docs/runbooks/FaasInternalCIOperations.md.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "faas",
    "internal",
    "ci"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Internal CI runbook",
      "type": "link",
      "url": "https://github.com/poyrazK/faas/blob/main/docs/runbooks/FaasInternalCIOperations.md",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Health read status",
      "description": "Current read status for each daemon. Disabled is explicit boot configuration; Unknown includes missing scrapes or missing recording rules. Readable means the durable query succeeded and does not qualify native compute.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:observation_status:by_daemon",
          "legendFormat": "{{daemon}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "gray"
                },
                "1": {
                  "text": "Readable",
                  "color": "green"
                },
                "2": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "3": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "title": "Worker availability",
      "description": "Current configured worker availability. A healthy or starting group takes precedence over retained failed/stale groups. Unknown is missing evidence or configured work without a matching observation. Configuration and observations are separate; this does not prove native capacity.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:worker_status:by_worker",
          "legendFormat": "{{worker}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "gray"
                },
                "1": {
                  "text": "Healthy",
                  "color": "green"
                },
                "2": {
                  "text": "Starting",
                  "color": "blue"
                },
                "3": {
                  "text": "Degraded",
                  "color": "yellow"
                },
                "4": {
                  "text": "Blocked",
                  "color": "red"
                },
                "5": {
                  "text": "Stalled",
                  "color": "red"
                },
                "6": {
                  "text": "Stale",
                  "color": "orange"
                },
                "7": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "title": "Queues: retained pending and in-flight items",
      "description": "Shared fleet gauges use max across readable apid/githubd targets. Never sum replicas. Conditions can overlap; execution reconciliation includes active work between polls. Missing observations remain gaps.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:queue_items:by_queue_condition{condition=~\"pending|in_flight\"}",
          "legendFormat": "{{queue}} / {{condition}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Oldest retained work item",
      "description": "Age since creation of the oldest retained pending/in-flight item. This is not delivery latency or time spent in the current state. An old Check can become dirty again; age alone does not fire an alert.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:queue_oldest_item_age_seconds:by_queue",
          "legendFormat": "{{queue}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "GitHub Checks and retry intent",
      "description": "Dirty acknowledged execution versions reenter pending work. Dead delivery remains visible when publication is paused. Retry requests are durable operator intent and do not replay execution work.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:queue_items:by_queue_condition{queue=~\"metadata_checks|execution_checks|check_retries\",condition=~\"pending|in_flight|dead\"}",
          "legendFormat": "{{queue}} / {{condition}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Expired leases awaiting recovery",
      "description": "Expired work leases are time eligible for reconciliation; authority, retry budgets and native safety still apply. Warnings require the owning worker to be configured on. Keep lease fences and immutable attempt identities intact.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:queue_items:by_queue_condition{condition=\"stale_leases\"}",
          "legendFormat": "{{queue}}",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Global quota utilization",
      "description": "Only existing global limits are shown. Max observed usage and min observed limit are conservative across readable replicas. Warnings start at 80 percent sustained for ten minutes and are gated on the relevant execution/retention path.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 * faas_ci:resource_utilization:by_resource",
          "legendFormat": "{{resource}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 8,
      "title": "Remaining global count budgets",
      "description": "Remaining active execution, dispatch lease, object, I/O and permanent journal allowances. Values are clamped at zero. Per-account quotas are available through gregalectl ci health. Missing evidence is Unknown.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:resource_headroom:by_resource{resource!=\"storage_bytes\"}",
          "legendFormat": "{{resource}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 9,
      "title": "Managed storage byte budget",
      "description": "Live reserved storage bytes include pending/deleting objects until retirement is acknowledged. Permanent tombstones keep their separate journal charge.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:resource_used:by_resource{resource=\"storage_bytes\"}",
          "legendFormat": "Used",
          "refId": "A",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "expr": "faas_ci:resource_limit:by_resource{resource=\"storage_bytes\"}",
          "legendFormat": "Limit",
          "refId": "B",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "expr": "faas_ci:resource_headroom:by_resource{resource=\"storage_bytes\"}",
          "legendFormat": "Headroom",
          "refId": "C",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "Unknown",
          "custom": {
            "drawStyle": "line",
            "spanNulls": false,
            "insertNulls": false
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "Worker groups by observed condition",
      "description": "Anonymous bounded diagnostic slots, not a fleet census. Each condition is deduplicated with max; different snapshots and retained crashed slots can overlap. A dispatcher group contains four local loops. Do not sum conditions to infer process counts.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:worker_replicas:by_worker_condition",
          "legendFormat": "{{worker}} / {{condition}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "worker": "Worker",
              "condition": "Condition",
              "Value": "Observed groups",
              "resource": "Resource"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "title": "Configured workers",
      "description": "Live owner-daemon boot switches. Explicit zero means disabled, including intentional pauses; missing configuration means Unknown. This signal is emitted even if the durable health query fails.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:worker_enabled:by_worker",
          "legendFormat": "{{worker}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "gray"
                },
                "1": {
                  "text": "Enabled",
                  "color": "blue"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 12,
      "title": "Fleet resource usage",
      "description": "Fleet usage for execution details, archives, profiles, revisions, source journals and global count budgets. Retired tombstones and source deduplication evidence remain charged. A missing fleet limit does not mean unlimited per-account history.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "faas_ci:resource_used:by_resource{resource!=\"storage_bytes\"}",
          "legendFormat": "{{resource}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "Unknown",
                  "color": "orange"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            },
            "renameByName": {
              "worker": "Worker",
              "condition": "Condition",
              "Value": "Used",
              "resource": "Resource"
            }
          }
        }
      ]
    }
  ]
}
