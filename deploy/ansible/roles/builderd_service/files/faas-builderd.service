[Unit]
Description=onebox-faas builderd — build orchestrator + ephemeral builder microVMs (spec §4.5, ADR-003, ADR-005)
Documentation=https://docs.gregale.dev/ops/builderd
After=network.target faas-cp.slice faas-vmmd.service
Wants=faas-cp.slice faas-vmmd.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=faas-builderd
Group=faas
ExecStart=/opt/faas/current/bin/builderd
Restart=on-failure
RestartSec=2s
RestartCountExport=SYSTEMD_RESTARTS_ON_FAILURE
Slice=faas-cp.slice
MemoryMax=512M
EnvironmentFile=-/etc/faas/compute-db.env
EnvironmentFile=-/etc/faas/storage.env
EnvironmentFile=-/etc/faas/runtime-bases.env
Environment=FAAS_BUILDERD_CONFIG=/etc/faas/builderd.toml
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadOnlyPaths=/etc/faas
ReadWritePaths=/srv/fc/builder /srv/fc/base /var/log/faas /var/spool/faas /var/lib/faas/cache /var/cache/faas/builds

[Install]
WantedBy=multi-user.target
