# Alertmanager configuration — generated by ansible; do not hand-edit on the box.
#
# Severity → notification mapping (locked to deploy/ansible/roles/prometheus/files/faas.rules.yml):
#   info  → suppressed (no receiver; surfaces in Prometheus / Grafana only).
#   warn  → ticket email and/or chat via faas-warn receiver.
#   page  → operator email + Pushover and/or chat via faas-page receiver.
# FaasWatchdog (always firing) → faas-heartbeat, the dead-man's switch: an
# external monitor alerts when its periodic posts stop.
#
# Grouping: by alertname + component so a single fault (e.g. apid down)
# doesn't fan out into per-route email storms; group_wait 30s gives the
# first wave of firing alerts time to coalesce.
#
# Secret handling: secrets are read from operator-provisioned files via
# Alertmanager's native `*_file` support (`auth_password_file`, `token_file`,
# `user_key_file`). They NEVER appear in this rendered file — gap G2 lean §17
# (sealed at rest), and the rendered file can safely be logged at debug verbosity
# without leaking credentials. Operator provisions:
#   /etc/alertmanager/secrets/smtp-password      (mode 0400, alertmanager:alertmanager)
#   /etc/alertmanager/secrets/pushover-token    (mode 0400, alertmanager:alertmanager)
#   /etc/alertmanager/secrets/pushover-user-key (mode 0400, alertmanager:alertmanager)
#   /etc/alertmanager/secrets/discord-webhook-url, slack-webhook-url,
#   heartbeat-url                                (mode 0400, alertmanager:alertmanager)
# The tasks/main.yml loader asserts the file permissions before systemd unit
# enable. Empty paths are valid only for am_dev_mode: the resulting config is
# deliberately silent until an operator provisions a notification channel.

{% set am_smtp_password_path = am_smtp_password_file | default('') | trim %}
{% set am_pushover_token_path = am_pushover_token_file | default('') | trim %}
{% set am_pushover_user_key_path = am_pushover_user_key_file | default('') | trim %}
{% set am_smtp_host = am_smtp_smarthost | default('') | trim %}
{% set am_discord_path = am_discord_webhook_url_file | default('') | trim %}
{% set am_slack_path = am_slack_webhook_url_file | default('') | trim %}
{% set am_heartbeat_path = am_heartbeat_url_file | default('') | trim %}
{% set am_email_enabled = am_smtp_host | length > 0 and am_smtp_password_path | length > 0 %}
{% set am_pushover_enabled = am_pushover_token_path | length > 0 and am_pushover_user_key_path | length > 0 %}
{% set am_discord_enabled = am_discord_path | length > 0 %}
{% set am_slack_enabled = am_slack_path | length > 0 %}
{% set am_chat_enabled = am_discord_enabled or am_slack_enabled %}
{% set am_heartbeat_enabled = am_heartbeat_path | length > 0 %}
{% set am_notifications_enabled = am_email_enabled or am_pushover_enabled or am_chat_enabled %}
{% set am_warn_enabled = am_email_enabled or am_chat_enabled %}

{% if am_email_enabled %}
global:
  resolve_timeout: 5m
  smtp_smarthost: "{{ am_smtp_host }}"
  smtp_from: "{{ am_email_from }}"
{% else %}
global:
  resolve_timeout: 5m
{% endif %}

route:
{% if am_notifications_enabled %}
  receiver: faas-page
{% else %}
  receiver: faas-silent
{% endif %}
  group_by: [alertname, component]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    # Dead-man's switch first, so no severity route can swallow it. The
    # short group/repeat interval turns the permanently firing FaasWatchdog
    # into a periodic heartbeat post.
    - matchers:
        - alertname = "FaasWatchdog"
{% if am_heartbeat_enabled %}
      receiver: faas-heartbeat
{% else %}
      receiver: faas-silent
{% endif %}
      group_wait: 0s
      group_interval: {{ am_heartbeat_interval | default('5m') }}
      repeat_interval: {{ am_heartbeat_interval | default('5m') }}
      continue: false
{% if not am_email_customer_alert_presets | default(false) | bool %}
    # Customer-configured alert rules are delivered by meterd's signed webhook
    # path. Keep the Prometheus mirrors visible without duplicating them into the
    # shared platform inbox.
    - matchers:
        - family =~ "alert_preset_(signals|correlation)"
      receiver: faas-silent
      continue: false
{% endif %}
    # page-severity: full notify (email + Pushover + chat).
    - matchers:
        - severity = "page"
{% if am_notifications_enabled %}
      receiver: faas-page
{% else %}
      receiver: faas-silent
{% endif %}
      group_wait: 10s
      repeat_interval: 1h
    # warn-severity: ticket email and/or chat; longer repeat so we don't spam.
    - matchers:
        - severity = "warn"
{% if am_warn_enabled %}
      receiver: faas-warn
{% else %}
      receiver: faas-silent
{% endif %}
      repeat_interval: 4h
    # info-severity: no receiver — the matcher matches but no route fires.
    - matchers:
        - severity = "info"
      receiver: faas-silent
      continue: false

receivers:
  - name: faas-page
{% if am_email_enabled %}
    email_configs:
      - to: "{{ am_email_to_page }}"
        # smtp_smarthost / smtp_from default to global.* — operator may override
        # am_smtp_smarthost via -e to point at an external relay. Per-receiver
        # auth_username is the alertmanager-side identity, not a secret.
        auth_username: "{{ am_smtp_auth_username }}"
        auth_password_file: "{{ am_smtp_password_path }}"
        require_tls: {{ am_smtp_require_tls | default(false) | string | lower }}
        send_resolved: true
        headers:
          X-Faas-Alert: "page"
{% endif %}
{% if am_pushover_enabled %}
    pushover_configs:
      # token + user_key both via _file indirection. Alertmanager reads the
      # file at send time, so the secrets are never in this rendered YAML.
      - token_file: "{{ am_pushover_token_path }}"
        user_key_file: "{{ am_pushover_user_key_path }}"
        send_resolved: true
        priority: 2          # emergency: bypass quiet hours on the device
        retry: 1m            # Alertmanager <duration> field — unit required
        expire: 1h           # ditto; integer would fail amtool check-config
        title: "faas page"
        url: "{{ am_alerts_url | default('http://127.0.0.1:9095/alerts') }}"
{% endif %}
{% if am_discord_enabled %}
    # Discord's Slack-compatible endpoint (webhook URL + /slack): Alertmanager
    # 0.27 rejects discord_configs whose URL comes from a file.
    slack_configs:
      - api_url_file: "{{ am_discord_path }}"
        send_resolved: true
{% endif %}
{% if am_slack_enabled %}
    slack_configs:
      - api_url_file: "{{ am_slack_path }}"
        send_resolved: true
{% endif %}

  - name: faas-warn
{% if am_email_enabled %}
    email_configs:
      - to: "{{ am_email_to_warn }}"
        auth_username: "{{ am_smtp_auth_username }}"
        auth_password_file: "{{ am_smtp_password_path }}"
        require_tls: {{ am_smtp_require_tls | default(false) | string | lower }}
        send_resolved: true
        headers:
          X-Faas-Alert: "warn"
{% endif %}
{% if am_discord_enabled %}
    # Discord's Slack-compatible endpoint (webhook URL + /slack): Alertmanager
    # 0.27 rejects discord_configs whose URL comes from a file.
    slack_configs:
      - api_url_file: "{{ am_discord_path }}"
        send_resolved: true
{% endif %}
{% if am_slack_enabled %}
    slack_configs:
      - api_url_file: "{{ am_slack_path }}"
        send_resolved: true
{% endif %}

  - name: faas-heartbeat
{% if am_heartbeat_enabled %}
    webhook_configs:
      # Any heartbeat endpoint that accepts a POST: healthchecks.io,
      # Better Stack, Cronitor. Only the newest alert is sent and resolution
      # is never sent; the ping itself is the signal.
      - url_file: "{{ am_heartbeat_path }}"
        send_resolved: false
        max_alerts: 1
{% endif %}

  - name: faas-silent
    # No integration blocks. The route matches severity="info" but
    # resolves to this empty receiver, so info alerts are visible in
    # Prometheus / Grafana but never page anyone.

inhibit_rules:
  # A page supersedes a warn on the same (alertname, component, family).
  # The `family` label is the load-bearing change vs. the naïve
  # alertname-only design: each threshold has page + warn siblings with
  # different alertnames (FaasHighResidentRamPct vs ...Warn), so
  # grouping on alertname alone would never suppress the warn when the
  # page fires. Each rule in faas.rules.yml sets `family: <threshold>`
  # alongside `severity:`, and we inhibit on it.
  - source_matchers:
      - severity = "page"
    target_matchers:
      - severity = "warn"
    equal: [family, component]
