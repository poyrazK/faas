[Unit]
Description=Alertmanager for faas Prometheus
Documentation=https://github.com/poyrazK/faas
After=network-online.target
Wants=network-online.target

[Service]
User=alertmanager
Group=alertmanager
Type=simple
ExecStart=/usr/local/bin/alertmanager \
    --config.file=/etc/alertmanager/alertmanager.yml \
    --storage.path=/var/lib/alertmanager \
    --web.listen-address=127.0.0.1:9094 \
    --cluster.listen-address=
Restart=on-failure
RestartSec=10s
# ADR-20261023124955 §1: capped observability slice. Alert delivery outranks
# the dashboards for CPU there. production-us measured 33 MB RSS and a 46 MB
# peak on 2026-10-23.
Slice=faas-obs.slice
CPUWeight=100
MemoryMax=128M

# Hardening (mirrors prometheus.service).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/alertmanager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
