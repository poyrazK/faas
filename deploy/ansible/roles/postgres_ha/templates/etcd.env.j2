# Managed by Ansible (postgres_ha). ADR-1152 §3: Patroni's etcd member.
{% set addr = hostvars[inventory_hostname].ansible_host %}
ETCD_NAME="{{ inventory_hostname }}"
ETCD_DATA_DIR="{{ faas_etcd_data_dir }}"
ETCD_LISTEN_PEER_URLS="https://{{ addr }}:{{ faas_etcd_peer_port }}"
ETCD_LISTEN_CLIENT_URLS="https://{{ addr }}:{{ faas_etcd_client_port }},https://127.0.0.1:{{ faas_etcd_client_port }}"
ETCD_INITIAL_ADVERTISE_PEER_URLS="https://{{ addr }}:{{ faas_etcd_peer_port }}"
ETCD_ADVERTISE_CLIENT_URLS="https://{{ addr }}:{{ faas_etcd_client_port }}"
ETCD_INITIAL_CLUSTER="{% for m in faas_postgres_ha_members %}{{ m }}=https://{{ hostvars[m].ansible_host }}:{{ faas_etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}"
ETCD_INITIAL_CLUSTER_STATE="new"
ETCD_INITIAL_CLUSTER_TOKEN="{{ faas_postgres_ha_cluster }}"
ETCD_ENABLE_V2="false"
ETCD_TRUSTED_CA_FILE="{{ faas_etcd_ca_file }}"
ETCD_CERT_FILE="{{ faas_etcd_tls_dir }}/server.crt"
ETCD_KEY_FILE="{{ faas_etcd_tls_dir }}/server.key"
ETCD_CLIENT_CERT_AUTH="true"
ETCD_PEER_TRUSTED_CA_FILE="{{ faas_etcd_ca_file }}"
ETCD_PEER_CERT_FILE="{{ faas_etcd_tls_dir }}/server.crt"
ETCD_PEER_KEY_FILE="{{ faas_etcd_tls_dir }}/server.key"
ETCD_PEER_CLIENT_CERT_AUTH="true"
# Keep the database bounded; Patroni writes little.
ETCD_AUTO_COMPACTION_MODE="periodic"
ETCD_AUTO_COMPACTION_RETENTION="1h"
ETCD_QUOTA_BACKEND_BYTES="2147483648"
