#!/usr/sbin/nft -f
# {{ ansible_managed }}
# ADR-20261117185346 agent egress gateway policy, in its own table beside the
# tenant gateway's faas_tenant_gw. Agent traffic leaves only from the agent
# addresses, and nothing else ever leaves from them.
table inet faas_agent_gw
delete table inet faas_agent_gw

table inet faas_agent_gw {
  counter faas_agent_gw_input_drop {}
  counter faas_agent_gw_deny_private {}
  counter faas_agent_gw_deny_smtp {}
  counter faas_agent_gw_forwarded {}

  chain input {
    type filter hook input priority -10; policy accept;
    # Agents reach the internet through the gateway, never the gateway.
    iifname "{{ faas_agent_egress_iface }}" ct state established,related accept
    iifname "{{ faas_agent_egress_iface }}" icmp type echo-request accept
{% if faas_agentproxyd_enabled | bool %}
    # agentproxyd: the redirected agent connections, and the nodes'
    # registrations (agentproxyd accepts those only from node addresses).
    iifname "{{ faas_agent_egress_iface }}" ip daddr {{ faas_agent_egress_gateway_address | regex_replace('/.*$', '') }} tcp dport { {{ faas_agentproxyd_http_port }}, {{ faas_agentproxyd_tls_port }}, {{ faas_agentproxyd_registration_port }} } accept
{% endif %}
    iifname "{{ faas_agent_egress_iface }}" counter name "faas_agent_gw_input_drop" drop
  }

  chain clamp {
    type filter hook forward priority mangle; policy accept;
    oifname "{{ faas_agent_egress_iface }}" tcp flags syn tcp option maxseg size set rt mtu
  }

  chain forward {
    type filter hook forward priority -10; policy accept;
    ct state established,related accept
    iifname "{{ faas_agent_egress_iface }}" oifname "{{ faas_agent_egress_iface }}" drop
    iifname "{{ faas_agent_egress_iface }}" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 } counter name "faas_agent_gw_deny_private" drop
    iifname "{{ faas_agent_egress_iface }}" tcp dport { 25, 465, 587 } counter name "faas_agent_gw_deny_smtp" drop
    iifname "{{ faas_agent_egress_iface }}" meta l4proto != { tcp, udp, icmp } drop
    iifname "{{ faas_agent_egress_iface }}" oifname "{{ faas_agent_egress_gateway_public_iface }}" counter name "faas_agent_gw_forwarded" accept
    iifname "{{ faas_agent_egress_iface }}" drop
    oifname "{{ faas_agent_egress_iface }}" drop
  }

{% if faas_agentproxyd_enabled | bool %}
  # ADR-20261117185346 §4: agent TCP 80 and 443 go to agentproxyd, which
  # dials out itself from the VM's agent address. Everything else is
  # forwarded below.
  chain prerouting {
    type nat hook prerouting priority dstnat; policy accept;
    iifname "{{ faas_agent_egress_iface }}" ip daddr != {{ faas_agent_egress_gateway_address | regex_replace('/.*$', '') }} tcp dport 80 redirect to :{{ faas_agentproxyd_http_port }}
    iifname "{{ faas_agent_egress_iface }}" ip daddr != {{ faas_agent_egress_gateway_address | regex_replace('/.*$', '') }} tcp dport 443 redirect to :{{ faas_agentproxyd_tls_port }}
  }

{% endif %}
  # Ahead of the tenant table's masquerade, so agent traffic takes an agent
  # address. Each agent VM's tunnel address keeps one address for its life:
  # its low bits pick it, the same choice agentproxyd makes
  # (agentproxy.AddressFor), so proxied and forwarded traffic agree.
  chain postrouting {
    type nat hook postrouting priority srcnat - 1; policy accept;
{% set n = faas_agent_egress_addresses | length %}
{% if n == 1 %}
    ip saddr {{ faas_agent_egress_tunnel_cidr }} oifname "{{ faas_agent_egress_gateway_public_iface }}" snat ip to {{ faas_agent_egress_addresses[0] }}
{% else %}
{% set ns = namespace(size=1) %}
{% for _ in range(6) %}{% if ns.size < n %}{% set ns.size = ns.size * 2 %}{% endif %}{% endfor %}
    ip saddr {{ faas_agent_egress_tunnel_cidr }} oifname "{{ faas_agent_egress_gateway_public_iface }}" snat ip to ip saddr & 0.0.0.{{ ns.size - 1 }} map { {% for i in range(ns.size) %}0.0.0.{{ i }} : {{ faas_agent_egress_addresses[i % n] }}{{ ", " if not loop.last }}{% endfor %} }
{% endif %}
  }
}
