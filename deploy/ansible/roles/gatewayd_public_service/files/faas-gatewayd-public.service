[Unit]
Description=onebox-faas gatewayd-public — plain-HTTP edge (Tier A7 split, ADR-070; TLS terminates at Caddy upstream)
Documentation=https://docs.gregale.dev/ops/gatewayd-public
After=faas-cp.slice network-online.target postgresql.service faas-apid.service
Wants=faas-cp.slice faas-apid.service
Requires=postgresql.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/gatewayd-public
Restart=on-failure
RestartSec=2s
RestartCountExport=SYSTEMD_RESTARTS_ON_FAILURE
Slice=faas-cp.slice
MemoryMax=512M
AmbientCapabilities=
Environment=FAAS_PUBLIC_CONTROL_ADDR=127.0.0.1:9092
Environment=FAAS_INTERNAL_TARGET=
Environment=FAAS_COMPUTE_GATEWAY_DISCOVERY=database
Environment=FAAS_CONTROL_PLANE_API_TARGET=http://127.0.0.1:8081
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas

[Install]
WantedBy=multi-user.target
