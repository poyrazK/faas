# Managed by Gregale Ansible. Raw TCP ingress is opt-in; keep this file
# disabled until the nftables listener range is explicitly allowed.
FAAS_TCPD_ENABLED={{ (faas_tcpd_enabled | default(false) | bool) | ternary('1', '0') }}
FAAS_TCPD_BIND_HOST={{ faas_tcpd_bind_host | default('0.0.0.0') }}
{% for name, value in {
  'FAAS_TCPD_MAX_BYTES': faas_tcpd_max_bytes | default(''),
  'FAAS_TCPD_MAX_CONNECTIONS': faas_tcpd_max_connections | default(''),
  'FAAS_TCPD_MAX_CONNECTIONS_PER_ACCOUNT': faas_tcpd_max_connections_per_account | default(''),
  'FAAS_TCPD_IDLE_TIMEOUT': faas_tcpd_idle_timeout | default(''),
  'FAAS_TCPD_REFRESH_INTERVAL': faas_tcpd_refresh_interval | default(''),
  'FAAS_TCPD_SCHEDD_TARGET': faas_tcpd_schedd_target | default(''),
  'FAAS_TCPD_SCHEDD_TLS_CA_PATH': faas_tcpd_schedd_tls_ca_path | default(''),
  'FAAS_TCPD_SCHEDD_TLS_CERT_PATH': faas_tcpd_schedd_tls_cert_path | default(''),
  'FAAS_TCPD_SCHEDD_TLS_KEY_PATH': faas_tcpd_schedd_tls_key_path | default(''),
  'FAAS_TCPD_VMMD_TLS_CA_PATH': faas_tcpd_vmmd_tls_ca_path | default(''),
  'FAAS_TCPD_VMMD_TLS_CERT_PATH': faas_tcpd_vmmd_tls_cert_path | default(''),
  'FAAS_TCPD_VMMD_TLS_KEY_PATH': faas_tcpd_vmmd_tls_key_path | default('')
}.items() if value | string | trim != '' %}
{{ name }}={{ value }}
{% endfor %}
