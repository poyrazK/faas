# Managed by Gregale Ansible. UDP is opt-in with explicit IPv4 client CIDRs.
FAAS_UDPD_ENABLED={{ (faas_udpd_enabled | default(false) | bool) | ternary('1', '0') }}
FAAS_UDPD_BIND_HOST={{ faas_udpd_bind_host | default('0.0.0.0') }}
FAAS_UDPD_ALLOWED_SOURCE_CIDRS={{ faas_udpd_allowed_cidrs | default([]) | join(',') }}
{% for name, value in {
  'FAAS_UDPD_SCHEDD_TARGET': faas_udpd_schedd_target | default(''),
  'FAAS_UDPD_SCHEDD_TLS_CA_PATH': faas_udpd_schedd_tls_ca_path | default(''),
  'FAAS_UDPD_SCHEDD_TLS_CERT_PATH': faas_udpd_schedd_tls_cert_path | default(''),
  'FAAS_UDPD_SCHEDD_TLS_KEY_PATH': faas_udpd_schedd_tls_key_path | default(''),
  'FAAS_UDPD_VMMD_TLS_CA_PATH': faas_udpd_vmmd_tls_ca_path | default(''),
  'FAAS_UDPD_VMMD_TLS_CERT_PATH': faas_udpd_vmmd_tls_cert_path | default(''),
  'FAAS_UDPD_VMMD_TLS_KEY_PATH': faas_udpd_vmmd_tls_key_path | default('')
}.items() if value | string | trim != '' %}
{{ name }}={{ value }}
{% endfor %}
