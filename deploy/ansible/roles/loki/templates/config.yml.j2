# Generated by Ansible. Loki is the platform log backend for Gregale.
auth_enabled: {{ (not (loki_dev_mode | bool)) | ternary('true', 'false') }}

server:
  http_listen_address: {{ loki_http_listen_address }}
  http_listen_port: {{ loki_http_listen_port }}
  grpc_listen_address: {{ loki_grpc_listen_address }}
  grpc_listen_port: {{ loki_grpc_listen_port }}
  log_level: info
{% if not (loki_dev_mode | bool) %}
  http_tls_config:
    cert_file: {{ loki_tls_cert_file }}
    key_file: {{ loki_tls_key_file }}
    client_auth_type: RequireAndVerifyClientCert
    client_ca_file: {{ loki_tls_ca_file }}
{% endif %}

common:
  path_prefix: {{ loki_data_dir }}
  replication_factor: 1
  # The unit's RestrictAddressFamilies leaves out AF_NETLINK, so Loki cannot
  # list interfaces to find a ring address and exits at startup ("no useable
  # address found for interfaces [eth0 en0]"). One instance, in-memory ring:
  # name the gRPC address it listens on.
  instance_addr: {{ loki_grpc_listen_address }}
  storage:
{% if loki_storage_backend == 's3' %}
    # Credentials expand from the unit's EnvironmentFile (-config.expand-env).
    s3:
      endpoint: {{ loki_s3_endpoint }}
      bucketnames: {{ loki_s3_bucket }}
      region: {{ loki_s3_region }}
      access_key_id: ${AWS_ACCESS_KEY_ID}
      secret_access_key: ${AWS_SECRET_ACCESS_KEY}
      s3forcepathstyle: true
      insecure: false
{% if loki_s3_ca_file %}
      http_config:
        ca_file: {{ loki_s3_ca_file }}
{% endif %}
{% else %}
    filesystem:
      chunks_directory: {{ loki_data_dir }}/chunks
      rules_directory: {{ loki_data_dir }}/rules
{% endif %}
  ring:
    kvstore:
      store: inmemory

schema_config:
  # One period per install. Switching an existing install's backend needs a
  # new period starting after the switch, or older chunks become unreadable.
  configs:
    - from: 2024-04-01
      store: tsdb
      object_store: {{ loki_storage_backend }}
      schema: v13
      index:
        prefix: index_
        period: 24h

storage_config:
  tsdb_shipper:
    active_index_directory: {{ loki_data_dir }}/index
    cache_location: {{ loki_data_dir }}/index-cache
    cache_ttl: 24h
{% if loki_storage_backend != 's3' %}
  filesystem:
    directory: {{ loki_data_dir }}/chunks
{% endif %}

limits_config:
  ingestion_rate_mb: {{ loki_ingestion_rate_mb }}
  ingestion_burst_size_mb: {{ loki_ingestion_burst_size_mb }}
  max_streams_per_user: {{ loki_max_streams_per_user }}
  max_query_series: {{ loki_max_query_series }}
  max_entries_limit_per_query: {{ loki_max_entries_limit_per_query }}
  retention_period: {{ loki_retention_period }}
  reject_old_samples: true
  reject_old_samples_max_age: {{ loki_retention_period }}
  allow_structured_metadata: false

compactor:
  working_directory: {{ loki_data_dir }}/compactor
  retention_enabled: true
  delete_request_store: {{ loki_storage_backend }}

analytics:
  reporting_enabled: false
