# Managed by Ansible (roles/loki). Read by `gregalectl obs logs`
# (ADR-20261023124955 §2); environment variables and flags override it.
{% if loki_dev_mode | bool %}
FAAS_LOKI_URL=http://{{ loki_http_listen_address }}:{{ loki_http_listen_port }}
{% else %}
FAAS_LOKI_URL=https://{{ loki_http_listen_address }}:{{ loki_http_listen_port }}
FAAS_LOKI_SERVER_NAME={{ faas_obs_loki_server_name | default('loki.faas', true) }}
FAAS_LOKI_CA_FILE={{ loki_tls_ca_file }}
FAAS_LOKI_CERT_FILE={{ loki_cli_client_cert_file }}
FAAS_LOKI_KEY_FILE={{ loki_cli_client_key_file }}
{% endif %}
FAAS_LOKI_TENANT=gregale
