{# gatewayd-internal config drop (ADR-093). #}
{# Mirrors the alertmanager role's alertmanager.yml.j2 pattern: a #}
{# single toml key controlling the per-cluster toggle. The two-level #}
{# kill switch shape (operator env + per-app apps.route_metrics_enabled) #}
{# lives in cmd/gatewayd-internal/config.go:107-121 and is read by #}
{# FAAS_GATEWAY_ROUTE_METRICS env override. Operators downgrade #}
{# cluster-wide with `-e gatewayd_route_metrics_enabled=false` at #}
{# the playbook call site. #}

# Public wildcard host contract. This must be present on compute-only boxes
# too: gatewayd-internal owns the final hostname→app lookup after the
# control-plane gatewayd-public forwards the request.
apps_domain = "{{ gatewayd_apps_domain }}"

# ADR-093 operator kill-switch. Default-on (true) so the rollout
# reaches Hobby/Pro/Scale customers who didn't flip the per-app
# apps.route_metrics_enabled flag at create time. Operators
# downgrade with -e gatewayd_route_metrics_enabled=false.
route_metrics_enabled = {{ gatewayd_route_metrics_enabled | default(true) | string | lower }}

# ADR-047 / ADR-143 operator gate for streaming responses. The code default
# is FALSE (cmd/gatewayd-internal/config.go), and until ADR-143 no deploy
# path set it, so every Hobby+ app that paid for streaming — and every SSE,
# LLM or MCP endpoint — was silently buffered fleet-wide. Production is
# default-on here; operators downgrade with -e gatewayd_streaming_enabled=false.
# FAAS_GATEWAY_STREAMING remains the emergency env override.
streaming_enabled = {{ gatewayd_streaming_enabled | default(true) | string | lower }}

# In a single-box deployment this remains apid's loopback listener. The
# generated split-box inventory overrides it with the control-plane address
# so compute-only gatewayd-internal does not dial its own box.
apid_loopback = "{{ faas_gatewayd_apid_loopback | default('http://127.0.0.1:8081') }}"

# Schedd listens on TCP in the multi-box deployment. Keep the client
# identity in the rendered config so gatewayd-internal cannot silently
# downgrade a TCP control-plane connection to plaintext.
schedd_tls_cert_path = "{{ gatewayd_schedd_tls_cert_path }}"
schedd_tls_key_path = "{{ gatewayd_schedd_tls_key_path }}"
schedd_tls_ca_path = "{{ gatewayd_schedd_tls_ca_path }}"

# VMMD serves runner traffic over the split-box mTLS transport.
vmmd_tls_cert_path = "{{ gatewayd_vmmd_tls_cert_path }}"
vmmd_tls_key_path = "{{ gatewayd_vmmd_tls_key_path }}"
vmmd_tls_ca_path = "{{ gatewayd_vmmd_tls_ca_path }}"

{% if gatewayd_egress_listen | default('') | length > 0 %}
# Split-box egress byte stream. The listener target itself is carried in
# FAAS_EGRESS_SOCKET so the same daemon can keep its Unix default on a
# single-box host; these fields provide the server-side mTLS material.
egress_tls_cert_path = "{{ gatewayd_egress_tls_cert_path }}"
egress_tls_key_path = "{{ gatewayd_egress_tls_key_path }}"
egress_tls_ca_path = "{{ gatewayd_egress_tls_ca_path }}"
{% endif %}

{% if gatewayd_app_errors_target | default('') | length > 0 %}
# Split-box AppErrors recorder target. The client leaf is issued in the
# gatewayd directory and is bound to this compute node's registered CN.
app_errors_target = "{{ gatewayd_app_errors_target }}"
app_errors_tls_cert_path = "{{ gatewayd_app_errors_tls_cert_path }}"
app_errors_tls_key_path = "{{ gatewayd_app_errors_tls_key_path }}"
app_errors_tls_ca_path = "{{ gatewayd_app_errors_tls_ca_path }}"
{% endif %}
