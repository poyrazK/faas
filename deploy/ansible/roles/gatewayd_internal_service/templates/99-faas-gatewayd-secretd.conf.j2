# Managed by gatewayd_internal_service (ADR-20261110210000 slice 3f): this
# node's gatewayd-internal opens customer log drain headers through the
# control plane's secretd, which reads the sealed header from the drain row
# and answers only the app's owner node. It uses the node's secretd client
# leaf (issued by vmmd_service); the key is root-only, so systemd hands it to
# gatewayd-internal as a credential.
[Service]
LoadCredential=secretd_client_key:/etc/faas/tls/secretd-client/vmmd.key
Environment=FAAS_GATEWAY_LOG_DRAIN_OPENER=secretd
Environment=FAAS_GATEWAY_SECRETD_TARGET={{ faas_secretd_target }}
Environment=FAAS_SECRETD_TLS_CERT_PATH=/etc/faas/tls/secretd-client/vmmd.crt
Environment=FAAS_SECRETD_TLS_KEY_PATH=%d/secretd_client_key
Environment=FAAS_SECRETD_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
