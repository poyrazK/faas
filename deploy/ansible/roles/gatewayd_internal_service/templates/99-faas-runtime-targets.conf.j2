[Service]
# The unit's --config argument is consumed by cmd/gatewayd-internal/main.go;
# keep the environment explicit as well for container/e2e launches and for
# older operators that invoke the binary without its unit wrapper.
Environment=FAAS_GATEWAYD_CONFIG={{ gatewayd_config_path }}
# The warm-hint/log stream client uses this target. Compute-only hosts get
# the generated control-plane TCP URL; single-box hosts retain the Unix path.
Environment=FAAS_SCHEDD_SOCKET={{ faas_gatewayd_schedd_target | default(faas_vmmd_schedd_target | default('/run/faas/schedd.sock')) }}
{% if gatewayd_app_errors_target | default('') | length > 0 %}
# Compute-only gatewayd reports grouped application errors to the control
# plane over the private mTLS target rendered in gatewayd.toml.
Environment=FAAS_APID_APP_ERRORS_TARGET={{ gatewayd_app_errors_target }}
Environment=FAAS_APID_APP_ERRORS_TLS_CERT_PATH={{ gatewayd_app_errors_tls_cert_path }}
Environment=FAAS_APID_APP_ERRORS_TLS_KEY_PATH={{ gatewayd_app_errors_tls_key_path }}
Environment=FAAS_APID_APP_ERRORS_TLS_CA_PATH={{ gatewayd_app_errors_tls_ca_path }}
# RequestTelemetry shares the same private listener and mTLS identity. The
# daemon falls back to this target when no explicit request-telemetry target
# is supplied, so the split-box path cannot accidentally select the missing
# local Unix socket.
Environment=FAAS_APID_REQUEST_TELEMETRY_TARGET={{ gatewayd_app_errors_target }}
{% endif %}
{% if gatewayd_egress_listen | default('') | length > 0 %}
# Split-box meterd consumes the egress stream over the private mTLS
# listener. Single-box deployments leave this unset and retain the Unix
# socket selected by the daemon default.
Environment=FAAS_EGRESS_SOCKET={{ gatewayd_egress_listen }}
{% endif %}
