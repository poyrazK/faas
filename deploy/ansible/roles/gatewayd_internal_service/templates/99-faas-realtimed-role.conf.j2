[Service]
# realtimed is a compute-only (or single-box) daemon. Keep the role gate in
# systemd rather than relying on the single-box default in cmd/realtimed.
Environment=FAAS_REALTIME_ROLE={{ faas_box_role }}
{% if (faas_box_role | default('single-box')) == 'compute-only' %}
# The control-plane Prometheus discovers this listener through apid's active
# compute-node registry. The nftables role restricts port 9107 to the
# configured control-plane CIDRs; do not expose it through the public rule.
Environment=FAAS_REALTIME_HEALTH_LISTEN=0.0.0.0:9107
{% endif %}
{% if (faas_realtime_live_tls_managed | default(false) | string | lower) in ['true', 'yes', 'on', '1'] %}
# Live queries (ADR-20261016151947): realtimed dials livequeryd hubs over
# wss:// with the fleet PKI's live client leaf, and verifies every hub as
# livequeryd.faas, whatever host the backend's live_hub_url names.
Environment=FAAS_REALTIME_LIVE_TLS_CA_FILE=/etc/faas/tls/ca/ca.crt
Environment=FAAS_REALTIME_LIVE_TLS_CERT_FILE=/etc/faas/tls/realtimed/livequeryd-client.crt
Environment=FAAS_REALTIME_LIVE_TLS_KEY_FILE=/etc/faas/tls/realtimed/livequeryd-client.key
Environment=FAAS_REALTIME_LIVE_TLS_SERVER_NAME=livequeryd.faas
{% else %}
{% if faas_realtime_live_tls_ca_file | default('') %}
# Live queries (ADR-20261016151947): realtimed dials livequeryd hubs over
# wss://, verifying them with this CA and presenting its client certificate
# to hubs that require one (-client-ca). The key must be readable by faas.
Environment=FAAS_REALTIME_LIVE_TLS_CA_FILE={{ faas_realtime_live_tls_ca_file }}
{% endif %}
{% if faas_realtime_live_tls_cert_file | default('') %}
Environment=FAAS_REALTIME_LIVE_TLS_CERT_FILE={{ faas_realtime_live_tls_cert_file }}
Environment=FAAS_REALTIME_LIVE_TLS_KEY_FILE={{ faas_realtime_live_tls_key_file }}
{% endif %}
{% endif %}
