[Unit]
Description=onebox-faas realtimed — managed realtime connection owner
Documentation=https://gregale.dev/docs/ops/realtime
After=faas-cp.slice faas-vmmd.service
Wants=faas-cp.slice faas-vmmd.service

[Service]
Type=notify
NotifyAccess=main
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/realtimed
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2s
WatchdogSec=60s
Slice=faas-cp.slice
MemoryMax=512M
OOMPolicy=continue
EnvironmentFile=-/etc/faas/secrets/realtimed/realtimed.env
EnvironmentFile=-/etc/faas/otel.env
Environment=FAAS_REALTIME_SOCKET=/run/faas/realtimed.sock
Environment=FAAS_REALTIME_FAIR_USE_ENABLED=1
Environment=FAAS_REALTIME_OUTBOUND_BUDGET_ENABLED=1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas /var/lib/faas/realtime-callbacks

[Install]
WantedBy=multi-user.target
