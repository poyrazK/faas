[Unit]
Description=Gregale durable realtimed listener
Documentation=https://gregale.dev/docs/ops/realtime
Before=faas-realtimed.service

# Owns realtimed's unix socket across restarts so gatewayd-internal's
# realtime connects and management calls wait for the replacement
# (docs/adr/1580-zero-downtime-daemon-restarts.md).
[Socket]
ListenStream=/run/faas/realtimed.sock
SocketUser=faas
SocketGroup=faas
SocketMode=0660
FileDescriptorName=realtimed
Backlog=4096
Service=faas-realtimed.service

[Install]
WantedBy=sockets.target
