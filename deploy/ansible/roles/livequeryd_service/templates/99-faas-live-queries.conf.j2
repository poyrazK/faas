# Managed by the livequeryd_service role (ADR-20261016151947): apid seals each
# database's live secret to livequeryd's age recipient. Which accounts see live
# queries is the live_queries platform flag (ADR-1700), set at runtime.
[Service]
Environment=FAAS_APID_LIVE_KEY_RECIPIENT_FILE=/etc/faas/livequeryd/keys.recipient
{% if faas_livequeryd_signing_key_src %}
# ADR 20261028161502: apid signs each live key and login it seals.
LoadCredential=faas_live_signing_key:/etc/faas/secrets/livequeryd/signing.key
Environment=FAAS_APID_LIVE_SIGNING_KEY_FILE=%d/faas_live_signing_key
{% endif %}
