# Managed by the livequeryd_service role (ADR-20261016151947). The generated
# unit names no database; this drop-in serves every database in
# /etc/faas/livequeryd/databases.json from one process, and hands the hub its
# secrets as credentials under %d so none of them appears on its command line.
[Service]
MemoryMax={{ faas_livequeryd_memory_max }}
LoadCredential=keys_dsn:/etc/faas/secrets/livequeryd/keys-dsn
LoadCredential=keys_identity:/etc/faas/secrets/livequeryd/keys.age
{% for db in faas_livequeryd_databases %}
LoadCredential=database_url.{{ db.id }}:/etc/faas/secrets/livequeryd/{{ db.id }}.database-url
{% if db.neon_api_key_src | default('') %}
LoadCredential=neon_api_key.{{ db.id }}:/etc/faas/secrets/livequeryd/{{ db.id }}.neon-api-key
{% endif %}
{% endfor %}
{% if faas_livequeryd_neon_api_key_src %}
LoadCredential=neon_api_key:/etc/faas/secrets/livequeryd/neon-api-key
{% endif %}
{% if faas_livequeryd_tls_cert %}
LoadCredential=tls_key:{{ faas_livequeryd_tls_key }}
{% endif %}
ExecStart=
ExecStart=/opt/faas/current/bin/livequeryd \
{% if faas_livequeryd_databases | length > 0 %}
  -databases-file=/etc/faas/livequeryd/databases.json \
{% endif %}
{% if faas_livequeryd_discover_backends | length > 0 %}
  -discover-backends={{ faas_livequeryd_discover_backends | join(',') }} \
{% if faas_livequeryd_discover_release_after %}
  -discover-release-after={{ faas_livequeryd_discover_release_after }} \
{% endif %}
{% endif %}
  -checkpoint-dir=/var/lib/faas/livequeryd \
  -keys-dsn-file=%d/keys_dsn \
  -keys-identity=%d/keys_identity \
{% if faas_livequeryd_signing_pub_src %}
  -live-signature-keys=/etc/faas/livequeryd/signing.pub \
{% endif %}
{% if faas_livequeryd_require_signatures | bool %}
  -require-live-signatures \
{% endif %}
  -listen={{ faas_livequeryd_listen }} \
{% if faas_livequeryd_tls_cert %}
  -tls-cert={{ faas_livequeryd_tls_cert }} \
  -tls-key=%d/tls_key \
  -client-ca={{ faas_livequeryd_client_ca }} \
{% if faas_livequeryd_client_name %}
  -client-name={{ faas_livequeryd_client_name }} \
{% endif %}
{% endif %}
{% if faas_livequeryd_neon_api_key_src %}
  -neon-api-key-file=%d/neon_api_key \
{% endif %}
  -max-per-connection={{ faas_livequeryd_max_per_connection }} \
  -metrics-listen={{ faas_livequeryd_metrics_listen }}
