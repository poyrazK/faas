# Managed by the secretd_service role (ADR-20261110210000 §3). The runtime
# seal domain's identity and secretd's TLS key are credentials: systemd reads
# the root-only files and hands them to faas-secretd alone, so no other
# daemon user can read them.
[Service]
LoadCredential=faas_seal_domain_runtime:/etc/faas/secrets/domains/runtime.age
{% if faas_secretd_runtime_previous.stat.exists | default(false) %}
LoadCredential=faas_seal_domain_runtime_previous:/etc/faas/secrets/domains/runtime.age.previous
{% endif %}
LoadCredential=tls_key:/etc/faas/tls/secretd/server.key
{% set edge = (faas_secretd_edge_identities.results | default([])) %}
{% if edge | length > 0 and edge[0].stat.exists | default(false) %}
# ADR-20261110210000 slice 3f: the edge domain, for log drain headers.
LoadCredential=faas_seal_domain_edge:/etc/faas/secrets/domains/edge.age
{% if edge | length > 1 and edge[1].stat.exists | default(false) %}
LoadCredential=faas_seal_domain_edge_previous:/etc/faas/secrets/domains/edge.age.previous
{% endif %}
Environment=FAAS_SECRETD_EDGE_IDENTITY=%d/faas_seal_domain_edge
{% endif %}
{% set delivery = (faas_secretd_delivery_identities.results | default([])) %}
{% if delivery | length > 0 and delivery[0].stat.exists | default(false) %}
# ADR-20261110210000 slice 3g: the delivery domain, for broker trigger
# credentials.
LoadCredential=faas_seal_domain_delivery:/etc/faas/secrets/domains/delivery.age
{% if delivery | length > 1 and delivery[1].stat.exists | default(false) %}
LoadCredential=faas_seal_domain_delivery_previous:/etc/faas/secrets/domains/delivery.age.previous
{% endif %}
Environment=FAAS_SECRETD_DELIVERY_IDENTITY=%d/faas_seal_domain_delivery
{% endif %}
Environment=FAAS_SECRETD_RUNTIME_IDENTITY=%d/faas_seal_domain_runtime
Environment=FAAS_SECRETD_LISTEN={{ faas_secretd_listen }}
Environment=FAAS_SECRETD_TLS_CERT_PATH=/etc/faas/tls/secretd/server.crt
Environment=FAAS_SECRETD_TLS_KEY_PATH=%d/tls_key
Environment=FAAS_SECRETD_TLS_CA_PATH=/etc/faas/tls/ca/ca.crt
Environment=FAAS_SECRETD_ROLE={{ faas_box_role | default('single-box') }}
Environment=FAAS_SECRETD_METRICS_ADDR={{ faas_secretd_metrics_listen }}
Environment=FAAS_SECRETD_REQUIRE_REFERENCES={{ 'true' if (faas_secretd_require_references | default(false) | bool) else 'false' }}
{% if faas_secretd_apps_per_node_hour | string | length > 0 %}
Environment=FAAS_SECRETD_APPS_PER_NODE_HOUR={{ faas_secretd_apps_per_node_hour }}
{% endif %}
# secretd logs in only as faas_secretd (pg_ident: faas-secretd -> faas_secretd).
Environment=FAAS_DB_ROLE=faas_secretd
