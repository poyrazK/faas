[Unit]
Description=Gregale internal mail service (feature gated)
After=network-online.target postgresql.service faas-apid.service faas-cp.slice
Wants=faas-cp.slice
Requires=postgresql.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/maild
Restart=on-failure
RestartSec=2s
WatchdogSec=60s
Slice=faas-cp.slice
MemoryMax=256M
EnvironmentFile=-/etc/faas/compute-db.env
EnvironmentFile=/etc/faas/secrets/internal-mail/maild.env
Environment=FAAS_INTERNAL_MAIL_PRODUCER_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_OUTBOX_RECONCILIATION_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_VERIFICATION_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PASSWORD_CHANGED_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PASSWORD_RESET_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MAGIC_LINK_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_DISABLED_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_DISABLE_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_DEPLOYMENT_FAILED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_SUBSCRIPTION_ENDED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_QUOTA_WARNING_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_NONPAYMENT_DELETION_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_ACCOUNT_SUSPENDED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_ACCOUNT_RESTORED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PAYMENT_FAILED_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_ENABLED_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_MFA_RECOVERY_ALERT_OUTBOX_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_DELIVERY_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_REPORTS_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_FEEDBACK_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_RETENTION_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_OPERATIONS_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_DKIM_ROTATION_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_DOMAIN_REVERIFY_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_DELIVERY_CONTROLS_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PRODUCERS_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_SCHEDULING_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_DOMAIN_PACING_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_RELAY_BACKPRESSURE_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_REPUTATION_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_EVENT_FEED_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PRODUCER_SCHEDULING_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_PRODUCER_LIFECYCLE_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_ENCRYPTION_ROTATION_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_SUPPRESSION_CONTROLS_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_RECOVERY_ENABLED=0
Environment=FAAS_INTERNAL_MAIL_SOCKET=/run/faas/maild.sock
Environment=FAAS_INTERNAL_MAIL_AGE_IDENTITY_PATH=%d/faas_internal_mail_age_identity
LoadCredential=faas_internal_mail_age_identity:/etc/faas/secrets/internal-mail/mail.age
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/run/faas

[Install]
WantedBy=multi-user.target
