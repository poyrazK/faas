[Unit]
Description=Gregale Agents (agentd): claims agent runs and drives them through schedd
After=network-online.target postgresql.service faas-cp.slice faas-schedd.service
Wants=network-online.target faas-cp.slice
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/agentd
Restart=on-failure
RestartSec=2s
Slice=faas-cp.slice
MemoryMax=256M
EnvironmentFile=-/etc/faas/secrets/agentd/agentd.env
EnvironmentFile=-/etc/faas/storage.env
EnvironmentFile=-/etc/faas/otel.env
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/srv/fc /var/lib/faas

[Install]
WantedBy=multi-user.target
