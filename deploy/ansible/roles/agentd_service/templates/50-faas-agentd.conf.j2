# Managed by the agentd_service role (ADR-20261027090010, ADR-20261027090014). The generated unit
# leaves agentd idle; this drop-in turns agent runs and their features on.
[Service]
Environment=FAAS_AGENTD_AGENT_RUNS=1
Environment=FAAS_AGENTD_CONCURRENCY={{ faas_agentd_concurrency }}
Environment=FAAS_AGENTD_CHECKOUTS={{ '1' if faas_agentd_checkouts | bool else '0' }}
Environment=FAAS_AGENTD_OUTPUT_FILES={{ '1' if faas_agentd_output_files | bool else '0' }}
Environment=FAAS_AGENTD_DELIVERIES={{ '1' if faas_agentd_deliveries | bool else '0' }}
{% if faas_agentd_s3_endpoint %}
Environment=FAAS_AGENTD_S3_ENDPOINT={{ faas_agentd_s3_endpoint }}
{% endif %}
Environment=FAAS_AGENTD_METRICS_ADDR={{ faas_agentd_metrics_listen }}
