[Unit]
Description=Gregale GitHub Actions deployment runner ({{ faas_runner_repo }})
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ faas_runner_user }}
Group={{ faas_runner_group }}
WorkingDirectory={{ faas_runner_root }}
ExecStart={{ faas_runner_root }}/bin/runsvc.sh
Restart=always
RestartSec=5s
TimeoutStopSec=5min
KillMode=process
UMask=0077
# Deploy jobs share the split-box control plane with PostgreSQL; a low weight
# yields CPU to the database under contention (roles/postgres raises its slice).
CPUWeight={{ faas_runner_cpu_weight }}
{% if faas_runner_cpu_quota %}
CPUQuota={{ faas_runner_cpu_quota }}
{% endif %}
{% if faas_runner_io_weight %}
IOWeight={{ faas_runner_io_weight }}
{% endif %}
{% if faas_runner_memory_high %}
MemoryHigh={{ faas_runner_memory_high }}
{% endif %}
{% if faas_runner_memory_max %}
MemoryMax={{ faas_runner_memory_max }}
{% endif %}
{% if faas_runner_gomaxprocs %}
Environment=GOMAXPROCS={{ faas_runner_gomaxprocs }}
{% endif %}
Environment=HOME={{ faas_runner_home }}
{% if faas_runner_kind == 'build' %}
# A cancelled build's Go processes do not outlive it (the cleanup hook).
Environment=ACTIONS_RUNNER_HOOK_JOB_STARTED={{ faas_runner_job_cleanup_hook }}
Environment=ACTIONS_RUNNER_HOOK_JOB_COMPLETED={{ faas_runner_job_cleanup_hook }}
{% endif %}
Environment=RUNNER_ALLOW_RUNASROOT=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem={{ faas_runner_protect_system }}
ProtectHome=read-only
ReadWritePaths={{ faas_runner_root }} {{ faas_runner_home }}

[Install]
WantedBy=multi-user.target
