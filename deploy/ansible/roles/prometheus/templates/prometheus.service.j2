[Unit]
Description=Prometheus (faas SLO dashboard pipeline)
Documentation=https://github.com/onebox-faas/faas
Wants=network-online.target
After=network-online.target
# Alertmanager runs on loopback; Prometheus dials it for evaluate→notify.
# `Wants=` (not `Requires=`) so a failed Alertmanager still allows Prometheus
# to start — rules evaluate, the page-severity alerts pile up in the
# notifier queue, and the operator sees degraded state in `promtool` /
# the status-page degraded flag.
Wants=alertmanager.service
After=alertmanager.service

[Service]
User=prometheus
Group=prometheus
Type=simple
ExecStart=/usr/local/bin/prometheus \
  --config.file=/etc/prometheus/prometheus.yml \
  --storage.tsdb.path={{ prom_data_dir }} \
  --storage.tsdb.retention.time={{ prom_retention_days }}d \
  --web.listen-address={{ prom_listen_addr }} \
  --web.console.libraries=/usr/share/prometheus/console_libraries \
  --web.console.templates=/usr/share/prometheus/consoles
# systemd primitive — `kill -HUP` triggers Prometheus' SIGUSR1 rule-reload
# path without a process restart (preserves the in-memory series). Required
# because handlers/main.yml:12-15 issues `systemctl reload prometheus.service`;
# without this line systemd's no-ExecReload fallback is a no-op and the
# reload handler is silently inert. Both rule files (pg_backup.rules.yml
# issue #250 + faas.rules.yml ADR-093) ride this same handler.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# Hardening (spec §11 baseline).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ prom_data_dir }}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
