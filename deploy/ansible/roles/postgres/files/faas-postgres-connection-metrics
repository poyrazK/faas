#!/bin/sh
set -eu

output=/var/lib/node_exporter/textfile_collector/faas_postgres_connections.prom
tmp="${output}.tmp.$$"
trap 'test ! -e "$tmp" || unlink "$tmp"' EXIT

values="$(psql -d faas -At -F ' ' -c "
SELECT COALESCE(sum(numbackends), 0),
       current_setting('max_connections')::bigint -
       current_setting('superuser_reserved_connections')::bigint
FROM pg_stat_database;
")"
set -- $values
connections="${1:?missing connection count}"
capacity="${2:?missing ordinary capacity}"

# WAL archiving health (ADR-1344 §3). pg_stat_archiver covers the local
# archive copy; the marker file is touched by archive_command after each
# successful off-host push, which is otherwise best-effort and silent.
archiver="$(psql -d faas -At -F ' ' -c "
SELECT archived_count, failed_count,
       COALESCE(extract(epoch FROM last_archived_time)::bigint, 0)
FROM pg_stat_archiver;
")"
set -- $archiver
archived="${1:?missing archived count}"
archive_failed="${2:?missing archive failure count}"
last_archived="${3:?missing last archived time}"

offhost_configured=0
if test -r /var/lib/pgsql/backup-rclone.conf; then
  offhost_configured=1
fi
offhost_last_success=0
if test -e /var/lib/pgsql/archive/.offhost-last-success; then
  offhost_last_success="$(stat -c %Y /var/lib/pgsql/archive/.offhost-last-success)"
fi

# Warm-standby slot health (ADR-1344 §8), read on the primary. No row means
# no standby is declared, or this host is the standby, and emits nothing.
standby="$(psql -d faas -At -F ' ' -c "
SELECT s.active::int,
       COALESCE(pg_wal_lsn_diff(pg_current_wal_lsn(), s.restart_lsn), 0)::bigint,
       COALESCE(s.wal_status, 'unknown'),
       COALESCE(pg_wal_lsn_diff(pg_current_wal_lsn(), r.replay_lsn), -1)::bigint,
       pg_size_bytes(current_setting('max_slot_wal_keep_size'))
FROM pg_replication_slots s
LEFT JOIN pg_stat_replication r ON r.pid = s.active_pid
WHERE s.slot_name = 'faas_standby' AND NOT pg_is_in_recovery();
")"

cat >"$tmp" <<EOF
# HELP faas_postgres_client_connections PostgreSQL client sessions across all databases.
# TYPE faas_postgres_client_connections gauge
faas_postgres_client_connections $connections
# HELP faas_postgres_ordinary_connection_capacity Connection slots available before the superuser reserve.
# TYPE faas_postgres_ordinary_connection_capacity gauge
faas_postgres_ordinary_connection_capacity $capacity
# HELP faas_postgres_wal_archived_total WAL segments archived to the local archive since stats reset.
# TYPE faas_postgres_wal_archived_total counter
faas_postgres_wal_archived_total $archived
# HELP faas_postgres_wal_archive_failed_total Failed local WAL archive attempts since stats reset.
# TYPE faas_postgres_wal_archive_failed_total counter
faas_postgres_wal_archive_failed_total $archive_failed
# HELP faas_postgres_wal_last_archived_timestamp_seconds Unix time of the last WAL segment archived locally (0 if never).
# TYPE faas_postgres_wal_last_archived_timestamp_seconds gauge
faas_postgres_wal_last_archived_timestamp_seconds $last_archived
# HELP faas_postgres_offhost_wal_configured 1 when off-host WAL push credentials are installed.
# TYPE faas_postgres_offhost_wal_configured gauge
faas_postgres_offhost_wal_configured $offhost_configured
# HELP faas_postgres_offhost_wal_last_success_timestamp_seconds Unix time of the last successful off-host WAL push (0 if never).
# TYPE faas_postgres_offhost_wal_last_success_timestamp_seconds gauge
faas_postgres_offhost_wal_last_success_timestamp_seconds $offhost_last_success
EOF

if test -n "$standby"; then
  set -- $standby
  slot_active="${1:?missing standby slot state}"
  slot_retained="${2:?missing standby slot retained bytes}"
  slot_wal_status="${3:?missing standby slot wal status}"
  replay_lag="${4:?missing standby replay lag}"
  slot_keep_size="${5:?missing max_slot_wal_keep_size}"
  cat >>"$tmp" <<EOF
# HELP faas_postgres_standby_slot_active 1 while the warm standby streams from its slot.
# TYPE faas_postgres_standby_slot_active gauge
faas_postgres_standby_slot_active $slot_active
# HELP faas_postgres_standby_slot_retained_bytes WAL the primary keeps for the warm standby's slot.
# TYPE faas_postgres_standby_slot_retained_bytes gauge
faas_postgres_standby_slot_retained_bytes $slot_retained
# HELP faas_postgres_standby_slot_keep_size_bytes max_slot_wal_keep_size; past it the slot is lost (-1 is unlimited).
# TYPE faas_postgres_standby_slot_keep_size_bytes gauge
faas_postgres_standby_slot_keep_size_bytes $slot_keep_size
# HELP faas_postgres_standby_slot_wal_status The warm standby slot's pg_replication_slots.wal_status.
# TYPE faas_postgres_standby_slot_wal_status gauge
faas_postgres_standby_slot_wal_status{wal_status="$slot_wal_status"} 1
EOF
  if test "$replay_lag" -ge 0; then
    cat >>"$tmp" <<EOF
# HELP faas_postgres_standby_replay_lag_bytes WAL the connected warm standby has not replayed yet.
# TYPE faas_postgres_standby_replay_lag_bytes gauge
faas_postgres_standby_replay_lag_bytes $replay_lag
EOF
  fi
fi
chmod 0644 "$tmp"
mv "$tmp" "$output"
