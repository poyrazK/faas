# DO dev deployment — githubd config.
# GitHub App credentials come from sealed.env.
socket_path = "/run/faas/githubd.sock"
http_addr = "127.0.0.1:8083"
# Keep this equal to apid/gatewayd-internal apps_domain (manifest dns.apps_domain).
apps_domain = "gregale.dev"
# Split-box fleets set the TCP listener and mTLS files via the managed
# systemd drop-in. The empty TOML defaults preserve the local socket in dev.
