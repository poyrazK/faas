[Unit]
Description=onebox-faas githubd — GitHub App integration
After=network.target postgresql.service faas-cp.slice
Wants=faas-cp.slice
Requires=postgresql.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
User=faas
Group=faas
ExecStart=/opt/faas/current/bin/githubd --config /etc/faas/githubd.toml
Restart=on-failure
RestartSec=2s
WatchdogSec=120s
Slice=faas-cp.slice
MemoryMax=256M
CapabilityBoundingSet=
AmbientCapabilities=
EnvironmentFile=-/etc/faas/compute-db.env
EnvironmentFile=-/etc/faas/secrets/githubd/githubd.env
EnvironmentFile=-/etc/faas/otel.env
Environment=FAAS_HOST_AGE_IDENTITY_PATH=%d/faas_fleet_age_identity
Environment=FAAS_HOST_AGE_PUB=%d/faas_fleet_age_recipient
Environment=FAAS_GITHUB_APP_KEY_PATH=%d/faas_github_app_key_unit
LoadCredential=faas_fleet_age_identity:/etc/faas/secrets/fleet.age
LoadCredential=faas_host_age_identity:/etc/faas/secrets/host.age
LoadCredential=faas_fleet_age_recipient:/etc/faas/secrets/fleet.age.pub
LoadCredential=faas_github_app_key_unit:/etc/faas/secrets/githubd/app.pem
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
LockPersonality=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
ReadOnlyPaths=/etc/faas
ReadWritePaths=/var/log/faas /var/lib/faas /run/faas

[Install]
WantedBy=multi-user.target
