+#[cfg(test)]
+mod legacy_restore_msr_tests {
+    use super::*;
+    use crate::arch_gen::x86::msr_index::{MSR_IA32_TSC, MSR_IA32_TSC_DEADLINE};
+
+    fn chunk(values: &[(u32, u64)]) -> Msrs {
+        let entries: Vec<_> = values.iter().map(|&(index, data)| kvm_bindings::kvm_msr_entry {
+            index, data, ..Default::default()
+        }).collect();
+        Msrs::from_entries(&entries).unwrap()
+    }
+
+    fn values(chunks: &[Msrs]) -> Vec<(u32, u64)> {
+        chunks.iter().flat_map(|c| c.as_slice().iter().map(|e| (e.index, e.data))).collect()
+    }
+
+    #[test]
+    fn deadline_follows_tsc_across_legacy_chunk_orders() {
+        for input in [
+            vec![chunk(&[(MSR_IA32_TSC_DEADLINE, 42), (MSR_IA32_TSC, 30), (0x123, 7)])],
+            vec![chunk(&[(MSR_IA32_TSC_DEADLINE, 42)]), chunk(&[(MSR_IA32_TSC, 30), (0x123, 7)])],
+            vec![chunk(&[(MSR_IA32_TSC, 30), (0x123, 7)]), chunk(&[(MSR_IA32_TSC_DEADLINE, 42)])],
+        ] {
+            let original = values(&input);
+            let ordered = KvmVcpu::ordered_restore_msrs(&input).unwrap();
+            assert_eq!(values(&ordered), vec![(MSR_IA32_TSC, 30), (0x123, 7), (MSR_IA32_TSC_DEADLINE, 42)]);
+            assert_eq!(values(&input), original, "must not mutate the snapshot");
+            assert_eq!(ordered.last().unwrap().as_slice().len(), 1);
+        }
+    }
+
+    #[test]
+    fn preserves_zero_deadlines_and_unrelated_register_values() {
+        let input = vec![chunk(&[(MSR_IA32_TSC_DEADLINE, 0), (0x123, u64::MAX)]), chunk(&[])];
+        let ordered = KvmVcpu::ordered_restore_msrs(&input).unwrap();
+        assert_eq!(values(&ordered), vec![(0x123, u64::MAX), (MSR_IA32_TSC_DEADLINE, 0)]);
+        assert!(KvmVcpu::ordered_restore_msrs(&[]).unwrap().is_empty());
+        let plain = vec![chunk(&[(0x456, 2), (MSR_IA32_TSC, 4)])];
+        assert_eq!(values(&KvmVcpu::ordered_restore_msrs(&plain).unwrap()), values(&plain));
+    }
+
+    #[test]
+    fn deferred_batches_respect_kvm_limit_without_losing_entries() {
+        let entries = vec![(MSR_IA32_TSC_DEADLINE, 3); KVM_MAX_MSR_ENTRIES];
+        let input = vec![chunk(&entries), chunk(&entries)];
+        let ordered = KvmVcpu::ordered_restore_msrs(&input).unwrap();
+        assert_eq!(values(&ordered), values(&input));
+        assert!(ordered.iter().all(|c| c.as_slice().len() <= KVM_MAX_MSR_ENTRIES));
+    }
+}
