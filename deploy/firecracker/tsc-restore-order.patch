+    /// Preserve legacy snapshot contents while deferring timer deadlines until
+    /// all CPU clock registers have been restored (upstream Firecracker #4666).
+    fn ordered_restore_msrs(chunks: &[Msrs]) -> Result<Vec<Msrs>, KvmVcpuError> {
+        use crate::arch_gen::x86::msr_index::MSR_IA32_TSC_DEADLINE;
+
+        let mut ordered = Vec::with_capacity(chunks.len() + 1);
+        let mut deferred = Vec::new();
+        for chunk in chunks {
+            let mut regular = Vec::with_capacity(chunk.as_slice().len());
+            for entry in chunk.as_slice() {
+                if entry.index == MSR_IA32_TSC_DEADLINE {
+                    deferred.push(*entry);
+                } else {
+                    regular.push(*entry);
+                }
+            }
+            if !regular.is_empty() {
+                ordered.push(Msrs::from_entries(&regular)?);
+            }
+        }
+        // Keep every KVM_SET_MSRS batch within the original kernel limit,
+        // including malformed legacy inputs containing repeated deadlines.
+        for chunk in deferred.chunks(KVM_MAX_MSR_ENTRIES) {
+            ordered.push(Msrs::from_entries(chunk)?);
+        }
+        Ok(ordered)
+    }
