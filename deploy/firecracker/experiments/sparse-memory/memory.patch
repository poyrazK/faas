+#[cfg(test)]
+mod sparse_restore_tests {
+    use super::*;
+    use std::os::unix::fs::FileExt;
+    use utils::tempfile::TempFile;
+
+    #[test]
+    fn preserves_sparse_bytes_offsets_and_isolation() {
+        let file = TempFile::new().unwrap().into_file();
+        file.set_len(72 * 1024 * 1024).unwrap();
+        file.write_all_at(&[0x37; 4096], 8 * 1024 * 1024 + 4096).unwrap();
+        file.write_all_at(&[0xc1; 4096], 72 * 1024 * 1024 - 4096).unwrap();
+        let state = GuestMemoryState { regions: vec![
+            GuestMemoryRegionState { base_address: 0, size: 32 * 1024 * 1024, offset: 8 * 1024 * 1024 },
+            GuestMemoryRegionState { base_address: 64 * 1024 * 1024, size: 32 * 1024 * 1024, offset: 40 * 1024 * 1024 },
+        ]};
+        assert!(sparse_anonymous_plan(&file, &state).unwrap().is_some());
+        let one = sparse_anonymous_restore(&file, &state, true).unwrap();
+        let two = sparse_anonymous_restore(&file, &state, false).unwrap();
+        for r in &state.regions {
+            let mut expected = vec![0; r.size];
+            file.read_exact_at(&mut expected, r.offset).unwrap();
+            let mut actual = vec![0; r.size];
+            one.read_slice(&mut actual, GuestAddress(r.base_address)).unwrap();
+            assert_eq!(actual, expected);
+            two.read_slice(&mut actual, GuestAddress(r.base_address)).unwrap();
+            assert_eq!(actual, expected);
+        }
+        one.write_slice(&[0x44], GuestAddress(4096)).unwrap();
+        assert_eq!(two.read_obj::<u8>(GuestAddress(4096)).unwrap(), 0x37);
+        let mut original = [0];
+        file.read_exact_at(&mut original, 8 * 1024 * 1024 + 4096).unwrap();
+        assert_eq!(original, [0x37]);
+    }
+
+    #[test]
+    fn rejects_truncated_and_overflowing_input() {
+        let file = TempFile::new().unwrap().into_file();
+        file.set_len(4096).unwrap();
+        for offset in [4096, u64::MAX] {
+            let state = GuestMemoryState { regions: vec![GuestMemoryRegionState {
+                base_address: 0, size: 4096, offset,
+            }]};
+            assert!(sparse_anonymous_restore(&file, &state, false).is_err());
+        }
+    }
+    #[test]
+    fn dense_and_thp_scattered_inputs_keep_lazy_mapping() {
+        const SIZE: usize = 64 * 1024 * 1024;
+        let state = GuestMemoryState { regions: vec![GuestMemoryRegionState {
+            base_address: 0, size: SIZE, offset: 0,
+        }]};
+        let sparse = TempFile::new().unwrap().into_file();
+        sparse.set_len(SIZE as u64).unwrap();
+        sparse.write_all_at(&[0x37; 4096], 8 * 1024 * 1024).unwrap();
+        assert!(sparse_anonymous_plan(&sparse, &state).unwrap().is_some());
+        // Very few file bytes can still span every THP tile.
+        for offset in (0..SIZE).step_by(2 * 1024 * 1024) {
+            sparse.write_all_at(&[0x37; 4096], offset as u64).unwrap();
+        }
+        assert!(sparse_anonymous_plan(&sparse, &state).unwrap().is_none());
+        let dense = TempFile::new().unwrap().into_file();
+        let chunk = vec![0x51; 1024 * 1024];
+        for offset in (0..SIZE).step_by(chunk.len()) {
+            dense.write_all_at(&chunk, offset as u64).unwrap();
+        }
+        assert!(sparse_anonymous_plan(&dense, &state).unwrap().is_none());
+        let one = sparse_anonymous_restore(&dense, &state, true).unwrap();
+        let two = sparse_anonymous_restore(&dense, &state, false).unwrap();
+        assert_eq!(one.read_obj::<u8>(GuestAddress(4096)).unwrap(), 0x51);
+        one.write_slice(&[0x44], GuestAddress(4096)).unwrap();
+        assert_eq!(two.read_obj::<u8>(GuestAddress(4096)).unwrap(), 0x51);
+        let mut original = [0];
+        dense.read_exact_at(&mut original, 4096).unwrap();
+        assert_eq!(original, [0x51]);
+    }
+
