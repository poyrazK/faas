+// The snapshot format and cold-boot path are unchanged.
+// Restore populated file extents into anonymous THP-advised memory before KVM
+// can access it. Sparse holes retain the anonymous mapping's zero contents.
+fn sparse_anonymous_restore(
+    file: &File,
+    state: &GuestMemoryState,
+    track_dirty_pages: bool,
+) -> Result<GuestMemoryMmap, MemoryError> {
+    use std::os::unix::fs::FileExt;
+    let invalid = || MemoryError::FileError(std::io::Error::new(
+        std::io::ErrorKind::InvalidData, "invalid snapshot memory extent"));
+    let file_len = file.metadata().map_err(MemoryError::FileError)?.len();
+    for r in &state.regions {
+        if r.offset.checked_add(r.size as u64).ok_or_else(invalid)? > file_len {
+            return Err(invalid());
+        }
+    }
+    let extents = match sparse_anonymous_plan(file, state)? {
+        Some(extents) => extents,
+        None => {
+            // Dense inputs must retain lazy file mapping: eager anonymous
+            // charging can OOM a VM after its first successful response.
+            let regions = state.regions.iter().map(|r| {
+                file.try_clone().map(|clone| {
+                    (FileOffset::new(clone, r.offset), GuestAddress(r.base_address), r.size)
+                })
+            }).collect::<Result<Vec<_>, std::io::Error>>()
+                .map_err(MemoryError::FileError)?;
+            return GuestMemoryMmap::from_raw_regions_file(regions, track_dirty_pages, false);
+        }
+    };
+    let regions: Vec<_> = state.regions.iter()
+        .map(|r| (GuestAddress(r.base_address), r.size)).collect();
+    let memory = GuestMemoryMmap::from_raw_regions(&regions, track_dirty_pages, HugePageConfig::None)?;
+    for (r, extents) in state.regions.iter().zip(extents) {
+        let region = memory.find_region(GuestAddress(r.base_address)).ok_or_else(invalid)?;
+        if region.start_addr().0 != r.base_address || region.len() != r.size as u64 {
+            return Err(invalid());
+        }
+        let ptr = region.as_ptr();
+        // SAFETY: region is a new writable mapping, not registered with KVM yet.
+        if unsafe { libc::madvise(ptr.cast(), r.size, libc::MADV_HUGEPAGE) } != 0 {
+            return Err(MemoryError::FileError(std::io::Error::last_os_error()));
+        }
+        for (data, hole) in extents {
+            // SAFETY: checked offsets keep this writable slice in the new
+            // region. No guest or other thread can access it during restore.
+            let bytes = unsafe { std::slice::from_raw_parts_mut(ptr.add((data-r.offset) as usize), (hole-data) as usize) };
+            file.read_exact_at(bytes, data).map_err(MemoryError::FileError)?;
+        }
+    }
+    Ok(memory)
+}
+
+// Plan the eager copy before charging any anonymous pages. Count a conservative
+// THP footprint, including one extra 2 MiB tile per extent for an unaligned mmap.
+// Keep at least 25% (capped at 32 MiB) of guest memory uncharged at restore; this
+// is headroom, not a larger cgroup limit. Dense or unknown layouts retain the
+// original lazy private-file backend.
+fn sparse_anonymous_plan(
+    file: &File,
+    state: &GuestMemoryState,
+) -> Result<Option<Vec<Vec<(u64, u64)>>>, MemoryError> {
+    use std::os::fd::AsRawFd;
+    const THP: u64 = 2 * 1024 * 1024;
+    let invalid = || MemoryError::FileError(std::io::Error::new(
+        std::io::ErrorKind::InvalidData, "invalid snapshot memory extent"));
+    let total = state.regions.iter().try_fold(0u64, |sum, r| {
+        sum.checked_add(r.size as u64).ok_or_else(invalid)
+    })?;
+    let budget = total - (total / 4).min(32 * 1024 * 1024);
+    let mut charged = 0u64;
+    let mut plan = Vec::with_capacity(state.regions.len());
+    for r in &state.regions {
+        let end = r.offset.checked_add(r.size as u64).ok_or_else(invalid)?;
+        let mut pos = r.offset;
+        let mut covered_end = 0u64;
+        let mut extents = Vec::new();
+        while pos < end {
+            let off = i64::try_from(pos).map_err(|_| invalid())?;
+            // SAFETY: the live descriptor and checked offset remain valid.
+            let data = unsafe { libc::lseek(file.as_raw_fd(), off, libc::SEEK_DATA) };
+            if data < 0 {
+                let err = std::io::Error::last_os_error();
+                if err.raw_os_error() == Some(libc::ENXIO) { break; }
+                if err.raw_os_error() == Some(libc::EINVAL) || err.raw_os_error() == Some(libc::EOPNOTSUPP) {
+                    return Ok(None);
+                }
+                return Err(MemoryError::FileError(err));
+            }
+            let data = data as u64;
+            if data >= end { break; }
+            // SAFETY: data is a representable offset from the preceding seek.
+            let hole = unsafe { libc::lseek(file.as_raw_fd(), data as i64, libc::SEEK_HOLE) };
+            if hole < 0 { return Err(MemoryError::FileError(std::io::Error::last_os_error())); }
+            let hole = (hole as u64).min(end);
+            if data < pos || hole <= data { return Err(invalid()); }
+            let first = ((data - r.offset) / THP) * THP;
+            let last = (hole - r.offset).saturating_add(2 * THP - 1) / THP * THP;
+            let last = last.min(r.size as u64);
+            charged = charged.checked_add(last.saturating_sub(first.max(covered_end)))
+                .ok_or_else(invalid)?;
+            if charged > budget { return Ok(None); }
+            covered_end = covered_end.max(last);
+            extents.push((data, hole));
+            pos = hole;
+        }
+        plan.push(extents);
+    }
+    Ok(Some(plan))
+}
