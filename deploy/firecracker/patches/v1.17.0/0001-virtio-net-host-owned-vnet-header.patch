+
+    #[test]
+    fn offloads_need_their_own_negotiated_feature() {
+        let frame = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 9000);
+        let hdr = vnet(1, 0, 0, 34, 16);
+        assert_eq!(check(hdr, &frame, 0), Err(OffloadRejection::NotNegotiated));
+        assert_eq!(
+            check(hdr, &frame, 1 << VIRTIO_NET_F_HOST_TSO4),
