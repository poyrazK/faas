@@ -0,0 +1,672 @@
+// Copyright 2026 Gregale. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! The host never trusts guest-supplied offload metadata.
+//!
+//! A guest's `virtio_net_hdr` reaches the host kernel through the TAP device:
+//! `flags`, `gso_type`, `gso_size`, `hdr_len`, `csum_start` and `csum_offset`
+//! drive `skb_partial_csum_set`, `skb_checksum_help` and GSO segmentation on
+//! the host. Bugs in those paths are guest-to-host bugs (CVE-2026-99999:
+//! `csum_start` pointing into the already parsed IPv4 header). Firecracker
+//! wrote the guest's header to the TAP unmodified and read it from guest
+//! memory, so the guest could also change it while the host was writing it.
+//!
+//! This module decides which header the host writes instead:
+//!
+//! * Devices no longer offer any offload feature. A driver that never acked a
+//!   guest-to-host offload gets an all-zero host header for every frame,
+//!   whatever its own header says.
+//! * A device restored from a snapshot taken before this change may still have
+//!   `VIRTIO_NET_F_CSUM` or `VIRTIO_NET_F_HOST_TSO*` acked, and its driver keeps
+//!   sending partial checksums and TSO frames. For those devices
+//!   [`validate_legacy_offload`] accepts exactly one shape: a TCP or UDP checksum
+//!   (and TCP segmentation) whose `csum_start` is the transport header that the
+//!   host itself found by parsing a host copy of the frame headers. The host then
+//!   writes its own header and the parsed headers from that copy, so the guest
+//!   cannot change what was validated.
+
+use crate::devices::virtio::generated::virtio_net::{
+    VIRTIO_NET_F_CSUM, VIRTIO_NET_F_HOST_TSO4, VIRTIO_NET_F_HOST_TSO6, VIRTIO_NET_F_HOST_UFO,
+};
+
+/// `virtio_net_hdr.flags`: the device must complete a partial checksum.
+pub const VIRTIO_NET_HDR_F_NEEDS_CSUM: u8 = 1;
+/// `virtio_net_hdr.gso_type` values (virtio 1.x, 5.1.6).
+pub const VIRTIO_NET_HDR_GSO_NONE: u8 = 0;
+/// TCP over IPv4 segmentation.
+pub const VIRTIO_NET_HDR_GSO_TCPV4: u8 = 1;
+/// UDP fragmentation offload (UFO).
+pub const VIRTIO_NET_HDR_GSO_UDP: u8 = 3;
+/// TCP over IPv6 segmentation.
+pub const VIRTIO_NET_HDR_GSO_TCPV6: u8 = 4;
+/// ECN bit OR-ed into a TCP `gso_type`.
+pub const VIRTIO_NET_HDR_GSO_ECN: u8 = 0x80;
+
+/// Size of `virtio_net_hdr_v1` (VIRTIO_F_VERSION_1 is always negotiated).
+pub const VNET_HDR_LEN: usize = 12;
+
+/// Guest-to-host offload features. Only a device restored from an older
+/// snapshot can have any of them acked.
+pub const GUEST_TX_OFFLOAD_FEATURES: u64 = (1 << VIRTIO_NET_F_CSUM)
+    | (1 << VIRTIO_NET_F_HOST_TSO4)
+    | (1 << VIRTIO_NET_F_HOST_TSO6)
+    | (1 << VIRTIO_NET_F_HOST_UFO);
+
+const ETH_HLEN: usize = 14;
+const ETH_P_IP: u16 = 0x0800;
+const ETH_P_IPV6: u16 = 0x86DD;
+const IPV4_MIN_HLEN: usize = 20;
+const IPV6_HLEN: usize = 40;
+const IPPROTO_TCP: u8 = 6;
+const IPPROTO_UDP: u8 = 17;
+const TCP_MIN_HLEN: usize = 20;
+const TCP_CSUM_OFFSET: u16 = 16;
+const UDP_HLEN: usize = 8;
+const UDP_CSUM_OFFSET: u16 = 6;
+
+/// Bytes after the vnet header that the host copies on the legacy path:
+/// Ethernet, an IPv4 header with the maximum options (IPv6 needs less) and a
+/// TCP header with the maximum options.
+pub const LEGACY_HEADER_COPY_LEN: usize = ETH_HLEN + 60 + 60;
+
+/// Why a legacy offload frame was refused. The frame is dropped.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum OffloadRejection {
+    /// A flag other than NEEDS_CSUM is set.
+    UnknownFlags,
+    /// The offload was never negotiated by this device.
+    NotNegotiated,
+    /// GSO without NEEDS_CSUM, ECN on non-TCP, UFO or an unknown GSO type.
+    UnsupportedGso,
+    /// The frame ends before the headers the offload needs.
+    Truncated,
+    /// Not an untagged Ethernet IPv4 or IPv6 frame.
+    UnsupportedL3,
+    /// Bad IPv4 version or header length, or an IPv4 fragment.
+    BadIpv4Header,
+    /// Bad IPv6 version, or extension headers before the transport header.
+    BadIpv6Header,
+    /// The IP length field does not fit the frame.
+    BadIpLength,
+    /// The transport protocol is not TCP or UDP.
+    UnsupportedL4,
+    /// Bad TCP data offset.
+    BadTcpHeader,
+    /// `csum_start` / `csum_offset` do not name the transport checksum field.
+    ChecksumPlacement,
+    /// The GSO type does not match the parsed protocols.
+    GsoMismatch,
+    /// `gso_size` is zero.
+    BadGsoSize,
+}
+
+/// A legacy offload the host accepted, with every field derived from the
+/// host's own parse of the frame.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct ValidatedOffload {
+    /// Always NEEDS_CSUM.
+    pub flags: u8,
+    /// GSO type, including the ECN bit for TCP.
+    pub gso_type: u8,
+    /// Segment size, 0 without GSO.
+    pub gso_size: u16,
+    /// Offset of the transport header from the start of the Ethernet frame.
+    pub csum_start: u16,
+    /// Offset of the checksum field inside the transport header.
+    pub csum_offset: u16,
+    /// Ethernet + IP + transport header length. The host writes these bytes
+    /// from its copy and the rest of the frame from guest memory.
+    pub header_len: u16,
+}
+
+impl ValidatedOffload {
+    /// The `virtio_net_hdr_v1` the host writes for this frame (little endian).
+    pub fn vnet_hdr(&self) -> [u8; VNET_HDR_LEN] {
+        let mut hdr = [0u8; VNET_HDR_LEN];
+        hdr[0] = self.flags;
+        hdr[1] = self.gso_type;
+        hdr[2..4].copy_from_slice(&self.header_len.to_le_bytes());
+        hdr[4..6].copy_from_slice(&self.gso_size.to_le_bytes());
+        hdr[6..8].copy_from_slice(&self.csum_start.to_le_bytes());
+        hdr[8..10].copy_from_slice(&self.csum_offset.to_le_bytes());
+        // num_buffers (10..12) stays 0 on transmit.
+        hdr
+    }
+}
+
+/// True when the guest header asks for any offload at all.
+pub fn requests_offload(guest_hdr: &[u8]) -> bool {
+    guest_hdr.len() >= 2 && (guest_hdr[0] != 0 || guest_hdr[1] != VIRTIO_NET_HDR_GSO_NONE)
+}
+
+fn be16(buf: &[u8], at: usize) -> u16 {
+    u16::from_be_bytes([buf[at], buf[at + 1]])
+}
+
+fn le16(buf: &[u8], at: usize) -> u16 {
+    u16::from_le_bytes([buf[at], buf[at + 1]])
+}
+
+/// Validates the offload request of a device that acked guest-to-host offloads.
+///
+/// * `guest_hdr`: host copy of the guest's `virtio_net_hdr_v1`.
+/// * `headers`: host copy of the first bytes of the Ethernet frame (up to
+///   [`LEGACY_HEADER_COPY_LEN`]).
+/// * `frame_len`: length of the whole Ethernet frame (without the vnet header).
+/// * `acked_features`: the device's acked virtio features.
+///
+/// Returns `Ok(None)` for a frame that requests no offload; the host then
+/// writes a zero header. Returns the accepted offload otherwise.
+pub fn validate_legacy_offload(
+    guest_hdr: &[u8; VNET_HDR_LEN],
+    headers: &[u8],
+    frame_len: usize,
+    acked_features: u64,
+) -> Result<Option<ValidatedOffload>, OffloadRejection> {
+    if !requests_offload(guest_hdr) {
+        return Ok(None);
+    }
+    let flags = guest_hdr[0];
+    let gso_type = guest_hdr[1];
+    let gso_size = le16(guest_hdr, 4);
+    let guest_csum_start = le16(guest_hdr, 6);
+    let guest_csum_offset = le16(guest_hdr, 8);
+
+    if flags & !VIRTIO_NET_HDR_F_NEEDS_CSUM != 0 {
+        return Err(OffloadRejection::UnknownFlags);
+    }
+    // Every legacy offload this device model ever produced carried a partial
+    // checksum; GSO without one is not something a Linux guest sends.
+    if flags & VIRTIO_NET_HDR_F_NEEDS_CSUM == 0 {
+        return Err(OffloadRejection::UnsupportedGso);
+    }
+    if acked_features & (1 << VIRTIO_NET_F_CSUM) == 0 {
+        return Err(OffloadRejection::NotNegotiated);
+    }
+    let ecn = gso_type & VIRTIO_NET_HDR_GSO_ECN != 0;
+    let gso_base = gso_type & !VIRTIO_NET_HDR_GSO_ECN;
+    match gso_base {
+        VIRTIO_NET_HDR_GSO_NONE if !ecn => {}
+        VIRTIO_NET_HDR_GSO_TCPV4 => {
+            if acked_features & (1 << VIRTIO_NET_F_HOST_TSO4) == 0 {
+                return Err(OffloadRejection::NotNegotiated);
+            }
+        }
+        VIRTIO_NET_HDR_GSO_TCPV6 => {
+            if acked_features & (1 << VIRTIO_NET_F_HOST_TSO6) == 0 {
+                return Err(OffloadRejection::NotNegotiated);
+            }
+        }
+        // UFO: Linux guests stopped generating it in 4.14; refuse it outright.
+        VIRTIO_NET_HDR_GSO_UDP => return Err(OffloadRejection::UnsupportedGso),
+        _ => return Err(OffloadRejection::UnsupportedGso),
+    }
+
+    let headers = &headers[..headers.len().min(frame_len)];
+    if headers.len() < ETH_HLEN {
+        return Err(OffloadRejection::Truncated);
+    }
+    let (l4_offset, protocol, ip_end, is_ipv4) = match be16(headers, 12) {
+        ETH_P_IP => {
+            if headers.len() < ETH_HLEN + IPV4_MIN_HLEN {
+                return Err(OffloadRejection::Truncated);
+            }
+            let ver_ihl = headers[ETH_HLEN];
+            if ver_ihl >> 4 != 4 {
+                return Err(OffloadRejection::BadIpv4Header);
+            }
+            let ihl = usize::from(ver_ihl & 0x0f) * 4;
+            if ihl < IPV4_MIN_HLEN {
+                return Err(OffloadRejection::BadIpv4Header);
+            }
+            // More-fragments or a fragment offset: offloads never apply.
+            if be16(headers, ETH_HLEN + 6) & 0x3fff != 0 {
+                return Err(OffloadRejection::BadIpv4Header);
+            }
+            let total_len = usize::from(be16(headers, ETH_HLEN + 2));
+            (
+                ETH_HLEN + ihl,
+                headers[ETH_HLEN + 9],
+                ETH_HLEN + total_len,
+                true,
+            )
+        }
+        ETH_P_IPV6 => {
+            if headers.len() < ETH_HLEN + IPV6_HLEN {
+                return Err(OffloadRejection::Truncated);
+            }
+            if headers[ETH_HLEN] >> 4 != 6 {
+                return Err(OffloadRejection::BadIpv6Header);
+            }
+            let next_header = headers[ETH_HLEN + 6];
+            if next_header != IPPROTO_TCP && next_header != IPPROTO_UDP {
+                // Extension headers (or anything else) before the transport
+                // header: refuse rather than walk a guest-built chain.
+                return Err(OffloadRejection::BadIpv6Header);
+            }
+            let payload_len = usize::from(be16(headers, ETH_HLEN + 4));
+            (
+                ETH_HLEN + IPV6_HLEN,
+                next_header,
+                ETH_HLEN + IPV6_HLEN + payload_len,
+                false,
+            )
+        }
+        _ => return Err(OffloadRejection::UnsupportedL3),
+    };
+    let (l4_len, csum_offset) = match protocol {
+        IPPROTO_TCP => {
+            if headers.len() < l4_offset + TCP_MIN_HLEN {
+                return Err(OffloadRejection::Truncated);
+            }
+            let doff = usize::from(headers[l4_offset + 12] >> 4) * 4;
+            if doff < TCP_MIN_HLEN {
+                return Err(OffloadRejection::BadTcpHeader);
+            }
+            (doff, TCP_CSUM_OFFSET)
+        }
+        IPPROTO_UDP => (UDP_HLEN, UDP_CSUM_OFFSET),
+        _ => return Err(OffloadRejection::UnsupportedL4),
+    };
+    let header_len = l4_offset + l4_len;
+    if headers.len() < header_len {
+        return Err(OffloadRejection::Truncated);
+    }
+    // The IP length must cover the headers and fit in the frame (trailing
+    // Ethernet padding is allowed).
+    if ip_end < header_len || ip_end > frame_len {
+        return Err(OffloadRejection::BadIpLength);
+    }
+    if usize::from(guest_csum_start) != l4_offset || guest_csum_offset != csum_offset {
+        return Err(OffloadRejection::ChecksumPlacement);
+    }
+    match gso_base {
+        VIRTIO_NET_HDR_GSO_TCPV4 if !(is_ipv4 && protocol == IPPROTO_TCP) => {
+            return Err(OffloadRejection::GsoMismatch);
+        }
+        VIRTIO_NET_HDR_GSO_TCPV6 if !(!is_ipv4 && protocol == IPPROTO_TCP) => {
+            return Err(OffloadRejection::GsoMismatch);
+        }
+        VIRTIO_NET_HDR_GSO_NONE => {}
+        _ if gso_size == 0 => return Err(OffloadRejection::BadGsoSize),
+        _ => {}
+    }
+
+    // header_len <= LEGACY_HEADER_COPY_LEN (134), l4_offset <= 74: both fit u16.
+    #[allow(clippy::cast_possible_truncation)]
+    Ok(Some(ValidatedOffload {
+        flags: VIRTIO_NET_HDR_F_NEEDS_CSUM,
+        gso_type,
+        gso_size: if gso_base == VIRTIO_NET_HDR_GSO_NONE {
+            0
+        } else {
+            gso_size
+        },
+        csum_start: l4_offset as u16,
+        csum_offset,
+        header_len: header_len as u16,
+    }))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const ALL_LEGACY: u64 = GUEST_TX_OFFLOAD_FEATURES;
+
+    fn vnet(flags: u8, gso_type: u8, gso_size: u16, start: u16, offset: u16) -> [u8; 12] {
+        let mut h = [0u8; 12];
+        h[0] = flags;
+        h[1] = gso_type;
+        h[2..4].copy_from_slice(&0xffffu16.to_le_bytes()); // guest hdr_len is ignored
+        h[4..6].copy_from_slice(&gso_size.to_le_bytes());
+        h[6..8].copy_from_slice(&start.to_le_bytes());
+        h[8..10].copy_from_slice(&offset.to_le_bytes());
+        h
+    }
+
+    fn ipv4_frame(ihl_words: u8, protocol: u8, l4: &[u8], payload: usize) -> Vec<u8> {
+        let ihl = usize::from(ihl_words) * 4;
+        let mut f = vec![0u8; ETH_HLEN + ihl];
+        f[12..14].copy_from_slice(&ETH_P_IP.to_be_bytes());
+        f[ETH_HLEN] = 0x40 | ihl_words;
+        let total = u16::try_from(ihl + l4.len() + payload).unwrap();
+        f[ETH_HLEN + 2..ETH_HLEN + 4].copy_from_slice(&total.to_be_bytes());
+        f[ETH_HLEN + 6] = 0x40; // DF
+        f[ETH_HLEN + 9] = protocol;
+        f.extend_from_slice(l4);
+        f.extend(std::iter::repeat_n(0xab, payload));
+        f
+    }
+
+    fn ipv6_frame(next_header: u8, l4: &[u8], payload: usize) -> Vec<u8> {
+        let mut f = vec![0u8; ETH_HLEN + IPV6_HLEN];
+        f[12..14].copy_from_slice(&ETH_P_IPV6.to_be_bytes());
+        f[ETH_HLEN] = 0x60;
+        let plen = u16::try_from(l4.len() + payload).unwrap();
+        f[ETH_HLEN + 4..ETH_HLEN + 6].copy_from_slice(&plen.to_be_bytes());
+        f[ETH_HLEN + 6] = next_header;
+        f.extend_from_slice(l4);
+        f.extend(std::iter::repeat_n(0xcd, payload));
+        f
+    }
+
+    fn tcp(doff_words: u8) -> Vec<u8> {
+        let mut t = vec![0u8; usize::from(doff_words) * 4];
+        t[12] = doff_words << 4;
+        t
+    }
+
+    fn check(
+        hdr: [u8; 12],
+        frame: &[u8],
+        acked: u64,
+    ) -> Result<Option<ValidatedOffload>, OffloadRejection> {
+        let copy = &frame[..frame.len().min(LEGACY_HEADER_COPY_LEN)];
+        validate_legacy_offload(&hdr, copy, frame.len(), acked)
+    }
+
+    #[test]
+    fn plain_frame_needs_no_offload() {
+        let frame = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 100);
+        assert_eq!(check([0; 12], &frame, ALL_LEGACY), Ok(None));
+        // Guest garbage in hdr_len / csum fields without a flag or GSO type is
+        // ignored: the host writes a zero header.
+        let mut hdr = vnet(0, 0, 1400, 2, 3);
+        hdr[2] = 0x77;
+        assert_eq!(check(hdr, &frame, ALL_LEGACY), Ok(None));
+        assert!(!requests_offload(&hdr));
+    }
+
+    #[test]
+    fn ipv4_tcp_checksum_accepted_with_host_values() {
+        let frame = ipv4_frame(5, IPPROTO_TCP, &tcp(8), 500);
+        let got = check(vnet(1, 0, 0, 34, 16), &frame, 1 << VIRTIO_NET_F_CSUM)
+            .unwrap()
+            .unwrap();
+        assert_eq!(
+            got,
+            ValidatedOffload {
+                flags: 1,
+                gso_type: 0,
+                gso_size: 0,
+                csum_start: 34,
+                csum_offset: 16,
+                header_len: 34 + 32,
+            }
+        );
+        let hdr = got.vnet_hdr();
+        assert_eq!(&hdr[2..4], &66u16.to_le_bytes()); // host hdr_len, not the guest's 0xffff
+        assert_eq!(&hdr[10..12], &[0, 0]);
+    }
+
+    #[test]
+    fn ipv4_options_move_the_transport_header() {
+        // IHL 15: transport at 14 + 60.
+        let frame = ipv4_frame(15, IPPROTO_UDP, &[0u8; 8], 64);
+        let got = check(vnet(1, 0, 0, 74, 6), &frame, ALL_LEGACY)
+            .unwrap()
+            .unwrap();
+        assert_eq!((got.csum_start, got.header_len), (74, 82));
+    }
+
+    #[test]
+    fn pwnescape_csum_start_into_ip_header_is_refused() {
+        // CVE-2026-99999: csum_start/offset pointing at the IPv4 header so the
+        // host's checksum write rewrites version/IHL after parsing.
+        let frame = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 200);
+        for (start, offset) in [
+            (14u16, 0u16),
+            (12, 2),
+            (0, 14),
+            (34, 0),
+            (34, 6),
+            (35, 16),
+            (1000, 16),
+        ] {
+            assert_eq!(
+                check(vnet(1, 0, 0, start, offset), &frame, ALL_LEGACY),
+                Err(OffloadRejection::ChecksumPlacement),
+                "start {start} offset {offset}"
+            );
+        }
+    }
+
+    #[test]
+    fn tso_accepted_only_for_matching_protocols() {
+        let v4 = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 9000);
+        let ok = check(
+            vnet(
+                1,
+                VIRTIO_NET_HDR_GSO_TCPV4 | VIRTIO_NET_HDR_GSO_ECN,
+                1448,
+                34,
+                16,
+            ),
+            &v4,
+            ALL_LEGACY,
+        )
+        .unwrap()
+        .unwrap();
+        assert_eq!((ok.gso_type, ok.gso_size, ok.header_len), (0x81, 1448, 54));
+
+        let v6 = ipv6_frame(IPPROTO_TCP, &tcp(5), 9000);
+        let ok6 = check(
+            vnet(1, VIRTIO_NET_HDR_GSO_TCPV6, 1428, 54, 16),
+            &v6,
+            ALL_LEGACY,
+        )
+        .unwrap()
+        .unwrap();
+        assert_eq!((ok6.csum_start, ok6.header_len), (54, 74));
+
+        assert_eq!(
+            check(
+                vnet(1, VIRTIO_NET_HDR_GSO_TCPV4, 1428, 54, 16),
+                &v6,
+                ALL_LEGACY
+            ),
+            Err(OffloadRejection::GsoMismatch)
+        );
+        assert_eq!(
+            check(
+                vnet(1, VIRTIO_NET_HDR_GSO_TCPV6, 1448, 34, 16),
+                &v4,
+                ALL_LEGACY
+            ),
+            Err(OffloadRejection::GsoMismatch)
+        );
+        assert_eq!(
+            check(
+                vnet(1, VIRTIO_NET_HDR_GSO_TCPV4, 0, 34, 16),
+                &v4,
+                ALL_LEGACY
+            ),
+            Err(OffloadRejection::BadGsoSize)
+        );
+        let udp = ipv4_frame(5, IPPROTO_UDP, &[0u8; 8], 9000);
+        assert_eq!(
+            check(
+                vnet(1, VIRTIO_NET_HDR_GSO_TCPV4, 1448, 34, 6),
+                &udp,
+                ALL_LEGACY
+            ),
+            Err(OffloadRejection::GsoMismatch)
+        );
+    }
+
+    #[test]
+    fn gso_shapes_refused() {
+        let frame = ipv4_frame(5, IPPROTO_UDP, &[0u8; 8], 9000);
+        for (flags, gso) in [
+            (1, VIRTIO_NET_HDR_GSO_UDP),
+            (0, VIRTIO_NET_HDR_GSO_TCPV4),
+            (1, VIRTIO_NET_HDR_GSO_ECN),
+            (1, 2),
+            (1, 5),
+            (1, 0x7f),
