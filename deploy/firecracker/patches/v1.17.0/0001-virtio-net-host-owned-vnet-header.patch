+        // Fragments.
+        let mut f = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 10);
+        f[ETH_HLEN + 6] = 0x20; // MF
+        assert_eq!(
+            check(hdr, &f, ALL_LEGACY),
+            Err(OffloadRejection::BadIpv4Header)
+        );
+        let mut f = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 10);
+        f[ETH_HLEN + 7] = 1; // offset
+        assert_eq!(
+            check(hdr, &f, ALL_LEGACY),
+            Err(OffloadRejection::BadIpv4Header)
+        );
+        // IP total length beyond the frame, or shorter than the headers.
+        let mut f = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 10);
+        f[ETH_HLEN + 2..ETH_HLEN + 4].copy_from_slice(&1000u16.to_be_bytes());
+        assert_eq!(
+            check(hdr, &f, ALL_LEGACY),
+            Err(OffloadRejection::BadIpLength)
+        );
+        let mut f = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 10);
+        f[ETH_HLEN + 2..ETH_HLEN + 4].copy_from_slice(&30u16.to_be_bytes());
+        assert_eq!(
+            check(hdr, &f, ALL_LEGACY),
+            Err(OffloadRejection::BadIpLength)
+        );
+        // Trailing Ethernet padding is fine.
+        let mut f = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 0);
+        f.extend_from_slice(&[0u8; 6]);
+        assert!(check(hdr, &f, ALL_LEGACY).unwrap().is_some());
+        // TCP data offset below 5.
+        let mut t = tcp(5);
+        t[12] = 4 << 4;
+        let f = ipv4_frame(5, IPPROTO_TCP, &t, 10);
+        assert_eq!(
+            check(hdr, &f, ALL_LEGACY),
+            Err(OffloadRejection::BadTcpHeader)
+        );
+        // ICMP.
+        let f = ipv4_frame(5, 1, &[0u8; 8], 10);
+        assert_eq!(
+            check(hdr, &f, ALL_LEGACY),
+            Err(OffloadRejection::UnsupportedL4)
+        );
+        // VLAN tag, ARP.
+        let mut f = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 10);
+        f[12..14].copy_from_slice(&0x8100u16.to_be_bytes());
+        assert_eq!(
+            check(hdr, &f, ALL_LEGACY),
+            Err(OffloadRejection::UnsupportedL3)
+        );
+        // IPv6 extension header.
+        let f = ipv6_frame(0, &tcp(5), 10);
+        assert_eq!(
+            check(vnet(1, 0, 0, 54, 16), &f, ALL_LEGACY),
+            Err(OffloadRejection::BadIpv6Header)
+        );
+        // Truncated frames.
+        let f = ipv4_frame(5, IPPROTO_TCP, &tcp(5), 0);
+        for cut in [0, 13, 20, 33, 40, 53] {
+            assert_eq!(
+                check(hdr, &f[..cut], ALL_LEGACY),
+                Err(OffloadRejection::Truncated),
+                "cut {cut}"
+            );
+        }
+    }
+
+    #[test]
+    fn largest_headers_fit_the_host_copy() {
+        let f = ipv4_frame(15, IPPROTO_TCP, &tcp(15), 1000);
+        let got = check(vnet(1, 0, 0, 74, 16), &f, ALL_LEGACY)
+            .unwrap()
+            .unwrap();
+        assert_eq!(usize::from(got.header_len), LEGACY_HEADER_COPY_LEN);
+    }
+
+    #[test]
+    fn exhaustive_small_fuzz_never_places_checksum_outside_transport() {
+        // Any accepted offload must put the checksum field inside the
+        // transport header the host parsed.
+        let frames = [
+            ipv4_frame(5, IPPROTO_TCP, &tcp(5), 64),
+            ipv4_frame(7, IPPROTO_UDP, &[0u8; 8], 64),
+            ipv6_frame(IPPROTO_TCP, &tcp(10), 64),
+            ipv6_frame(IPPROTO_UDP, &[0u8; 8], 64),
+        ];
+        for frame in &frames {
+            for start in 0u16..140 {
+                for offset in 0u16..24 {
+                    if let Ok(Some(v)) = check(vnet(1, 0, 0, start, offset), frame, ALL_LEGACY) {
+                        assert!(v.csum_start >= 34);
+                        assert!(v.csum_start + v.csum_offset + 2 <= v.header_len);
+                    }
+                }
+            }
+        }
+    }
+}
