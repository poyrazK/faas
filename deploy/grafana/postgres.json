    {
      "id": 24,
      "type": "timeseries",
      "title": "Collector freshness",
      "description": "Seconds since faas-postgres-activity-metrics last wrote, and failing sections.",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 67
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - max(faas_postgres_activity_metrics_last_run_timestamp_seconds)",
          "legendFormat": "age",
          "refId": "A"
        },
        {
          "expr": "faas_postgres_activity_metrics_errors == 1",
          "legendFormat": "failing: {{section}}",
