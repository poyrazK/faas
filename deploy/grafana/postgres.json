    {
      "id": 23,
      "type": "timeseries",
      "title": "Temp files and deadlocks",
      "description": "Bytes spilled to temporary files per second, and deadlocks in 15 minutes.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 59
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(faas_postgres_temp_bytes_total[5m]))",
          "legendFormat": "temp bytes/s",
          "refId": "A"
        },
        {
          "expr": "sum(increase(faas_postgres_deadlocks_total[15m]))",
          "legendFormat": "deadlocks (15m)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 0
          }
        },
