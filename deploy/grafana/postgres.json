        "h": 8,
        "w": 8,
        "x": 8,
        "y": 59
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (by) (rate(faas_postgres_buffers_written_total[5m]))",
          "legendFormat": "{{by}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
