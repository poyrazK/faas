      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Collector freshness",
      "description": "Seconds since faas-cgroup-metrics last wrote on each host; FaasCgroupMetricsStale fires above 300.",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - faas_cgroup_metrics_last_run_timestamp_seconds",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
