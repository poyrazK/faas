    {
      "type": "timeseries",
      "title": "Prompt-cache reads per written token (1h)",
      "id": 32,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 108},
      "description": "Cached input tokens read per token written to the cache, for integrations that write. A 5-minute Claude cache write costs 1.25x input and a read 0.1x, so caching saves money above about 0.28 (the threshold line) and costs money below it. ADR-1437.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (integration_id) (rate(outbound_ai_tokens_total{kind=\"cached_input\"}[1h])) / (sum by (integration_id) (rate(outbound_ai_tokens_total{kind=\"cache_write\"}[1h])) > 0)", "legendFormat": "{{integration_id}}", "refId": "A"}
