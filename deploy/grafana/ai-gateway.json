      "description": "Moderation checks of requests before they reach the provider: passed, flagged, blocked or error. Response moderation is counted with the response checks. ADR-1340.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (result) (rate(outbound_ai_moderation_total[5m]))", "legendFormat": "{{result}}", "refId": "A"}
