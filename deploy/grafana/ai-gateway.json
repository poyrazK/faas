      "targets": [
        {"expr": "sum by (kind, action) (increase(outbound_ai_response_findings_total[1h]))", "legendFormat": "{{kind}} {{action}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
