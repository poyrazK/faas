    {
      "type": "timeseries",
      "title": "Customer-priced AI cost (USD per hour)",
      "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "description": "Settled cost from customer price lists, rounded up per call. Millicents per second times 3600 / 100000 gives dollars per hour. ADR-990.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (integration_id) (rate(outbound_ai_cost_millicents_total[15m])) * 3600 / 100000", "legendFormat": "{{integration_id}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "currencyUSD"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "AI time to first byte p50 / p95",
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "description": "Gateway-observed time from the provider request to its first response byte. ADR-988.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(outbound_ai_time_to_first_byte_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(outbound_ai_time_to_first_byte_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "AI budget and guardrail rejections (5m)",
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "description": "Calls refused before reaching the provider: token and cost hard caps, per-minute limits, per-app guardrails, end-user limits (ADR-994), tag cost limits (ADR-1436) and unmetered writes (ADR-1432). ADR-990, ADR-991.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (reason) (rate(outbound_rejections_total{reason=~\"daily_token_limit|daily_cost_limit|monthly_cost_limit|requests_per_minute_limit|tokens_per_minute_limit|user_daily_token_limit|user_daily_cost_limit|user_tracking_full|tag_daily_cost_limit|outbound_ai_.*\"}[5m]))", "legendFormat": "{{reason}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
    {
      "type": "timeseries",
      "title": "AI budget alerts (1h)",
