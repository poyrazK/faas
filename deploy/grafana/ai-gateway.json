      "title": "Moderation checks that failed (15m)",
      "id": 22,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 74},
      "description": "Request and response moderation checks that failed. They usually come from a customer's check integration (a cap reached, a provider outage); most request checks failing points at the gateway (FaasAIGatewayModerationFailing). Customer-managed integrations share one integration_id label, so this is not split by integration. ADR-1340, ADR-1435.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(increase(outbound_ai_moderation_total{result=\"error\"}[15m]))", "legendFormat": "request", "refId": "A"},
        {"expr": "sum(increase(outbound_ai_response_checks_total{result=\"error\"}[15m]))", "legendFormat": "response", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}
    },
