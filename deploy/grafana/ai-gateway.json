      "id": 31,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 108},
      "description": "Breakpoints automatic prompt caching added to Claude requests: prefix (a repeated system prompt and tool list) or conversation (earlier turns). ADR-1437.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum by (mark) (rate(outbound_ai_prompt_cache_marks_total[5m]))", "legendFormat": "{{mark}}", "refId": "A"}
