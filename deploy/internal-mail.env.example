# Internal-only experiment. All runtime flags default OFF.
FAAS_INTERNAL_MAIL_ENABLED=0
FAAS_INTERNAL_MAIL_EVENT_FEED_ENABLED=0
FAAS_INTERNAL_MAIL_PRODUCER_SCHEDULING_ENABLED=0
FAAS_INTERNAL_MAIL_PRODUCER_LIFECYCLE_ENABLED=0
FAAS_INTERNAL_MAIL_ENCRYPTION_ROTATION_ENABLED=0
FAAS_INTERNAL_MAIL_SUPPRESSION_CONTROLS_ENABLED=0
FAAS_INTERNAL_MAIL_RECOVERY_ENABLED=0
FAAS_INTERNAL_MAIL_DELIVERY_ENABLED=0
FAAS_INTERNAL_MAIL_REPORTS_ENABLED=0
FAAS_INTERNAL_MAIL_FEEDBACK_ENABLED=0
FAAS_INTERNAL_MAIL_RETENTION_ENABLED=0
FAAS_INTERNAL_MAIL_OPERATIONS_ENABLED=0
FAAS_INTERNAL_MAIL_DELIVERY_CONTROLS_ENABLED=0
FAAS_INTERNAL_MAIL_PRODUCERS_ENABLED=0
FAAS_INTERNAL_MAIL_SCHEDULING_ENABLED=0
FAAS_INTERNAL_MAIL_DOMAIN_PACING_ENABLED=0
FAAS_INTERNAL_MAIL_RELAY_BACKPRESSURE_ENABLED=0
FAAS_INTERNAL_MAIL_REPUTATION_ENABLED=0
# Minimum interval between submission reservations for the same exact recipient
# domain and namespace. Read only when domain pacing is enabled; range 1..300.
FAAS_INTERNAL_MAIL_DOMAIN_PACING_INTERVAL_SECONDS=5
FAAS_INTERNAL_MAIL_DKIM_ROTATION_ENABLED=0
FAAS_INTERNAL_MAIL_DOMAIN_REVERIFY_ENABLED=0
# Separate operator-only token; required only when operations are enabled.
# Also provision it in /etc/faas/mail-operations/operator.env for mailctl.
FAAS_INTERNAL_MAIL_OPERATIONS_TOKEN=
# Even after enabling retention, previews are the default. Explicit 0 permits
# payload pruning after all recipients have been terminal for the quiet period.
FAAS_INTERNAL_MAIL_RETENTION_DRY_RUN=1
FAAS_INTERNAL_MAIL_RETENTION_DAYS=7
FAAS_INTERNAL_MAIL_RETENTION_BATCH_SIZE=25
# Private JSON enrollment array; see docs/ops/internal-mail.md. Each feed needs
# a distinct token, exact DKIM domains, report sender mailboxes, recipient
# domains, and dsn/arf formats.
FAAS_INTERNAL_MAIL_FEEDBACK_SOURCES='[]'
# Read only with the producer gate enabled; enroll real approved callers in the
# private EnvironmentFile. Each producer needs a distinct random token, exact
# From mailboxes and positive budgets. Optional dispatch_per_minute defaults to
# 10 (range 1..100); enforced only with producer scheduling. Empty denies startup.
# Optional replacement_token stages a fresh distinct secret. It grants no access
# until audited activation with the producer lifecycle gate explicitly enabled.
FAAS_INTERNAL_MAIL_PRODUCERS='[]'
FAAS_INTERNAL_MAIL_NAMESPACE=platform
# Empty denies message admission. Supply only explicitly approved pilot inboxes,
# comma-separated exact bare addresses; wildcards and domains are rejected.
FAAS_INTERNAL_MAIL_ALLOWED_RECIPIENTS=
FAAS_INTERNAL_MAIL_DAILY_RECIPIENT_LIMIT=10
FAAS_INTERNAL_MAIL_SOCKET=/run/faas/maild.sock
# Required when enabled: at least 32 random bytes, no whitespace.
FAAS_INTERNAL_MAIL_TOKEN=
# Separate report-only credential, required when reports are enabled. Also
# provide it to the Postfix helper in its own private bridge.env.
FAAS_INTERNAL_MAIL_REPORT_TOKEN=
# systemd supplies the dedicated identity through LoadCredential. Set the path
# explicitly when running a development binary outside systemd.
# FAAS_INTERNAL_MAIL_AGE_IDENTITY_PATH=/private/path/mail.age
# Optional private JSON keyring; read keys must remain configured after rotation,
# including with rotation management off. Paths refer to LoadCredential files.
# FAAS_INTERNAL_MAIL_KEYRING_PATH=/run/credentials/faas-maild.service/mail_keyring
# The actual source IP used by the Gregale-managed SMTP relay:
FAAS_INTERNAL_MAIL_SENDING_IP=
# Only numeric loopback addresses are accepted. No external provider is used.
FAAS_INTERNAL_MAIL_SMTP_ADDR=127.0.0.1:2525
# Keep FAAS_MAIL_TRANSPORT unchanged. Opting platform notifications into this
# service separately selects internal-producer with a scoped caller credential
# (see internal-mail/producer.env.example), or legacy internal with the full
# service token. Both require explicit gates, a socket and FAAS_MAIL_FROM.

# For a restore only: fresh external UUID, required with the recovery gate.
# Retain for normal restarts; generate a new ID for every subsequent restore.
# FAAS_INTERNAL_MAIL_RECOVERY_ID=

# Optional apid account-deletion handoff and private operator inspection.
FAAS_INTERNAL_MAIL_PRODUCER_OUTBOX_ENABLED=0
# Private receipt inspection and local apid acknowledgement; never resends mail.
FAAS_INTERNAL_MAIL_OUTBOX_RECONCILIATION_ENABLED=0

# Separately gated encrypted verification handoff; disabled by default.
FAAS_INTERNAL_MAIL_VERIFICATION_OUTBOX_ENABLED=0

# Independent internal password-reset handoff; disabled by default.
FAAS_INTERNAL_MAIL_PASSWORD_CHANGED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_PASSWORD_RESET_OUTBOX_ENABLED=0
# Durable magic-link sign-in is a separate internal-only opt-in.
FAAS_INTERNAL_MAIL_MAGIC_LINK_OUTBOX_ENABLED=0
# Separate internal opt-in for atomic MFA recovery alerts.
# Durable MFA removal security alerts remain internal and disabled.
FAAS_INTERNAL_MAIL_MFA_DISABLED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_DISABLE_OUTBOX_ENABLED=0
# Durable subscription-ended confirmations remain internal and disabled.
# Durable deployment-failure notices remain internal and disabled.
FAAS_INTERNAL_MAIL_DEPLOYMENT_FAILED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_SUBSCRIPTION_ENDED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_QUOTA_WARNING_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_NONPAYMENT_DELETION_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_ACCOUNT_SUSPENDED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_ACCOUNT_RESTORED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_PAYMENT_FAILED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_ENABLED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_RECOVERY_ALERT_OUTBOX_ENABLED=0
