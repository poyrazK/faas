# Operator-owned private environment, e.g. /etc/faas/mail-operations/operator.env.
# Install as root:faas 0640 in a root:faas 0750 directory. No service, report,
# feedback credentials, database URL, or age identity belong in this file.
FAAS_INTERNAL_MAIL_ENABLED=0
FAAS_INTERNAL_MAIL_EVENT_FEED_ENABLED=0
FAAS_INTERNAL_MAIL_PRODUCER_SCHEDULING_ENABLED=0
FAAS_INTERNAL_MAIL_PRODUCER_LIFECYCLE_ENABLED=0
FAAS_INTERNAL_MAIL_ENCRYPTION_ROTATION_ENABLED=0
FAAS_INTERNAL_MAIL_SUPPRESSION_CONTROLS_ENABLED=0
FAAS_INTERNAL_MAIL_RECOVERY_ENABLED=0
FAAS_INTERNAL_MAIL_OPERATIONS_ENABLED=0
FAAS_INTERNAL_MAIL_DELIVERY_CONTROLS_ENABLED=0
FAAS_INTERNAL_MAIL_RELAY_BACKPRESSURE_ENABLED=0
FAAS_INTERNAL_MAIL_REPUTATION_ENABLED=0
FAAS_INTERNAL_MAIL_DKIM_ROTATION_ENABLED=0
FAAS_INTERNAL_MAIL_DOMAIN_REVERIFY_ENABLED=0
FAAS_INTERNAL_MAIL_SOCKET=/run/faas/maild.sock
FAAS_INTERNAL_MAIL_OPERATIONS_TOKEN=

# Optional apid account-deletion handoff and private operator inspection.
FAAS_INTERNAL_MAIL_PRODUCER_OUTBOX_ENABLED=0
# Private receipt inspection and local apid acknowledgement; never resends mail.
FAAS_INTERNAL_MAIL_OUTBOX_RECONCILIATION_ENABLED=0

# Separately gated encrypted verification handoff; disabled by default.
FAAS_INTERNAL_MAIL_VERIFICATION_OUTBOX_ENABLED=0

# Independent internal password-reset handoff; disabled by default.
FAAS_INTERNAL_MAIL_PASSWORD_CHANGED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_PASSWORD_RESET_OUTBOX_ENABLED=0
# Durable magic-link sign-in is a separate internal-only opt-in.
FAAS_INTERNAL_MAIL_MAGIC_LINK_OUTBOX_ENABLED=0
# Separate internal opt-in for atomic MFA recovery alerts.
# Private durable MFA disable requests; keep off until separately qualified.
# Durable MFA removal security alerts remain internal and disabled.
FAAS_INTERNAL_MAIL_MFA_DISABLED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_DISABLE_OUTBOX_ENABLED=0
# Durable subscription-ended confirmations remain internal and disabled.
# Durable deployment-failure notices remain internal and disabled.
FAAS_INTERNAL_MAIL_DEPLOYMENT_FAILED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_SUBSCRIPTION_ENDED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_QUOTA_WARNING_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_NONPAYMENT_DELETION_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_ACCOUNT_SUSPENDED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_ACCOUNT_RESTORED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_PAYMENT_FAILED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_ENABLED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_RECOVERY_ALERT_OUTBOX_ENABLED=0
