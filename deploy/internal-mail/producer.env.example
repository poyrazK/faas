# Private EnvironmentFile for one approved internal notification caller.
# The selected transport fails closed until both gates are explicitly enabled.
FAAS_MAIL_TRANSPORT=internal-producer
FAAS_INTERNAL_MAIL_ENABLED=0
FAAS_INTERNAL_MAIL_EVENT_FEED_ENABLED=0
FAAS_INTERNAL_MAIL_PRODUCERS_ENABLED=0
FAAS_INTERNAL_MAIL_SCHEDULING_ENABLED=0
FAAS_INTERNAL_MAIL_SOCKET=/run/faas/maild.sock
# Stable ID and independent credential enrolled in maild's private configuration.
FAAS_INTERNAL_MAIL_PRODUCER_ID=
FAAS_INTERNAL_MAIL_PRODUCER_TOKEN=
FAAS_MAIL_FROM=

# Optional apid account-deletion handoff and private operator inspection.
FAAS_INTERNAL_MAIL_PRODUCER_OUTBOX_ENABLED=0
# Private receipt inspection and local apid acknowledgement; never resends mail.
FAAS_INTERNAL_MAIL_OUTBOX_RECONCILIATION_ENABLED=0
# If enabled on apid, master + producer + scheduling flags must also be 1.
# Pin this to the matching maild namespace while any intent is pending.
FAAS_INTERNAL_MAIL_NAMESPACE=platform

# Separately gated encrypted verification handoff; disabled by default.
FAAS_INTERNAL_MAIL_VERIFICATION_OUTBOX_ENABLED=0
# Required only on an opted-in apid; use the trusted verification API origin.
# FAAS_INTERNAL_MAIL_VERIFICATION_ORIGIN=https://api.example.test
# Dedicated current/previous identities are apid-only LoadCredentials.

# Independent internal password-reset handoff; disabled by default.
FAAS_INTERNAL_MAIL_PASSWORD_CHANGED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_PASSWORD_RESET_OUTBOX_ENABLED=0
# Durable magic-link sign-in is a separate internal-only opt-in.
FAAS_INTERNAL_MAIL_MAGIC_LINK_OUTBOX_ENABLED=0
# Separate internal opt-in for atomic MFA recovery alerts.
# Private durable MFA disable requests; keep off until separately qualified.
# Durable MFA removal security alerts remain internal and disabled.
FAAS_INTERNAL_MAIL_MFA_DISABLED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_DISABLE_OUTBOX_ENABLED=0
# Durable subscription-ended confirmations remain internal and disabled.
# Durable deployment-failure notices remain internal and disabled.
FAAS_INTERNAL_MAIL_DEPLOYMENT_FAILED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_SUBSCRIPTION_ENDED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_QUOTA_WARNING_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_NONPAYMENT_DELETION_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_ACCOUNT_SUSPENDED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_ACCOUNT_RESTORED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_PAYMENT_FAILED_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_ENABLED_ALERT_OUTBOX_ENABLED=0
FAAS_INTERNAL_MAIL_MFA_RECOVERY_ALERT_OUTBOX_ENABLED=0
# Enabled apid only: canonical dashboard origin, separate from verification.
# FAAS_INTERNAL_MAIL_PASSWORD_RESET_ORIGIN=https://dashboard.example.test
# FAAS_INTERNAL_MAIL_MAGIC_LINK_ORIGIN=https://dashboard.example.test
# Reuses the dedicated apid verification identity current/previous credentials.

# FAAS_INTERNAL_MAIL_MFA_DISABLE_ORIGIN=https://dashboard.example.test

# Suspension-command credential path for apid only; meterd receives the same path
# through /etc/faas/secrets/meterd/billing.env. Read only with its own flag enabled.
# FAAS_INTERNAL_MAIL_SUSPENSION_TOKEN_PATH=/etc/faas/secrets/internal-mail/suspension.token

# Dedicated non-payment deletion credential path shared only by apid and meterd.
# FAAS_INTERNAL_MAIL_NONPAYMENT_DELETION_TOKEN_PATH=/etc/faas/secrets/internal-mail/nonpayment-deletion.token

# Dedicated daily quota warning credential shared only by apid and meterd.
# FAAS_INTERNAL_MAIL_QUOTA_WARNING_TOKEN_PATH=/etc/faas/secrets/internal-mail/quota-warning.token
# Optional RFC 8058 URL is frozen by apid into each encrypted quota snapshot.
# FAAS_NOTIFICATIONS_UNSUBSCRIBE_URL=https://dashboard.example.test/notifications/unsubscribe
