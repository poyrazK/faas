# POSIX shell assignments, loaded only by the root-owned Postfix pipe wrapper.
# Install as /etc/faas/mail-reports/bridge.env (root:faas, 0440).
FAAS_INTERNAL_MAIL_ENABLED=0
FAAS_INTERNAL_MAIL_REPORTS_ENABLED=0
FAAS_INTERNAL_MAIL_RELAY_BACKPRESSURE_ENABLED=0
# Read by mail-metrics only when backpressure is explicitly enabled. This must
# match maild's fixed numeric loopback relay, never an Internet SMTP address.
FAAS_INTERNAL_MAIL_SMTP_ADDR=127.0.0.1:2525
FAAS_INTERNAL_MAIL_SOCKET=/run/faas/maild.sock
# Match maild's separate telemetry credential (reports and aggregate metrics).
# Do not put the full service
# token, database URL, or encryption identity in this file.
FAAS_INTERNAL_MAIL_REPORT_TOKEN=
