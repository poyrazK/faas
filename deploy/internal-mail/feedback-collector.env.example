# Private environment for one operator-managed durable feedback collector.
# Preserve original MIME bytes and retain input until mail-feedback exits zero.
# Keep root-owned, mode 0440, readable only by the collector's service group.
FAAS_INTERNAL_MAIL_ENABLED=0
FAAS_INTERNAL_MAIL_FEEDBACK_ENABLED=0
FAAS_INTERNAL_MAIL_SOCKET=/run/faas/maild.sock
FAAS_INTERNAL_MAIL_FEEDBACK_SOURCE=
# Match this source's enrollment in maild.env. Never use a service/report token.
FAAS_INTERNAL_MAIL_FEEDBACK_TOKEN=
