+package gateway
+
+import (
+	"context"
+	"io"
+	"net"
+	"testing"
+	"time"
+
+	"golang.org/x/net/http2"
+	"google.golang.org/grpc"
+)
+
+// The internal bridge starts before runc has mounted and launched a cold
+// frontend. HTTP/2's default ten-second preface timer must not kill it first.
+func TestServeWaitsForColdFrontend(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	finished := make(chan struct{})
+	go func() { serve(ctx, grpc.NewServer(), server); close(finished) }()
+	go func() { _, _ = io.Copy(io.Discard, client) }()
+	time.Sleep(11 * time.Second)
+	select {
+	case <-finished:
+		t.Fatal("bridge closed before the frontend could start")
+	default:
+	}
+	if err := client.SetWriteDeadline(time.Now().Add(2 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := io.WriteString(client, http2.ClientPreface); err != nil {
+		t.Fatal(err)
+	}
+	if err := http2.NewFramer(client, nil).WriteSettings(); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	select {
+	case <-finished:
+	case <-time.After(time.Second):
+		t.Fatal("bridge did not close after cancellation")
+	}
+}
