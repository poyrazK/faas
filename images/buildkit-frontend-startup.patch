 func serve(ctx context.Context, grpcServer *grpc.Server, conn net.Conn) {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
 	go func() {
 		<-ctx.Done()
 		conn.Close()
 	}()
+	// This is a private frontend stdio pipe, opened before runc mounts and
+	// launches the frontend. Do not spend HTTP/2's ten-second preface budget
+	// on container startup. Wait for a complete preface with a bounded minute
+	// and retain buffered bytes for ServeConn to validate and consume.
+	reader := bufio.NewReader(conn)
+	ready := make(chan error, 1)
+	go func() {
+		_, err := reader.Peek(len(http2.ClientPreface))
+		ready <- err
+	}()
+	timer := time.NewTimer(time.Minute)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return
+	case <-timer.C:
+		bklog.G(ctx).Warn("frontend handshake did not start within one minute")
+		return
+	case err := <-ready:
+		if err != nil {
+			bklog.G(ctx).WithError(err).Debug("frontend handshake closed")
+			return
+		}
+	}
 	bklog.G(ctx).Debugf("serving grpc connection")
-	(&http2.Server{}).ServeConn(conn, &http2.ServeConnOpts{Handler: grpcServer})
-}
+	(&http2.Server{}).ServeConn(&frontendBufferedConn{Conn: conn, reader: reader}, &http2.ServeConnOpts{Handler: grpcServer})
+}
+
+type frontendBufferedConn struct {
+	net.Conn
+	reader *bufio.Reader
+}
+
+func (c *frontendBufferedConn) Read(p []byte) (int, error) { return c.reader.Read(p) }
 
