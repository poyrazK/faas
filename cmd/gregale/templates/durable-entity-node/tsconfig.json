{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "handlers.mjs",
    "state.mjs",
    "registry.mjs",
    "contracts.mjs",
    "client.mjs",
    "test/client-types.ts"
  ]
}
