          },
          "expect": {
            "status": 200
          }
        },
        {
          "name": "Control history records verified actor and actions",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_delivery_operations?tenant_id=eq.shop-a&or=(operation_id.eq.{{owner_key}},operation_id.eq.{{order_key}})&order=action&select=actor,action",
