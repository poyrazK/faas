          },
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "Owner resumes with the recorded revision",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/set_team_delivery_pause_once",
          "body": {
            "team_id": "shop-a",
            "operation_id": "{{order_key}}",
            "expected_revision": "{{pause_revision}}",
