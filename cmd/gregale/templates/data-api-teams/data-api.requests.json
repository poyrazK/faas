{
  "version": 2,
  "scenarios": [
    {
      "name": "team-access",
      "requests": [
        {
          "name": "owner reads shared order",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000001&select=id",
          "expect": {
            "status": 200,
            "json": [
              {
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        },
        {
          "name": "owner cannot read other team",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000002",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "member reads shared order",
          "identity": "member",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000001&select=id",
          "expect": {
            "status": 200,
            "json": [
              {
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        },
        {
          "name": "other cannot read shop-a",
          "identity": "other",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000001",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "other cannot save shop-a",
          "identity": "other",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 403
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 0,
            "order_total": 1200,
            "order_state": "draft"
          }
        },
        {
          "name": "outsider cannot read shop-a",
          "identity": "outsider",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000001",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "outsider cannot save shop-a",
          "identity": "outsider",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 403
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 0,
            "order_total": 1200,
            "order_state": "draft"
          }
        },
        {
          "name": "Other reads actual membership despite forged tenant",
          "identity": "other",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000002&select=id",
          "expect": {
            "status": 200,
            "json": [
              {
                "id": "00000000-0000-4000-8000-000000000002"
              }
            ]
          }
        },
        {
          "name": "Member cannot promote self",
          "identity": "member",
          "method": "PATCH",
          "path": "/rest/v1/team_members?subject=eq.ann",
          "expect": {
            "status": 200,
            "json": []
          },
          "body": {
            "role": "owner"
          }
        },
        {
          "name": "Member cannot join other team",
          "identity": "member",
          "method": "POST",
          "path": "/rest/v1/team_members",
          "expect": {
            "status": 403
          },
          "body": {
            "tenant_id": "shop-b",
            "subject": "ann",
            "role": "owner"
          }
        },
        {
          "name": "Membership is unchanged",
          "identity": "member",
          "method": "GET",
          "path": "/rest/v1/team_members?select=tenant_id,role",
          "expect": {
            "status": 200,
            "json": [
              {
                "tenant_id": "shop-a",
                "role": "member"
              }
            ]
          }
        },
        {
          "name": "Read-only member cannot save",
          "identity": "member",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 403
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 0,
            "order_total": 1200,
            "order_state": "draft"
          }
        },
        {
          "name": "REST cannot bypass save scope",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/team_orders",
          "expect": {
            "status": 403
          },
          "body": {
            "id": "00000000-0000-4000-8000-000000000003",
            "tenant_id": "shop-a",
            "created_by": "alice",
            "total_cents": 0
          }
        },
        {
          "name": "REST update cannot bypass version check",
          "identity": "owner",
          "method": "PATCH",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000001",
          "expect": {
            "status": 200,
            "json": []
          },
          "body": {
            "total_cents": 0
          }
        },
        {
          "name": "Receipts cannot be read directly",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_order_receipts",
          "expect": {
            "status": 200,
            "json": []
          }
        }
      ]
    },
    {
      "name": "order-saves",
      "requests": [
        {
          "name": "Owner creates",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 200
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 0,
            "order_total": 1200,
            "order_state": "draft"
          }
        },
        {
          "name": "Same operation replays",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 200
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 0,
            "order_total": 1200,
            "order_state": "draft"
          }
        },
        {
          "name": "Changed payload conflicts",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 409
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 0,
            "order_total": 1300,
            "order_state": "draft"
          }
        },
        {
          "name": "Owner updates expected version",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 200
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000002",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 1,
            "order_total": 1500,
            "order_state": "draft"
          }
        },
        {
          "name": "Update replays without increment",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 200
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000002",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 1,
            "order_total": 1500,
            "order_state": "draft"
          }
        },
        {
          "name": "Stale version conflicts",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 409
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000004",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 1,
            "order_total": 1600,
            "order_state": "draft"
          }
        },
        {
          "name": "Admin independently scopes same key",
          "identity": "admin",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 200
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 2,
            "order_total": 1800,
            "order_state": "draft"
          }
        },
        {
          "name": "Member sees team update",
          "identity": "member",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000003&select=id,total_cents,version",
          "expect": {
            "status": 200,
            "json": [
              {
                "id": "00000000-0000-4000-8000-000000000003",
                "total_cents": 1800,
                "version": 3
              }
            ]
          }
        },
        {
          "name": "Original create receipt survives edits",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/save_team_order_once",
          "expect": {
            "status": 200
          },
          "body": {
            "request_key": "10000000-0000-4000-8000-000000000001",
            "team_id": "shop-a",
            "order_id": "00000000-0000-4000-8000-000000000003",
            "expected_version": 0,
            "order_total": 1200,
            "order_state": "draft"
          }
        },
        {
          "name": "Replay does not revert current order",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000003&select=total_cents,version",
          "expect": {
            "status": 200,
            "json": [
              {
                "total_cents": 1800,
                "version": 3
              }
            ]
          }
        }
      ]
    },
    {
      "name": "team-administration",
      "requests": [
        {
          "name": "Owner loads current member revisions",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/list_team_members",
          "expect": {
            "status": 200
          },
          "body": {
            "team_id": "shop-a"
          },
          "capture": {
            "owner_revision": "/0/revision",
            "admin_revision": "/1/revision",
            "member_revision": "/2/revision"
          }
        },
        {
          "name": "admin cannot list shop-a members",
          "identity": "admin",
          "method": "POST",
          "path": "/rest/v1/rpc/list_team_members",
          "expect": {
            "status": 403
          },
          "body": {
            "team_id": "shop-a"
          }
        },
        {
          "name": "member cannot grant owner access",
          "identity": "member",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 403
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "eve",
            "expected_revision": null,
            "new_role": "owner",
            "request_key": "{{owner_revision}}"
          }
        },
        {
          "name": "other cannot list shop-a members",
          "identity": "other",
          "method": "POST",
          "path": "/rest/v1/rpc/list_team_members",
          "expect": {
            "status": 403
          },
          "body": {
            "team_id": "shop-a"
          }
        },
        {
          "name": "Owner admits registered user",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 200
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "eve",
            "expected_revision": null,
            "new_role": "member",
            "request_key": "{{owner_revision}}"
          },
          "capture": {
            "added_revision": "/0/after_revision"
          }
        },
        {
          "name": "Membership operation replays once",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 200
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "eve",
            "expected_revision": null,
            "new_role": "member",
            "request_key": "{{owner_revision}}"
          }
        },
        {
          "name": "Changed membership payload conflicts",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 409
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "eve",
            "expected_revision": null,
            "new_role": "owner",
            "request_key": "{{owner_revision}}"
          }
        },
        {
          "name": "Added user reads shared orders",
          "identity": "outsider",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000001&select=id",
          "expect": {
            "status": 200,
            "json": [
              {
                "id": "00000000-0000-4000-8000-000000000001"
              }
            ]
          }
        },
        {
          "name": "Owner changes member role",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 200
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "eve",
            "expected_revision": "{{added_revision}}",
            "new_role": "admin",
            "request_key": "{{added_revision}}"
          },
          "capture": {
            "changed_revision": "/0/after_revision"
          }
        },
        {
          "name": "Stale membership revision is refused",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 409
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "eve",
            "expected_revision": "{{added_revision}}",
            "new_role": "owner",
            "request_key": "{{member_revision}}"
          }
        },
        {
          "name": "Owner removes access",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 200
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "eve",
            "expected_revision": "{{changed_revision}}",
            "new_role": null,
            "request_key": "{{changed_revision}}"
          }
        },
        {
          "name": "Removed user cannot read orders",
          "identity": "outsider",
          "method": "GET",
          "path": "/rest/v1/team_orders?id=eq.00000000-0000-4000-8000-000000000001",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "Last owner cannot be demoted",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 409
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "alice",
            "expected_revision": "{{owner_revision}}",
            "new_role": "admin",
            "request_key": "{{admin_revision}}"
          }
        },
        {
          "name": "Last owner cannot be removed",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/change_team_member_once",
          "expect": {
            "status": 409
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "alice",
            "expected_revision": "{{owner_revision}}",
            "new_role": null,
            "request_key": "{{admin_revision}}"
          }
        },
        {
          "name": "Ownership transfers atomically",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/transfer_team_ownership_once",
          "expect": {
            "status": 200
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "amy",
            "expected_revision": "{{admin_revision}}",
            "request_key": "{{admin_revision}}"
          },
          "capture": {
            "former_owner_revision": "/0/actor_after_revision"
          }
        },
        {
          "name": "Former owner resolves transfer receipt",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/get_team_change_receipt?select=action,actor_after_role,after_role",
          "expect": {
            "status": 200,
            "json": [
              {
                "action": "transfer",
                "actor_after_role": "admin",
                "after_role": "owner"
              }
            ]
          },
          "body": {
            "team_id": "shop-a",
            "operation_key": "{{admin_revision}}"
          }
        },
        {
          "name": "Former owner cannot list team members",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/list_team_members",
          "expect": {
            "status": 403
          },
          "body": {
            "team_id": "shop-a"
          }
        },
        {
          "name": "Former owner cannot read history",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_membership_events?tenant_id=eq.shop-a",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "New owner restores original ownership",
          "identity": "admin",
          "method": "POST",
          "path": "/rest/v1/rpc/transfer_team_ownership_once",
          "expect": {
            "status": 200
          },
          "body": {
            "team_id": "shop-a",
            "target_subject": "alice",
            "expected_revision": "{{former_owner_revision}}",
            "request_key": "{{former_owner_revision}}"
          }
        },
        {
          "name": "Owner can audit the immutable admission",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_membership_events?tenant_id=eq.shop-a&request_key=eq.{{owner_revision}}&select=action,target_subject,before_role,after_role",
          "expect": {
            "status": 200,
            "json": [
              {
                "action": "add",
                "target_subject": "eve",
                "before_role": null,
                "after_role": "member"
              }
            ]
          }
        },
        {
          "name": "Another tenant cannot read audit history",
          "identity": "other",
          "method": "GET",
          "path": "/rest/v1/team_membership_events?tenant_id=eq.shop-a",
          "expect": {
            "status": 200,
            "json": []
          }
        },
        {
          "name": "Audit cannot be modified through REST",
          "identity": "owner",
          "method": "PATCH",
          "path": "/rest/v1/team_membership_events?tenant_id=eq.shop-a",
          "expect": {
            "status": 200,
            "json": []
          },
          "body": {
            "after_role": "owner"
          }
        },
        {
          "name": "User registry cannot be forged",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/team_users",
          "expect": {
            "status": 403
          },
          "body": {
            "subject": "unverified-user"
          }
        },
        {
          "name": "Roles return to the fixture baseline",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/list_team_members?select=subject,role",
          "expect": {
            "status": 200,
            "json": [
              {
                "subject": "alice",
                "role": "owner"
              },
              {
                "subject": "amy",
                "role": "admin"
              },
              {
                "subject": "ann",
                "role": "member"
              }
            ]
          },
          "body": {
            "team_id": "shop-a"
          }
        }
      ]
    },
    {
      "name": "team-invitations",
      "requests": [
        {
          "name": "Owner captures fresh invitation operation key",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_members?tenant_id=eq.shop-a&subject=eq.alice&select=revision",
          "expect": {
            "status": 200
          },
          "capture": {
            "invite_key": "/0/revision"
          }
        },
        {
          "name": "Owner captures disposable fixture expiry",
          "identity": "owner",
          "method": "GET",
          "path": "/rest/v1/team_invitations?invitation_id=eq.90000000-0000-4000-8000-000000000001&select=expires_at",
          "expect": {
            "status": 200
          },
          "capture": {
            "invite_expiry": "/0/expires_at"
          }
        },
        {
          "name": "Nonowner cannot create invite",
          "identity": "member",
          "method": "POST",
          "path": "/rest/v1/rpc/create_team_invitation_once",
          "expect": {
            "status": 403
          },
          "body": {
            "operation_id": "{{invite_key}}",
            "team_id": "shop-a",
            "invite_secret": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "invite_role": "member",
            "valid_until": "{{invite_expiry}}"
          }
        },
        {
          "name": "Owner role cannot be invited",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/create_team_invitation_once",
          "expect": {
            "status": 400
          },
          "body": {
            "operation_id": "{{invite_key}}",
            "team_id": "shop-a",
            "invite_secret": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "invite_role": "owner",
            "valid_until": "{{invite_expiry}}"
          }
        },
        {
          "name": "Owner creates member invite",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/create_team_invitation_once?select=invited_role",
          "expect": {
            "status": 200,
            "json": [
              {
                "invited_role": "member"
              }
            ]
          },
          "body": {
            "operation_id": "{{invite_key}}",
            "team_id": "shop-a",
            "invite_secret": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "invite_role": "member",
            "valid_until": "{{invite_expiry}}"
          }
        },
        {
          "name": "Same creation key is replayable",
          "identity": "owner",
          "method": "POST",
          "path": "/rest/v1/rpc/create_team_invitation_once?select=invited_role",
          "expect": {
            "status": 200,
            "json": [
              {
                "invited_role": "member"
              }
            ]
          },
          "body": {
            "operation_id": "{{invite_key}}",
            "team_id": "shop-a",
            "invite_secret": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "invite_role": "member",
            "valid_until": "{{invite_expiry}}"
          }
        },
        {
