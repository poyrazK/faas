  {
    "id": "day2-config-change",
    "title": "Change live configuration without editing code",
    "template": "hello-node",
    "setup": [
      {"kind": "replace", "file": "handler.js", "old": "    message: \"hello from gregale\",", "new": "    message: process.env.GREETING || \"hello from gregale\","},
      {"kind": "deploy"}
    ],
    "prompt": "The app {app} on Gregale reads its greeting from the GREETING environment variable. Change the live greeting to day2-config without editing any files, and confirm the app serves it.",
    "checks": [
      {"kind": "http", "path": "/", "status": 200, "contains": "day2-config"},
      {"kind": "file_contains", "file": "handler.js", "text": "process.env.GREETING"}
    ],
    "features": [
      {"id": "env-set", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*\\b(env|secrets?)\\s+(set|push)\\b"}
    ],
    "budget_usd": 3.0,
    "timeout_s": 900
  },
  {
    "id": "day2-schedule",
    "title": "Schedule a recurring request to an app",
    "template": "hello-node",
    "setup": [{"kind": "deploy"}],
    "prompt": "Have Gregale call POST /tick on the app {app} every 15 minutes, starting now. The endpoint does not exist yet: add it so it answers 200, deploy, and show me the schedule.",
    "checks": [
      {"kind": "http", "path": "/healthz", "status": 200},
      {"kind": "cli_output", "args": ["cron", "list", "--app", "{app}"], "patterns": ["/tick", "(\\*/15|15m|15 ?min)"]},
      {"kind": "file_contains", "file": "handler.js", "text": "/tick"}
    ],
    "features": [
      {"id": "cron-create", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*\\bcron\\s+create\\b"}
    ],
    "budget_usd": 3.0,
    "timeout_s": 1200
  },
  {
    "id": "day2-no-cold-start",
    "title": "Remove cold starts and state the cost",
    "template": "hello-node",
    "setup": [{"kind": "deploy"}],
    "prompt": "Users say the first request to {app} after it has been idle is slow. Make it respond quickly at all times, and tell me what that will cost per month.",
    "checks": [
      {"kind": "app_field", "field": "min_instances", "min": 1},
      {"kind": "http", "path": "/", "status": 200, "contains": "hello from gregale"},
      {"kind": "answer", "pattern": "(\\$|usd|gb-?h)"}
    ],
    "budget_usd": 3.0,
    "timeout_s": 900
  }
]
