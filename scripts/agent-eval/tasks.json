[
  {
    "id": "deploy-starter",
    "title": "Deploy a project and confirm it serves",
    "template": "hello-node",
    "setup": [],
    "prompt": "Deploy the project in this directory to Gregale as a new app named {app}. When it is live, confirm that its URL responds and report the URL.",
    "checks": [
      {"kind": "http", "path": "/", "status": 200, "contains": "hello from gregale"}
    ],
    "budget_usd": 3.0,
    "timeout_s": 900
  },
  {
    "id": "fix-failed-deploy",
    "title": "Find why a deploy fails, fix the code and redeploy",
    "template": "hello-node",
    "setup": [
      {"kind": "replace", "file": "handler.js", "old": "import express from \"express\";", "new": "import express from \"express\";\nimport { settings } from \"./settings.js\";"}
    ],
    "prompt": "Deploy the project in this directory to Gregale as the app {app}. If the deployment fails, use Gregale to find out why, fix the code, and deploy again until the app serves. Report the cause in one sentence.",
    "checks": [
      {"kind": "http", "path": "/", "status": 200, "contains": "hello from gregale"}
    ],
    "budget_usd": 4.0,
    "timeout_s": 1500
  },
  {
    "id": "rollback-bad-release",
    "title": "Restore service after a bad release without editing code",
    "template": "hello-node",
    "setup": [
      {"kind": "deploy"},
      {"kind": "replace", "file": "handler.js", "old": "  res.json({\n    message: \"hello from gregale\",", "new": "  res.status(500).json({\n    message: \"broken release\","},
      {"kind": "deploy"}
    ],
    "prompt": "The app {app} on Gregale started returning errors on / after its latest release. Restore service without editing any files, then report what you did.",
    "checks": [
      {"kind": "http", "path": "/", "status": 200, "contains": "hello from gregale"},
      {"kind": "file_contains", "file": "handler.js", "text": "broken release"},
      {"kind": "serving", "expect": "not_latest"}
    ],
    "budget_usd": 3.0,
    "timeout_s": 900
  },
  {
    "id": "diagnose-failure",
    "title": "Name the root cause of a failed deploy without changing anything",
    "template": "hello-node",
    "setup": [
      {"kind": "replace", "file": "handler.js", "old": "import express from \"express\";", "new": "import express from \"express\";\nimport { settings } from \"./settings.js\";"},
      {"kind": "deploy", "expect": "failure"}
    ],
    "prompt": "The latest deployment of the app {app} on Gregale failed. Find the root cause using Gregale and explain it in one sentence. Do not change any files or deploy anything.",
    "checks": [
      {"kind": "answer", "pattern": "settings\\.js|ERR_MODULE_NOT_FOUND|Cannot find module"},
      {"kind": "file_contains", "file": "handler.js", "text": "./settings.js"}
    ],
    "budget_usd": 2.0,
    "timeout_s": 600
  },
  {
    "id": "deploy-retail-store",
    "title": "Deploy a foreign five-service Compose repo from the owner's own words",
    "repo": {"url": "https://github.com/aws-containers/retail-store-sample-app", "commit": "d7a380b843e0759e58754f74188ea18252a51415"},
    "prompt": "Deploy {repo_url} into gregale via gregale cli in this mac, use my already authed account for it. The repository is already cloned in the current directory.",
    "checks": [
      {"kind": "apps_created", "min": 5},
      {"kind": "apps_serving"},
      {"kind": "app_http", "match": "ui", "path": "/", "status": 200},
      {"kind": "app_http", "match": "ui", "path": "/catalog", "status": 200},
      {"kind": "no_traps"}
    ],
    "features": [
      {"id": "deploy-as-project", "kind": "state", "state": "project_created"},
      {"id": "preflight", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*(--dry-run|--diff|\\bdoctor\\b|\\bdeploy\\s+check\\b)"},
      {"id": "diagnose-with-gregale", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*\\b(logs|inspect|health|status|release\\s+(get|logs|timeline|attempt))\\b"},
      {"id": "secrets-through-cli", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*(\\benv\\s+(set|push)\\b|\\bsecrets\\b|--release-secrets-file)"}
    ],
    "follow_up": "Yes, go ahead with what you recommend.",
    "budget_usd": 15.0,
    "timeout_s": 3600
  },
  {
    "id": "deploy-voting-app",
    "title": "Deploy Docker's voting app (Python, Node, .NET worker, Redis, Postgres) from the owner's own words",
    "repo": {"url": "https://github.com/dockersamples/example-voting-app", "commit": "63e9150ca17af4ed05880d4245e486481f73fcb4"},
    "prompt": "Deploy {repo_url} into gregale via gregale cli in this mac, use my already authed account for it. The repository is already cloned in the current directory.",
    "checks": [
      {"kind": "apps_created", "min": 3},
      {"kind": "apps_serving"},
      {"kind": "app_http", "match": "(^|-)vote(-[a-z0-9]{5})?$", "path": "/", "status": 200},
      {"kind": "app_http", "match": "(^|-)result(-[a-z0-9]{5})?$", "path": "/", "status": 200},
      {"kind": "vote_counted"},
      {"kind": "no_traps"}
    ],
    "features": [
      {"id": "deploy-as-project", "kind": "state", "state": "project_created"},
      {"id": "preflight", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*(--dry-run|--diff|\\bdoctor\\b|\\bdeploy\\s+check\\b)"},
      {"id": "diagnose-with-gregale", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*\\b(logs|inspect|health|status|release\\s+(get|logs|timeline|attempt))\\b"},
      {"id": "managed-postgres", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*\\b(add\\s+postgres|postgres\\s+(create|attach))\\b"}
    ],
    "follow_up": "Yes, go ahead with what you recommend.",
    "budget_usd": 10.0,
    "timeout_s": 3600
  },
  {
    "id": "first-hour-private",
    "title": "Deploy and verify a private first app without changing access",
    "template": "hello-node",
    "setup": [],
    "prompt": "Deploy this project to Gregale as a private app named {app}, with required authentication. Verify the exact accepted deployment and its application response without making the app public. Report its deployment UUID, HTTP status and how you tested it.",
    "checks": [
      {
        "kind": "owner_response",
        "path": "/",
        "status": 200,
        "contains": "hello from gregale"
      }
    ],
    "features": [
      {
        "id": "exact-release-verification",
        "kind": "command",
        "pattern": "\\bgregale\\b[^\\n]*\\brelease\\s+verify\\b",
        "tools": ["gregale_verify_application_response"]
      }
    ],
    "budget_usd": 3.0,
    "timeout_s": 1200
  },
  {
    "id": "first-hour-edit",
    "retain_app_identity": true,
    "title": "Edit and redeploy an existing private app",
    "template": "hello-node",
    "setup": [
      {
        "kind": "deploy",
        "private": true
      }
    ],
    "prompt": "The private app {app} is already deployed from this directory. Change its greeting to first-hour-v2, deploy the update to the same app, and verify that exact release serves the new greeting. Keep required authentication enabled. Report the accepted deployment UUID and HTTP status.",
    "checks": [
      {
        "kind": "owner_response",
        "path": "/",
        "status": 200,
        "contains": "first-hour-v2",
        "min_deployments": 2
      },
      {
        "kind": "file_contains",
        "file": "handler.js",
        "text": "first-hour-v2"
      }
    ],
    "features": [
      {
        "id": "exact-release-verification",
        "kind": "command",
        "pattern": "\\bgregale\\b[^\\n]*\\brelease\\s+verify\\b",
        "tools": ["gregale_verify_application_response"]
      }
    ],
    "budget_usd": 4.0,
    "timeout_s": 1500
  },
