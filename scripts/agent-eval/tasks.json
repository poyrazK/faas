  {
    "id": "migrate-django-heroku",
    "title": "Move Heroku's Django getting-started app, whose ALLOWED_HOSTS opens only on Heroku",
    "repo": {"url": "https://github.com/heroku/python-getting-started", "commit": "561bc55e4aaf22f98c040611fd613994547b31bb"},
    "prompt": "This Django app runs on Heroku today. Move it to Gregale with the gregale cli on this mac; my account is already logged in. The repository ({repo_url}) is already cloned in the current directory.",
    "checks": [
      {"kind": "apps_created", "min": 1},
      {"kind": "apps_serving"},
      {"kind": "app_http", "match": ".", "path": "/", "status": 200, "contains": "Getting Started with Python"},
      {"kind": "no_traps"}
    ],
    "features": [
      {"id": "preflight", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*(--dry-run|--diff|--plan|\\bdoctor\\b|\\bdeploy\\s+check\\b)"},
      {"id": "diagnose-with-gregale", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*\\b(logs|inspect|health|status|release\\s+(get|logs|timeline|attempt))\\b"},
      {"id": "secrets-through-cli", "kind": "command", "pattern": "\\bgregale\\b[^\\n]*(\\benv\\s+(set|push)\\b|\\bsecrets\\b|--secrets-file)"},
      {"id": "allowed-hosts-for-gregale", "kind": "file", "glob": "gettingstarted/settings.py", "pattern": "gregale\\.dev|ALLOWED_HOSTS[^\\n]*environ|^if (?!IS_HEROKU_APP:)[^\\n]+:\\n(?:[ \\t]*#[^\\n]*\\n)*[ \\t]+ALLOWED_HOSTS = \\[\"\\*\"\\]|^IS_HEROKU_APP = (?!\"DYNO\" in os\\.environ and \"CI\" not in os\\.environ$)"}
    ],
    "follow_up": "Yes, go ahead with what you recommend.",
    "budget_usd": 6.0,
    "timeout_s": 1800
  },
